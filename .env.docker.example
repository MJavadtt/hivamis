# Copy to .env before running `docker compose up -d`.

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=hiva
POSTGRES_DB=hiva_os

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
MAX_UPLOAD_MB=25
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Optional — the AI subsystem falls back to its deterministic rule engine when unset.
ANTHROPIC_API_KEY=
AI_ENABLED=false
AI_MODEL=claude-sonnet-4-5

# PDF engine — the image installs Chromium at this path. Override only if you
# rebuild the image on a base that puts the browser somewhere else.
PDF_BROWSER_PATH=/usr/bin/chromium

# Demo data is off by default in the compose stack. Setting this to true in a production
# deployment would create fifteen accounts sharing a published password.
SEED_DEMO_DATA=false
