# Copy to .env before running `docker compose up -d`.

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=hiva
POSTGRES_DB=hiva_os

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
IN_MEMORY_FILE_MB=25
STORAGE_RESERVE_MB=1024
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# The assistant's model runs in this stack (audit F-1). `ai`: on the CPU; `ai-gpu`: on NVIDIA GPUs;
# empty: no model service (then CHAT_MODE=off, or OLLAMA_URL pointing at an Ollama elsewhere).
COMPOSE_PROFILES=ai
CHAT_MODE=ollama
OLLAMA_URL=http://ollama:11434
# The installer chooses for the machine: qwen3:30b-a3b-instruct-2507-q4_K_M (answers at once, no
# hidden thinking) on a GPU of 20 GB or a CPU with 32 GB; below that qwen3:14b (GPU from 10 GB),
# qwen3:8b, qwen3:4b. `hivamis model auto` chooses again.
OLLAMA_MODEL=qwen3:8b
# How much the model reads at once, in tokens; the installer sets it for the model (32768 for 30b).
OLLAMA_NUM_CTX=16384
# Answers produced at once; the rest wait their turn. The installer sets both for the machine's
# memory (4 on a CPU with 48 GB and the 30b model); raise only with the hardware (docs/operations.md).
CHAT_CONCURRENCY=1
OLLAMA_NUM_PARALLEL=1
# How long the model stays loaded after an answer: 30m, 24h, or -1 for always (an office server).
OLLAMA_KEEP_ALIVE=30m

# Pictures with the assistant (audit F-2). Off: drawing needs a GPU, or minutes per picture on a CPU.
# To turn on: add `image` (or `image-gpu`) to COMPOSE_PROFILES, set IMAGE_MODE=local, then fetch the
# model once: docker compose run --rm imagegen-pull models install <IMAGE_MODEL> — or install with --image.
# sd-1.5-ggml: CreativeML OpenRAIL-M, runs on a CPU. flux.1-schnell: Apache-2.0, wants a GPU.
IMAGE_MODE=off
IMAGE_MODEL=sd-1.5-ggml

# Speech to text (audit F-4): speaking to the assistant, and meeting recordings. Off until set.
# In this stack: add `speech` to COMPOSE_PROFILES, set the URL below, then fetch the model once:
#   docker compose run --rm speech-pull Systran/faster-whisper-medium
# Whisper understands Persian; large-v3 is better and slower, small faster and weaker.
TRANSCRIPTION_URL=
TRANSCRIPTION_MODEL=Systran/faster-whisper-medium
TRANSCRIPTION_API_KEY=

# Optional — the AI subsystem falls back to its deterministic rule engine when unset.
ANTHROPIC_API_KEY=
AI_ENABLED=false
AI_MODEL=claude-sonnet-4-5

# PDF engine — the image installs Chromium at this path. Override only if you
# rebuild the image on a base that puts the browser somewhere else.
PDF_BROWSER_PATH=/usr/bin/chromium

# Demo data is off in the compose stack: the container never runs the seed, and the seed refuses
# demo data under NODE_ENV=production. The installer writes false here whatever this says.
SEED_DEMO_DATA=false

# The API refuses to start while a demo account (@hiva.local) is active. Clear them with
#   docker compose run --rm api node dist/cli.js demo:deactivate
# true starts it with them anyway, logged at fatal on every boot. Not a setting to keep.
ALLOW_DEMO_ACCOUNTS=false

# One hop: the `web` nginx container. Only change this if you put another proxy in front.
TRUST_PROXY=1
# The way in from outside the office (ADR-129), set by `hivamis remote HOST`: the name the
# certificate is for, and the `https` profile in COMPOSE_PROFILES. Ports 80 and 443 on this machine.
PUBLIC_HOST=
HTTP_PORT=80
HTTPS_PORT=443

# Raise only alongside the container's memory limit — each render costs ~150MB.
PDF_MAX_CONCURRENCY=2
PDF_QUEUE_FACTOR=4

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push to phones (roadmap #49). Empty keys: one pair is made on first use and kept in the
# database. Set them once for production; VAPID_SUBJECT is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Roadmap #50. The address people open (links in emails are built on it).
PUBLIC_APP_URL=http://localhost:8080
# `single`: one organisation. `multi`: several, each found by its host names (hivamis tenant …).
TENANT_MODE=single
# Bring every organisation's reference data up to the code on start-up. `off`: by hand only.
REFERENCE_SYNC=on

# Signing in and joining by mobile. `off` until a provider is set: `kavenegar` (SMS_API_KEY and the
# verify template in SMS_TEMPLATE) or `http` (POSTs { to, text } to SMS_URL). `sandbox` is refused here:
# it keeps every code where an administrator can read it (audit SEC-6).
SMS_MODE=off
SMS_API_KEY=
SMS_TEMPLATE=
SMS_URL=

# Google sign-in: both halves of the OAuth client, or neither. GOOGLE_ALLOWED_DOMAINS (comma list)
# limits the Google accounts that may join, sign in or be linked to those email domains.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# The line texts to the venues go out from (ADR-103); empty: the SMS account's default line.
SMS_SENDER=

# The bot (roadmap #40): `bale` or `telegram`, with the token BotFather (or Bale's) gives — never one
# pasted anywhere else. `polling` asks the Bot API itself and works on a server with no public address;
# `webhook` needs PUBLIC_APP_URL reachable from the internet and MESSENGER_WEBHOOK_SECRET.
MESSENGER_MODE=off
MESSENGER_BOT_TOKEN=
MESSENGER_BOT_USERNAME=
MESSENGER_TRANSPORT=polling
MESSENGER_WEBHOOK_SECRET=

# Electronic signature (roadmap #41): `http` with a provider behind the documented contract.
ESIGN_MODE=off
ESIGN_URL=
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# The tax authority's invoice system (Moadian): `live` with the registered key and certificate,
# put under /app/storage (the storage volume) and named here by that path.
MOADIAN_MODE=off
MOADIAN_PRIVATE_KEY_PATH=
MOADIAN_CERTIFICATE_PATH=

# Searching by meaning: an embeddings endpoint, e.g. this stack's model server
# (EMBEDDING_URL=http://ollama:11434/v1/embeddings, EMBEDDING_MODEL=nomic-embed-text, fetched once with
# docker compose run --rm ollama-pull nomic-embed-text). Empty: embedded locally.
EMBEDDING_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Web Push to phones: `off` on a server with no route to the browsers' push services.
PUSH_DELIVERY=on

# Building on a server where the public package servers are slow or refused: a mirror for npm and
# one for Debian (scheme and host, e.g. http://mirror.example.ir). Docker Hub's own mirror is the
# Docker engine's setting, not this file's — see docs/operations.md.
NPM_REGISTRY=https://registry.npmjs.org/
DEBIAN_MIRROR=
