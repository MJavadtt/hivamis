/**
 * Emits the CHECK constraints that pin each entity's `state` column to its declared vocabulary.
 *
 * Generated rather than hand-written so the SQL cannot drift from packages/contracts: the state
 * lists come from WORKFLOWS, and the table names are read out of the Prisma schema's @@map
 * directives instead of being duplicated here.
 *
 * Usage:  pnpm exec tsx prisma/generate-state-constraints.mts > migration.sql
 */
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { WORKFLOWS, FORM_SUBMISSION_STATES, SLA_STATES } from '@hiva/contracts';

const here = path.dirname(fileURLToPath(import.meta.url));
const schema = readFileSync(path.join(here, 'schema.prisma'), 'utf8');

/** model Name { … @@map("table_name") } → { Name: 'table_name' } */
function tableNames(): Record<string, string> {
  const out: Record<string, string> = {};
  for (const block of schema.split(/\nmodel\s+/).slice(1)) {
    const name = block.slice(0, block.indexOf(' ')).trim();
    const m = /@@map\("([^"]+)"\)/.exec(block);
    if (name && m) out[name] = m[1]!;
  }
  return out;
}

const tables = tableNames();

/** Prisma model name for a workflow key (they differ only in the first letter's case). */
const modelFor = (entity: string) => entity.charAt(0).toUpperCase() + entity.slice(1);

const targets: { table: string; states: readonly string[]; source: string }[] = [];

for (const [entity, def] of Object.entries(WORKFLOWS)) {
  const table = tables[modelFor(entity)];
  if (!table) throw new Error(`no @@map for model ${modelFor(entity)} (workflow ${entity})`);
  targets.push({ table, states: def.states, source: `WORKFLOWS.${entity}` });
}

// Not workflow entities, but their `state` is an equally closed vocabulary declared in contracts.
targets.push({ table: tables.FormSubmission!, states: FORM_SUBMISSION_STATES, source: 'FORM_SUBMISSION_STATES' });
targets.push({ table: tables.SlaClock!, states: SLA_STATES, source: 'SLA_STATES' });

const lines: string[] = [
  '-- Database-level enforcement of the declared state vocabularies.',
  '-- The workflow engine is the only sanctioned writer of `state`, but a direct UPDATE, a data',
  '-- import or a future code path could still write anything. These constraints make the',
  '-- vocabulary a property of the schema rather than a convention of the application.',
  '--',
  '-- GENERATED by prisma/generate-state-constraints.mts — regenerate rather than editing.',
  '',
];

for (const { table, states, source } of targets) {
  const name = `${table}_state_check`;
  const list = states.map((s) => `'${s}'`).join(', ');
  lines.push(`-- ${source}`);
  lines.push(`ALTER TABLE "${table}" DROP CONSTRAINT IF EXISTS "${name}";`);
  lines.push(`ALTER TABLE "${table}" ADD CONSTRAINT "${name}" CHECK ("state" IN (${list}));`);
  lines.push('');
}

process.stdout.write(lines.join('\n'));
