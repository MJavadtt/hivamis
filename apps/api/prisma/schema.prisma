// Hivamis (هیوامیس) — data model
// Traceability: every model below maps to an entity named in Doc_H
// («الگوریتم جامع مسیر مشتری»، «قوانین و دستورالعمل حاکم»، «دسته‌بندی فرم‌ها»، RACI matrix).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ═══════════════════════ Identity & organisation ═══════════════════════
 */

model Organization {
  id                       String   @id @default(uuid())
  name                     String
  legalName                String?
  currency                 String   @default("IRR")
  timezone                 String   @default("Asia/Tehran")
  workingDays              Int[]    @default([6, 0, 1, 2, 3])
  workStartHour            Int      @default(9)
  workEndHour              Int      @default(18)
  breakHours               Int      @default(1)
  /// Audit CALC-1: whether contract values are written with VAT. Off — the usual practice — invoices are
  /// compared with what has been earned on their subtotal; on, on their total.
  contractValueIncludesTax Boolean  @default(false)
  /// Audit LOG-5: the organisation's file storage, in megabytes; null is no limit. Set by whoever runs the
  /// installation (`hivamis tenant update --quota-mb`), not by the organisation.
  storageQuotaMb           Int?
  settings                 Json     @default("{}")
  /// Roadmap #50: the organisation's short name, and the host names that open it.
  slug                     String?  @unique
  hosts                    String[] @default([])
  /// A suspended organisation: nobody signs in, nothing is lost.
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  departments             Department[]
  users                   User[]
  /// Audit F-3: the organisation's own roles and its catalogue of positions.
  customRoles             Role[]
  positions               Position[]
  companies               Company[]
  holidays                Holiday[]
  signupRequests          SignupRequest[]
  aiPlans                 AiPlan[]
  /// Audit F-5: team chat.
  chatConversations       ChatConversation[]
  chatMessages            ChatMessage[]
  idempotencyKeys         IdempotencyKey[]
  userPermissionOverrides UserPermissionOverride[]
  importLinks             ImportLink[]
  userDrafts              UserDraft[]

  @@map("organizations")
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  title          String

  @@unique([organizationId, date])
  @@map("holidays")
}

/// Time off. A person on leave has no working hours, so a clock they own does not run and a
/// task they hold cannot be scheduled into those days.
model UserLeave {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Inclusive calendar days, YYYY-MM-DD in the organisation's timezone.
  from        DateTime @db.Date
  to          DateTime @db.Date
  kind        String   @default("VACATION")
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([userId, from, to])
  @@map("user_leaves")
}

/// Formal, time-boxed, scoped delegation of authority (roadmap #6). The alternative — sharing a
/// password while the approver is away — defeats every audit row in the system. A delegation
/// names who, to whom, which permissions and roles, from when to when, and why; it can be
/// revoked; and everything done under it is recorded as done on the delegator's behalf.
model Delegation {
  id             String    @id @default(uuid())
  organizationId String
  fromUserId     String
  toUserId       String
  /// A subset of what the delegator holds at the time of use — re-checked when a token is issued.
  permissions    String[]  @default([])
  /// Roles named as form approvers (approverRoles) the delegate may act as.
  roles          String[]  @default([])
  startsAt       DateTime
  endsAt         DateTime
  reason         String
  revokedAt      DateTime?
  revokedById    String?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([toUserId, startsAt, endsAt])
  @@index([fromUserId])
  @@index([organizationId])
  @@map("delegations")
}

/// A governed exception (roadmap #7). A blocked guard is otherwise a dead end, and a dead end
/// moves the work outside the system — losing both the rule and the trace. A waiver lets the
/// CEO or deputy say "this once, without X; on my authority": one record, one guard, one use,
/// a reason, an expiry, and a register that management and the data-quality report can see.
model Waiver {
  id             String    @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  /// The guard id this waives, e.g. project.hasValidAuthorizationBasis.
  guard          String
  /// Restrict to one transition action; null waives the guard on any transition of the record.
  action         String?
  reason         String
  grantedById    String
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  usedById       String?
  usedAction     String?
  revokedAt      DateTime?
  revokedById    String?

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, expiresAt])
  @@map("waivers")
}

/// A rule set as it stood at one version (roadmap #4). The rules are data — workflows,
/// permissions, SLA policies — and data changes. Every transition records the versions in
/// force when it happened, so an auditor can ask "was this decision right under the rules of
/// *that* time", not today's.
model RuleSetVersion {
  id            String   @id @default(uuid())
  /// workflows | permissions | sla
  kind          String
  version       Int
  /// Fingerprint of the canonical snapshot; a boot with the same fingerprint registers nothing.
  hash          String
  snapshot      Json
  effectiveFrom DateTime @default(now())
  /// A short description of the change, when the person who made it left one.
  note          String?

  @@unique([kind, version])
  @@unique([kind, hash])
  @@map("rule_set_versions")
}

/// Hours actually spent on a task (roadmap #14). Light on purpose: a number, a day, a note. The
/// Doc_H KPI "cost accuracy" needs a measure of reality to compare declared cost against, and
/// this is it; the estimation assistant (#24) and the forecast (#11) read it too.
model TimeEntry {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  hours          Decimal  @db.Decimal(6, 2)
  workedOn       DateTime @db.Date
  note           String?
  createdAt      DateTime @default(now())

  @@index([taskId])
  @@index([organizationId, workedOn])
  @@index([userId, workedOn])
  @@map("time_entries")
}

model Department {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  nameFa            String
  nameEn            String
  /// Calendar overrides. Null inherits the organisation; a production unit that works
  /// Thursdays sets workingDays, a shift unit sets its hours.
  workingDays       Int[]        @default([])
  workStartHour     Int?
  workEndHour       Int?
  breakHours        Int?
  /// Default internal cost of one hour for people in this unit, when they have no rate of their own.
  hourlyCost        Decimal?     @db.Decimal(14, 2)
  isExecutionalUnit Boolean      @default(false)
  managerId         String?
  sortOrder         Int          @default(0)
  /// The unit's tag colour, `#rrggbb` (Hivamis task 9); null shows the default from @hiva/contracts.
  tagColor          String?
  /// The organisation renamed the unit (list 3, item 6): an upgrade keeps its names.
  namesOwned        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users     User[]
  positions Position[]
  teams     Team[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Role {
  id             String        @id @default(uuid())
  code           String        @unique
  nameFa         String
  nameEn         String
  description    String?
  isSystem       Boolean       @default(true)
  /// Audit F-3: null for the roles the code defines, which every organisation has; set for one an
  /// organisation's administrator made, which only that organisation sees.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// A colour to tell it apart in lists, as #rrggbb.
  color          String?

  permissions RolePermission[]
  users       UserRole[]

  @@index([organizationId])
  @@map("roles")
}

/// A job title the organisation keeps (audit F-3): in a unit, with the roles it usually brings. A
/// person's position replaces the free-text job title, which stays as the fallback.
model Position {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nameFa           String
  nameEn           String       @default("")
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Offered when someone is given this position; granted only when the administrator confirms.
  defaultRoleCodes String[]     @default([])
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users User[]

  @@unique([organizationId, nameFa])
  @@map("positions")
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  nameFa String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId        String?
  department          Department?  @relation(fields: [departmentId], references: [id])
  /// Audit LOG-4: unique within the organisation, not the installation — the same person may work for two.
  email               String
  fullName            String
  passwordHash        String
  jobTitle            String?
  /// Audit F-3: the position from the organisation's catalogue; jobTitle stays as the fallback.
  positionId          String?
  position            Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// Audit F-6: the profile. The photo is a document — re-encoded to a 512px WebP, its metadata
  /// stripped — shown wherever the person is; the rest is theirs to write.
  avatarDocumentId    String?      @unique
  avatarDocument      Document?    @relation("UserAvatar", fields: [avatarDocumentId], references: [id], onDelete: SetNull)
  bio                 String?
  /// How the name is said, for colleagues who only read it.
  pronouncedName      String?
  skills              String[]     @default([])
  links               String[]     @default([])
  phone               String?
  /// When the person proved the mobile is theirs with a one-time code (Hivamis task 4); a verified
  /// mobile is unique among active people and signs them in.
  phoneVerifiedAt     DateTime?
  isActive            Boolean      @default(true)
  mustChangePassword  Boolean      @default(false)
  /// Personal calendar overrides; null inherits the department, then the organisation.
  workingDays         Int[]        @default([])
  workStartHour       Int?
  workEndHour         Int?
  leaves              UserLeave[]
  /// Internal cost of one hour of this person's time; null inherits the department's rate.
  hourlyCost          Decimal?     @db.Decimal(14, 2)
  timeEntries         TimeEntry[]
  weeklyCapacityHours Decimal      @default(40) @db.Decimal(6, 2)
  lastLoginAt         DateTime?
  /// A lock set on purpose. Wrong passwords no longer set it (audit SEC-10): they slow their network down.
  lockedUntil         DateTime?
  /// Audit SEC-3: raised on a role change, deactivation or password change. Every access token carries
  /// the value it was issued under (`av`); one that differs is refused at once, not when it expires.
  authVersion         Int          @default(0)
  locale              String       @default("fa")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  roles                    UserRole[]
  sessions                 Session[]
  /// Sessions a system administrator opened to work in this person's account (owner's report, 2026-10-23).
  actingSessions           Session[]                    @relation("SessionImpersonator")
  /// Permissions given to or withheld from this person, on top of their roles.
  permissionOverrides      UserPermissionOverride[]     @relation("UserPermissionOverrides")
  permissionOverridesGiven UserPermissionOverride[]     @relation("UserPermissionOverridesGiven")
  ownedLeads               Lead[]                       @relation("LeadOwner")
  sourcedLeads             Lead[]                       @relation("LeadSourceUser")
  ownedOpportunities       Opportunity[]                @relation("OpportunityOwner")
  accountCompanies         Company[]                    @relation("CompanyAccountOwner")
  salesCompanies           Company[]                    @relation("CompanySalesOwner")
  accountProjects          Project[]                    @relation("ProjectAccountOwner")
  assignedTasks            Task[]                       @relation("TaskAssignee")
  workOrderOwnerships      WorkOrder[]                  @relation("WorkOrderOwner")
  allocations              Allocation[]
  auditEvents              AuditEvent[]                 @relation("AuditActor")
  auditEventsActingAs      AuditEvent[]                 @relation("AuditImpersonator")
  notifications            Notification[]
  formSubmissions          FormSubmission[]             @relation("FormSubmitter")
  formAssignments          FormSubmission[]             @relation("FormAssignee")
  formApprovals            FormApproval[]
  qcReviews                QcReview[]
  revisionsAssigned        Revision[]                   @relation("RevisionAssignee")
  ownedRisks               Risk[]
  ownedIssues              Issue[]
  decisions                Decision[]
  stateTransitions         StateTransition[]
  aiInteractions           AiInteraction[]
  raciAssignments          RaciAssignment[]
  documents                Document[]
  comments                 Comment[]
  annotations              Annotation[]                 @relation("AnnotationAuthor")
  messengerLink            MessengerLink?
  messengerActions         MessengerAction[]
  pushSubscriptions        PushSubscription[]
  signatureEnvelopes       SignatureEnvelope[]
  portalInvites            PortalUser[]
  portalReplies            PortalMessage[]
  clientApprovals          ClientApproval[]
  apiKeys                  ApiKey[]
  webhookSubscriptions     WebhookSubscription[]
  identities               UserIdentity[]
  otpCodes                 OtpCode[]
  oauthStates              OAuthState[]
  identityLinkOffers       IdentityLinkOffer[]
  smsMessages              SmsMessage[]
  loginTickets             LoginTicket[]
  signupDecisions          SignupRequest[]              @relation("SignupDecider")
  signupAccounts           SignupRequest[]              @relation("SignupAccount")
  aiConversations          AiConversation[]
  aiPlans                  AiPlan[]
  chatStarted              ChatConversation[]           @relation("ChatConversationCreator")
  chatMemberships          ChatMember[]
  chatMessages             ChatMessage[]                @relation("ChatMessageAuthor")
  idempotencyKeys          IdempotencyKey[]
  guideVideos              GuideVideo[]                 @relation("GuideVideoUploader")
  /// Audit F-9: meeting bookings.
  bookingsOrganized        Booking[]                    @relation("BookingOrganizer")
  bookingsToApprove        Booking[]                    @relation("BookingApprover")
  bookingSeats             BookingParticipant[]
  personHolds              PersonHold[]
  guestsCheckedIn          BookingGuest[]               @relation("GuestCheckedInBy")
  /// ADR-103: venues, deployment projects and rentals — each a column that is history.
  venuesCreated            Venue[]                      @relation("VenueCreatedBy")
  siteProjectsResponsible  SiteProject[]                @relation("SiteProjectResponsible")
  siteProjectsCreated      SiteProject[]                @relation("SiteProjectCreatedBy")
  siteNegotiationsOwned    SiteNegotiation[]            @relation("SiteNegotiationAssignee")
  siteNegotiationsWritten  SiteNegotiation[]            @relation("SiteNegotiationCreatedBy")
  siteNegotiationSeats     SiteNegotiationParticipant[]
  siteContractsWritten     SiteContract[]               @relation("SiteContractCreatedBy")
  siteContractsDecided     SiteContract[]               @relation("SiteContractDecidedBy")
  siteApprovalsDecided     SiteApproval[]               @relation("SiteApprovalDecidedBy")
  siteApprovalsRecorded    SiteApproval[]               @relation("SiteApprovalRecordedBy")
  siteAssignments          SiteAssignment[]
  siteObligationsWritten   SiteObligation[]             @relation("SiteObligationCreatedBy")
  sitePaymentsRecorded     SitePayment[]                @relation("SitePaymentRecordedBy")
  sitePaymentsReversed     SitePayment[]                @relation("SitePaymentReversedBy")
  siteDepositsRecorded     SiteDepositEntry[]           @relation("SiteDepositRecordedBy")
  siteDepositsDecided      SiteDepositEntry[]           @relation("SiteDepositDecidedBy")
  venueMessagesSent        VenueMessage[]
  siteImports              SiteImport[]
  siteSavedViews           SiteSavedView[]

  /// List 3, item 6: the team within the person's unit, if any.
  teamId   String?
  team     Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  teamsLed Team[]  @relation("TeamLead")

  drafts UserDraft[]

  @@unique([organizationId, email])
  @@index([organizationId, departmentId])
  @@index([email])
  @@map("users")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set when a system administrator opened this session to work in the person's account: short,
  /// never refreshed, and every action under it recorded with the administrator's name.
  impersonatorId   String?
  impersonator     User?     @relation("SessionImpersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Why it ended (Hivamis task 4): only ROTATED — or a row from before this was recorded — makes a
  /// second presentation of its token a sign of theft.
  revokedReason    String?
  /// Audit SEC-3: the sign-in this row continues — the first session's id, carried through every
  /// rotation. An access token issued before a rotation stays good while its family has a live row.
  familyId         String
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// A permission given to one person or withheld from them, on top of what their roles give (owner's
/// report, 2026-10-23): the administrator controls each user's access, not only each role's.
model UserPermissionOverride {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission     String
  /// `grant` adds it to what the roles give; `deny` takes it away.
  effect         String
  grantedById    String?
  grantedBy      User?        @relation("UserPermissionOverridesGiven", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([userId, permission])
  @@index([organizationId])
  @@map("user_permission_overrides")
}

/**
 * ═══════════════════════ CRM ═══════════════════════
 */

model Company {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName      String
  brandName      String?
  industry       String?
  nationalId     String?
  economicCode   String?
  /// Roadmap #32: the buyer's postal code — required on an identified-buyer e-invoice.
  postalCode     String?
  website        String?
  phone          String?
  address        String?
  /// The client's code in the organisation's own books (H1001 — the owner's sheet and Mizito, 2026-10-28).
  clientCode     String?
  email          String?
  notes          String?
  accountOwnerId String?
  accountOwner   User?        @relation("CompanyAccountOwner", fields: [accountOwnerId], references: [id])
  salesOwnerId   String?
  salesOwner     User?        @relation("CompanySalesOwner", fields: [salesOwnerId], references: [id])
  healthScore    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  contacts        Contact[]
  brandKit        BrandKit?
  portalUsers     PortalUser[]
  clientApprovals ClientApproval[]
  leads           Lead[]
  opportunities   Opportunity[]
  projects        Project[]
  contracts       Contract[]
  invoices        Invoice[]
  activities      Activity[]
  meetings        Meeting[]
  documents       Document[]
  formSubmissions FormSubmission[]

  // What a contact's composite key points at: a contact's organisation is its company's (ADR-067).
  /// Audit F-9: meetings booked with the client.
  bookings     Booking[]
  /// ADR-103: placements made for the client, who approves them as the employer.
  siteProjects SiteProject[]

  @@unique([id, organizationId])
  @@unique([organizationId, clientCode])
  @@index([organizationId])
  @@map("companies")
}

model Contact {
  id              String           @id @default(uuid())
  /// The company's organisation, held on the contact too so every query scopes on it directly
  /// (audit SEC-1, ADR-067). The composite key below makes the database refuse any other.
  organizationId  String
  companyId       String
  company         Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  fullName        String
  jobTitle        String?
  email           String?
  phone           String?
  isPrimary       Boolean          @default(false)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  portalUser      PortalUser?
  clientApprovals ClientApproval[]
  deletedAt       DateTime?

  @@index([companyId])
  @@index([organizationId, companyId])
  @@map("contacts")
}

model Lead {
  id               String        @id @default(uuid())
  organizationId   String
  code             String        @unique
  name             String
  companyName      String
  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id])
  contactName      String?
  /// «تلفن همراه» — 09xxxxxxxxx for anything entered since Hivamis task 2; how a repeated lead is found.
  phone            String?
  email            String?
  /// SALES_TEAM | MARKETER | STAFF | DIRECT | PARTNER — then exactly who or what, below.
  source           String
  /// SALES_TEAM: a member of the sales unit; STAFF: a colleague outside it.
  sourceUserId     String?
  sourceUser       User?         @relation("LeadSourceUser", fields: [sourceUserId], references: [id])
  /// MARKETER or PARTNER: one of the organisation's list.
  sourceReferrerId String?
  sourceReferrer   LeadReferrer? @relation(fields: [sourceReferrerId], references: [id])
  /// DIRECT: PHONE | EXHIBITION | EVENT | CAMPAIGN
  sourceChannel    String?
  estimatedValue   Decimal?      @db.Decimal(20, 2)
  need             String?
  state            String        @default("NEW")
  ownerId          String?
  owner            User?         @relation("LeadOwner", fields: [ownerId], references: [id])
  disqualifyReason String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  opportunities Opportunity[]

  @@index([organizationId, state])
  @@index([organizationId, phone])
  @@map("leads")
}

model Opportunity {
  id                String    @id @default(uuid())
  organizationId    String
  code              String    @unique
  title             String
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?     @relation(fields: [leadId], references: [id])
  estimatedValue    Decimal   @db.Decimal(20, 2)
  expectedCloseDate DateTime?
  servicesNeeded    String[]  @default([])
  description       String?
  state             String    @default("NEW")
  ownerId           String?
  owner             User?     @relation("OpportunityOwner", fields: [ownerId], references: [id])
  lostReason        String?
  wonAt             DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  briefs          Brief[]
  activities      Activity[]
  projects        Project[]
  formSubmissions FormSubmission[]

  @@index([organizationId, state])
  @@index([companyId])
  @@map("opportunities")
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind           String
  occurredAt     DateTime
  summary        String
  nextStep       String?
  nextStepDue    DateTime?
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([companyId])
  @@index([opportunityId])
  @@map("activities")
}

/**
 * ═══════════════════════ Brief → Proposal → Pricing ═══════════════════════
 */

model Brief {
  id                   String      @id @default(uuid())
  organizationId       String
  code                 String      @unique
  opportunityId        String
  opportunity          Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title                String
  businessObjective    String?
  targetAudience       String?
  scope                String?
  expectedDeliverables String?
  budgetRange          Decimal?    @db.Decimal(20, 2)
  desiredDeadline      DateTime?
  unitsNeeded          String[]    @default([])
  competitorContext    String?
  constraints          String?
  successCriteria      String?
  state                String      @default("DRAFT")
  /**
   * Populated by the completeness guard; drives the KPI "Brief Completeness".
   */
  completenessScore    Int         @default(0)
  /// How *specific* the brief is, not merely whether it is filled (roadmap #25) — 0–100, and
  /// the band it falls in. Kept so the return rate can be read against it over time.
  qualityScore         Int?
  qualityBand          String?
  missingItems         String[]    @default([])
  returnReason         String?
  returnCount          Int         @default(0)
  submittedById        String?
  reviewedById         String?
  approvedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  proposals Proposal[]
  projects  Project[]

  @@index([organizationId, state])
  @@map("briefs")
}

model Proposal {
  id                  String  @id @default(uuid())
  organizationId      String
  code                String  @unique
  briefId             String
  brief               Brief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  title               String
  version             Int     @default(1)
  executiveSummary    String?
  approach            String?
  deliverablesSummary String?
  timelineSummary     String?
  state               String  @default("DRAFT")

  // Pricing — Doc_H §12: totalCost is declared by units, salePrice/margin only via pricing.set_price
  totalCost           Decimal?  @db.Decimal(20, 2)
  salePrice           Decimal?  @db.Decimal(20, 2)
  marginPercent       Decimal?  @db.Decimal(7, 2)
  paymentTerms        String?
  contractScaleBand   String?
  pricingRationale    String?
  pricedById          String?
  pricedAt            DateTime?
  pricingApprovedById String?
  pricingApprovedAt   DateTime?

  clientFeedback String?
  clientDecision String?
  revisionCount  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workOrders       WorkOrder[]
  qcReviews        QcReview[]
  costDeclarations CostDeclaration[]
  revisions        Revision[]
  contracts        Contract[]
  projects         Project[]
  versions         ProposalVersion[]
  deliverables     Deliverable[]
  documents        Document[]

  @@index([organizationId, state])
  @@map("proposals")
}

model ProposalVersion {
  id          String   @id @default(uuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  changeNote  String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([proposalId, version])
  @@map("proposal_versions")
}

model CostDeclaration {
  id                   String     @id @default(uuid())
  organizationId       String
  proposalId           String?
  proposal             Proposal?  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  workOrderId          String?
  workOrder            WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  departmentCode       String
  internalCost         Decimal    @db.Decimal(20, 2)
  externalCost         Decimal    @default(0) @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  externalCurrency     String     @default("IRR")
  fxRate               Decimal    @default(1) @db.Decimal(24, 6)
  fxRateDate           DateTime?
  originalExternalCost Decimal?   @db.Decimal(20, 2)
  items                Json       @default("[]")
  assumptions          String?
  declaredById         String
  createdAt            DateTime   @default(now())

  @@index([proposalId])
  @@index([workOrderId])
  @@map("cost_declarations")
}

/**
 * ═══════════════════════ Handoff (Doc_H rule 2) ═══════════════════════
 */

model Handoff {
  id                 String    @id @default(uuid())
  organizationId     String
  code               String    @unique
  companyId          String
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id])
  contractId         String?
  salesOwnerId       String
  accountOwnerId     String
  commitmentsMade    String
  clientExpectations String
  sensitivities      String?
  openItems          String?
  state              String    @default("DRAFT")
  acceptedAt         DateTime?
  returnReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, state])
  @@map("handoffs")
}

/**
 * ═══════════════════════ Project & execution ═══════════════════════
 */

model Project {
  id                    String         @id @default(uuid())
  organizationId        String
  code                  String         @unique
  name                  String
  companyId             String
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  briefId               String?
  brief                 Brief?         @relation(fields: [briefId], references: [id])
  proposalId            String?
  proposal              Proposal?      @relation(fields: [proposalId], references: [id])
  opportunityId         String?
  opportunity           Opportunity?   @relation(fields: [opportunityId], references: [id])
  accountOwnerId        String
  accountOwner          User           @relation("ProjectAccountOwner", fields: [accountOwnerId], references: [id])
  objective             String?
  inScope               String?
  outOfScope            String?
  plannedStart          DateTime?
  plannedEnd            DateTime?
  actualStart           DateTime?
  actualEnd             DateTime?
  plannedBudget         Decimal?       @db.Decimal(20, 2)
  contractValue         Decimal?       @db.Decimal(20, 2)
  /// Roadmap #28: copied from the registered contract — its currency and value as written.
  contractCurrency      String         @default("IRR")
  originalContractValue Decimal?       @db.Decimal(20, 2)
  /// Roadmap #29: how revenue is earned as the work goes — MILESTONE | EFFORT | COST.
  revenueMethod         String         @default("EFFORT")
  revenueEntries        RevenueEntry[]
  mediaOrders           MediaOrder[]
  state                 String         @default("DRAFT")
  /// The project's reference in the system it came from (roadmap #48): a migration file run twice
  /// finds it and does not create it again.
  legacyRef             String?
  healthStatus          String         @default("GREEN")
  closedAt              DateTime?
  cancelReason          String?
  holdReason            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  authorizations    ExecutionAuthorization[]
  lessonReviews     LessonReview[]
  milestones        Milestone[]
  deliverables      Deliverable[]
  workOrders        WorkOrder[]
  tasks             Task[]
  raciAssignments   RaciAssignment[]
  changeRequests    ChangeRequest[]
  risks             Risk[]
  issues            Issue[]
  decisions         Decision[]
  meetings          Meeting[]
  statusReports     StatusReport[]
  contracts         Contract[]
  invoices          Invoice[]
  payments          Payment[]
  allocations       Allocation[]
  outsourceRequests OutsourceRequest[]
  portalMessages    PortalMessage[]
  documents         Document[]
  feedbacks         Feedback[]
  lessonsLearned    LessonLearned[]
  closureChecklist  ClosureChecklist?
  activities        Activity[]
  handoffs          Handoff[]
  formSubmissions   FormSubmission[]
  comments          Comment[]

  /// Audit F-9: meetings booked for the project.
  bookings     Booking[]
  /// ADR-103: the campaign's placements in venues.
  siteProjects SiteProject[]

  @@unique([organizationId, legacyRef])
  @@index([organizationId, state])
  @@index([companyId])
  @@map("projects")
}

/// Doc_H §13 — a project may not enter execution without one of the three authorisation bases.
model ExecutionAuthorization {
  id                String    @id @default(uuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  basis             String
  contractId        String?
  invoiceId         String?
  referenceDocument String
  notes             String?
  authorizedById    String
  authorizedAt      DateTime  @default(now())
  revokedAt         DateTime?
  revokeReason      String?

  @@index([projectId])
  @@map("execution_authorizations")
}

model Milestone {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  dueDate      DateTime
  completedAt  DateTime?
  /// Roadmap #29: the share of the contract value earned when this milestone is done (percent).
  revenueShare Decimal?  @db.Decimal(5, 2)
  sortOrder    Int       @default(0)

  @@index([projectId])
  @@map("milestones")
}

model RaciAssignment {
  id             String  @id @default(uuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity       String
  departmentCode String
  raciRole       String
  userId         String?
  user           User?   @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@map("raci_assignments")
}

model WorkOrder {
  id                   String    @id @default(uuid())
  organizationId       String
  code                 String    @unique
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId           String?
  proposal             Proposal? @relation(fields: [proposalId], references: [id])
  targetDepartmentCode String
  title                String
  scopeOfWork          String
  brief                String
  expectedOutput       String
  outputFormat         String
  deadline             DateTime
  ownerId              String
  owner                User      @relation("WorkOrderOwner", fields: [ownerId], references: [id])
  budget               Decimal?  @db.Decimal(20, 2)
  requiredResources    String?
  priority             String    @default("NORMAL")
  state                String    @default("DRAFT")
  acceptedAt           DateTime?
  acceptedById         String?
  committedDate        DateTime?
  clarificationNote    String?
  submittedAt          DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tasks             Task[]
  deliverables      Deliverable[]
  costDeclarations  CostDeclaration[]
  qcReviews         QcReview[]
  outsourceRequests OutsourceRequest[]

  @@index([organizationId, state])
  @@index([projectId])
  @@index([targetDepartmentCode, state])
  @@map("work_orders")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  code           String       @unique
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId    String?
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  deliverableId  String?
  deliverable    Deliverable? @relation(fields: [deliverableId], references: [id])
  title          String
  description    String?
  departmentCode String
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate        DateTime?
  estimateHours  Decimal?     @db.Decimal(8, 2)
  /// Maintained as the sum of timeEntries; never edited directly.
  actualHours    Decimal?     @db.Decimal(8, 2)
  timeEntries    TimeEntry[]
  priority       String       @default("NORMAL")
  state          String       @default("CREATED")
  /// Doc_H §6 — no verbal task: every task must trace to one of six authorised source documents.
  sourceType     String
  sourceRef      String
  blockReason    String?
  acceptedAt     DateTime?
  submittedAt    DateTime?
  closedAt       DateTime?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dependsOn    TaskDependency[] @relation("DependentTask")
  dependedOnBy TaskDependency[] @relation("PrerequisiteTask")
  qcReviews    QcReview[]
  revisions    Revision[]
  comments     Comment[]

  @@index([organizationId, state])
  @@index([projectId, state])
  @@index([assigneeId, state])
  @@index([departmentCode, state])
  @@map("tasks")
}

model TaskDependency {
  id             String @id @default(uuid())
  taskId         String
  task           Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Task   @relation("PrerequisiteTask", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  kind           String @default("FINISH_TO_START")

  @@unique([taskId, prerequisiteId])
  @@map("task_dependencies")
}

model Deliverable {
  id                String     @id @default(uuid())
  organizationId    String
  code              String     @unique
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId        String?
  proposal          Proposal?  @relation(fields: [proposalId], references: [id])
  workOrderId       String?
  workOrder         WorkOrder? @relation(fields: [workOrderId], references: [id])
  name              String
  description       String?
  departmentCode    String
  /// OOH_ARTWORK, OOH_START_REPORT, OOH_PERIODIC_REPORT, OOH_END_REPORT — or none (DELIVERABLE_KINDS).
  kind              String?
  format            String?
  version           String     @default("v1")
  dueDate           DateTime?
  state             String     @default("PLANNED")
  submittedAt       DateTime?
  deliveredAt       DateTime?
  acceptedAt        DateTime?
  rejectReason      String?
  /// QC stage zero (roadmap #22): the mechanical checks run when the unit hands over — PASS,
  /// WARN or FAIL — when they last ran, and what they found. A reviewer sees them before opening a file.
  stageZeroVerdict  String?
  stageZeroAt       DateTime?
  stageZeroFindings Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  qcReviews   QcReview[]
  revisions   Revision[]
  tasks       Task[]
  documents   Document[]
  annotations Annotation[]

  @@index([organizationId, state])
  @@index([projectId, state])
  @@map("deliverables")
}

/**
 * ═══════════════════════ Quality control (Doc_H §9, §10) ═══════════════════════
 */

model QcReview {
  id             String       @id @default(uuid())
  organizationId String
  code           String       @unique
  level          String
  deliverableId  String?
  deliverable    Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  workOrderId    String?
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  proposalId     String?
  proposal       Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklist      Json         @default("{}")
  verdict        String       @default("PENDING")
  findings       String?
  reviewerId     String
  reviewer       User         @relation(fields: [reviewerId], references: [id])
  reviewedAt     DateTime     @default(now())

  revisions   Revision[]
  annotations Annotation[]
  /// Photos taken at the review (roadmap #49) — evidence of the check, not part of the deliverable.
  documents   Document[]

  @@index([organizationId, level, verdict])
  @@index([deliverableId])
  @@map("qc_reviews")
}

model Revision {
  id                        String       @id @default(uuid())
  organizationId            String
  code                      String       @unique
  deliverableId             String?
  deliverable               Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  proposalId                String?
  proposal                  Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  taskId                    String?
  task                      Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  qcReviewId                String?
  qcReview                  QcReview?    @relation(fields: [qcReviewId], references: [id])
  /// Doc_H §10 — mandatory, non-null: no revision may exist without a recorded reason.
  reason                    String
  requiredCorrection        String
  responsibleDepartmentCode String
  assigneeId                String?
  assignee                  User?        @relation("RevisionAssignee", fields: [assigneeId], references: [id])
  dueDate                   DateTime
  state                     String       @default("REQUESTED")
  round                     Int          @default(1)
  resolvedAt                DateTime?
  rejectNote                String?
  requestedById             String
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  annotations Annotation[]

  @@index([organizationId, state])
  @@index([responsibleDepartmentCode, state])
  @@map("revisions")
}

/**
 * ═══════════════════════ Change control (Doc_H §8) ═══════════════════════
 */

model ChangeRequest {
  id              String   @id @default(uuid())
  organizationId  String
  code            String   @unique
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  requestedChange String
  requestedBy     String
  requestedDate   DateTime
  priority        String   @default("NORMAL")
  state           String   @default("SUBMITTED")

  scopeVerdict      String    @default("UNDETERMINED")
  scopeRationale    String?
  scopeReviewedById String?
  scopeReviewedAt   DateTime?

  // Doc_H §8 — the six mandatory impact dimensions
  timeImpactDays     Decimal?  @db.Decimal(8, 2)
  costImpact         Decimal?  @db.Decimal(20, 2)
  resourceImpact     String?
  scopeImpact        String?
  qualityImpact      String?
  contractImpact     String?
  proposedPrice      Decimal?  @db.Decimal(20, 2)
  impactAssessedById String?
  impactAssessedAt   DateTime?

  customerDecision  String?
  customerDecidedAt DateTime?
  rejectReason      String?
  closedAt          DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  amendments Amendment[]

  @@index([organizationId, state])
  @@index([projectId, state])
  @@map("change_requests")
}

/**
 * ═══════════════════════ Contract & legal ═══════════════════════
 */

model Contract {
  id              String    @id @default(uuid())
  organizationId  String
  code            String    @unique
  contractNumber  String?
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalId      String?
  proposal        Proposal? @relation(fields: [proposalId], references: [id])
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  title           String
  contractValue   Decimal   @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  currency        String    @default("IRR")
  fxRate          Decimal   @default(1) @db.Decimal(24, 6)
  fxRateDate      DateTime?
  originalValue   Decimal?  @db.Decimal(20, 2)
  startDate       DateTime
  endDate         DateTime
  scopeSummary    String?
  paymentTerms    String?
  state           String    @default("REQUESTED")
  legalReviewNote String?
  revisionNote    String?
  signedDate      DateTime?
  registeredAt    DateTime?
  terminateReason String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  amendments         Amendment[]
  invoices           Invoice[]
  documents          Document[]
  signatureEnvelopes SignatureEnvelope[]

  @@index([organizationId, state])
  @@index([companyId])
  @@map("contracts")
}

model Amendment {
  id                 String         @id @default(uuid())
  contractId         String
  contract           Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changeRequestId    String?
  changeRequest      ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  amendmentNumber    String
  effectiveDate      DateTime
  changes            String
  valueDelta         Decimal        @default(0) @db.Decimal(20, 2)
  /// Roadmap #28: for a contract in another currency, the delta as written and the rate that converted it.
  originalValueDelta Decimal?       @db.Decimal(20, 2)
  fxRate             Decimal        @default(1) @db.Decimal(24, 6)
  fxRateDate         DateTime?
  durationDeltaDays  Int            @default(0)
  createdById        String
  createdAt          DateTime       @default(now())

  @@index([contractId])
  @@map("amendments")
}

/**
 * ═══════════════════════ Finance ═══════════════════════
 */

model Invoice {
  id                 String    @id @default(uuid())
  organizationId     String
  code               String    @unique
  kind               String
  number             String
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id])
  contractId         String?
  contract           Contract? @relation(fields: [contractId], references: [id])
  issueDate          DateTime
  dueDate            DateTime?
  lines              Json      @default("[]")
  subtotal           Decimal   @db.Decimal(20, 2)
  taxPercent         Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal   @default(0) @db.Decimal(20, 2)
  total              Decimal   @db.Decimal(20, 2)
  paidAmount         Decimal   @default(0) @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  currency           String    @default("IRR")
  /// Base units per one unit of `currency`, as in force on the issue date — frozen with the invoice.
  fxRate             Decimal   @default(1) @db.Decimal(24, 6)
  /// The date of the rate used (the latest on or before the issue date).
  fxRateDate         DateTime?
  originalSubtotal   Decimal?  @db.Decimal(20, 2)
  originalTaxAmount  Decimal?  @db.Decimal(20, 2)
  originalTotal      Decimal?  @db.Decimal(20, 2)
  /// Settlement is counted in the invoice's own currency; paidAmount is that, at the invoice's rate.
  originalPaidAmount Decimal?  @db.Decimal(20, 2)
  state              String    @default("DRAFT")
  notes              String?
  cancelReason       String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments                   Payment[]
  mediaOrders                MediaOrder[]
  taxSubmissions             TaxSubmission[]
  /// Roadmap #33: the accounting export that posted it, and the one that reversed it after cancellation.
  accountingExportId         String?
  accountingExport           AccountingExport? @relation("InvoicePosted", fields: [accountingExportId], references: [id])
  accountingReversalExportId String?
  accountingReversalExport   AccountingExport? @relation("InvoiceReversed", fields: [accountingReversalExportId], references: [id])

  @@index([organizationId, state])
  @@index([companyId])
  @@map("invoices")
}

model Payment {
  id                 String            @id @default(uuid())
  organizationId     String
  invoiceId          String?
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id])
  supplierId         String?
  supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  direction          String
  amount             Decimal           @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  currency           String            @default("IRR")
  fxRate             Decimal           @default(1) @db.Decimal(24, 6)
  fxRateDate         DateTime?
  originalAmount     Decimal?          @db.Decimal(20, 2)
  /// How much of the linked invoice this settles, in the invoice's currency.
  settledOriginal    Decimal?          @db.Decimal(20, 2)
  /// Roadmap #31: a payment to a media vendor for this order — pass-through, not the project's cost.
  mediaOrderId       String?
  mediaOrder         MediaOrder?       @relation(fields: [mediaOrderId], references: [id], onDelete: SetNull)
  /// Roadmap #33: the accounting export that posted it.
  accountingExportId String?
  accountingExport   AccountingExport? @relation(fields: [accountingExportId], references: [id])
  occurredAt         DateTime
  method             String            @default("TRANSFER")
  reference          String?
  description        String?
  createdById        String
  createdAt          DateTime          @default(now())

  @@index([organizationId, direction])
  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model Settlement {
  id            String   @id @default(uuid())
  projectId     String   @unique
  totalInvoiced Decimal  @db.Decimal(20, 2)
  totalReceived Decimal  @db.Decimal(20, 2)
  balance       Decimal  @db.Decimal(20, 2)
  status        String
  notes         String?
  settledById   String
  settledAt     DateTime @default(now())

  @@map("settlements")
}

/**
 * ═══════════════════════ Resources & suppliers (Doc_H §5) ═══════════════════════
 */

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  kind           String
  departmentCode String?
  specialty      String?
  contactName    String?
  phone          String?
  email          String?
  dayRate        Decimal? @db.Decimal(20, 2)
  averageRating  Decimal? @db.Decimal(3, 2)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evaluations       SupplierEvaluation[]
  outsourceRequests OutsourceRequest[]
  payments          Payment[]
  mediaOrders       MediaOrder[]
  /// ADR-103: the counters it built.
  siteCounters      SiteCounter[]

  @@index([organizationId, kind])
  @@map("suppliers")
}

model SupplierEvaluation {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  projectId     String?
  quality       Int
  timeliness    Int
  communication Int
  costValue     Int
  wouldReuse    Boolean
  comments      String?
  evaluatedById String
  createdAt     DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_evaluations")
}

model OutsourceRequest {
