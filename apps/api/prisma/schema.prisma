  kind              String
  subject           String
  heldAt            DateTime
  attendees         String
  agenda            String?
  decisions         String?
  actions           Json      @default("[]")
  minutesRecordedAt DateTime?
  /// The notes or transcript the minutes were drawn from (roadmap #23) — the evidence behind them.
  minutesSource     String?
  createdById       String
  createdAt         DateTime  @default(now())
