// Hivamis (هیوامیس) — data model
// Traceability: every model below maps to an entity named in Doc_H
// («الگوریتم جامع مسیر مشتری»، «قوانین و دستورالعمل حاکم»، «دسته‌بندی فرم‌ها»، RACI matrix).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ═══════════════════════ Identity & organisation ═══════════════════════ */

model Organization {
  id            String   @id @default(uuid())
  name          String
  legalName     String?
  currency      String   @default("IRR")
  timezone      String   @default("Asia/Tehran")
  workingDays   Int[]    @default([6, 0, 1, 2, 3])
  workStartHour Int      @default(9)
  workEndHour   Int      @default(18)
  breakHours    Int      @default(1)
  settings      Json     @default("{}")
  /// Roadmap #50: the organisation's short name, and the host names that open it.
  slug          String?  @unique
  hosts         String[] @default([])
  /// A suspended organisation: nobody signs in, nothing is lost.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  departments Department[]
  users       User[]
  companies   Company[]
  holidays    Holiday[]
  signupRequests SignupRequest[]

  @@map("organizations")
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  title          String

  @@unique([organizationId, date])
  @@map("holidays")
}

/// Time off. A person on leave has no working hours, so a clock they own does not run and a
/// task they hold cannot be scheduled into those days.
model UserLeave {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Inclusive calendar days, YYYY-MM-DD in the organisation's timezone.
  from      DateTime @db.Date
  to        DateTime @db.Date
  kind      String   @default("VACATION")
  note      String?
  createdById String?
  createdAt DateTime @default(now())

  @@index([userId, from, to])
  @@map("user_leaves")
}

/// Formal, time-boxed, scoped delegation of authority (roadmap #6). The alternative — sharing a
/// password while the approver is away — defeats every audit row in the system. A delegation
/// names who, to whom, which permissions and roles, from when to when, and why; it can be
/// revoked; and everything done under it is recorded as done on the delegator's behalf.
model Delegation {
  id             String    @id @default(uuid())
  organizationId String
  fromUserId     String
  toUserId       String
  /// A subset of what the delegator holds at the time of use — re-checked when a token is issued.
  permissions    String[]  @default([])
  /// Roles named as form approvers (approverRoles) the delegate may act as.
  roles          String[]  @default([])
  startsAt       DateTime
  endsAt         DateTime
  reason         String
  revokedAt      DateTime?
  revokedById    String?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([toUserId, startsAt, endsAt])
  @@index([fromUserId])
  @@index([organizationId])
  @@map("delegations")
}

/// A governed exception (roadmap #7). A blocked guard is otherwise a dead end, and a dead end
/// moves the work outside the system — losing both the rule and the trace. A waiver lets the
/// CEO or deputy say "this once, without X; on my authority": one record, one guard, one use,
/// a reason, an expiry, and a register that management and the data-quality report can see.
model Waiver {
  id             String    @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  /// The guard id this waives, e.g. project.hasValidAuthorizationBasis.
  guard          String
  /// Restrict to one transition action; null waives the guard on any transition of the record.
  action         String?
  reason         String
  grantedById    String
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  usedById       String?
  usedAction     String?
  revokedAt      DateTime?
  revokedById    String?

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, expiresAt])
  @@map("waivers")
}

/// A rule set as it stood at one version (roadmap #4). The rules are data — workflows,
/// permissions, SLA policies — and data changes. Every transition records the versions in
/// force when it happened, so an auditor can ask "was this decision right under the rules of
/// *that* time", not today's.
model RuleSetVersion {
  id            String   @id @default(uuid())
  /// workflows | permissions | sla
  kind          String
  version       Int
  /// Fingerprint of the canonical snapshot; a boot with the same fingerprint registers nothing.
  hash          String
  snapshot      Json
  effectiveFrom DateTime @default(now())
  /// A short description of the change, when the person who made it left one.
  note          String?

  @@unique([kind, version])
  @@unique([kind, hash])
  @@map("rule_set_versions")
}

/// Hours actually spent on a task (roadmap #14). Light on purpose: a number, a day, a note. The
/// Doc_H KPI "cost accuracy" needs a measure of reality to compare declared cost against, and
/// this is it; the estimation assistant (#24) and the forecast (#11) read it too.
model TimeEntry {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  hours          Decimal  @db.Decimal(6, 2)
  workedOn       DateTime @db.Date
  note           String?
  createdAt      DateTime @default(now())

  @@index([taskId])
  @@index([organizationId, workedOn])
  @@index([userId, workedOn])
  @@map("time_entries")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameFa         String
  nameEn         String
  /// Calendar overrides. Null inherits the organisation; a production unit that works
  /// Thursdays sets workingDays, a shift unit sets its hours.
  workingDays       Int[]    @default([])
  workStartHour     Int?
  workEndHour       Int?
  breakHours        Int?
  /// Default internal cost of one hour for people in this unit, when they have no rate of their own.
  hourlyCost        Decimal? @db.Decimal(14, 2)
  isExecutionalUnit Boolean   @default(false)
  managerId      String?
  sortOrder      Int          @default(0)
  /// The unit's tag colour, `#rrggbb` (Hivamis task 9); null shows the default from @hiva/contracts.
  tagColor       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users User[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Role {
  id          String  @id @default(uuid())
  code        String  @unique
  nameFa      String
  nameEn      String
  description String?
  isSystem    Boolean @default(true)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  nameFa String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId        String?
  department          Department?  @relation(fields: [departmentId], references: [id])
  email               String       @unique
  fullName            String
  passwordHash        String
  jobTitle            String?
  phone               String?
  /// When the person proved the mobile is theirs with a one-time code (Hivamis task 4); a verified
  /// mobile is unique among active people and signs them in.
  phoneVerifiedAt     DateTime?
  isActive            Boolean      @default(true)
  mustChangePassword  Boolean      @default(false)
  /// Personal calendar overrides; null inherits the department, then the organisation.
  workingDays       Int[]    @default([])
  workStartHour     Int?
  workEndHour       Int?
  leaves            UserLeave[]
  /// Internal cost of one hour of this person's time; null inherits the department's rate.
  hourlyCost          Decimal?     @db.Decimal(14, 2)
  timeEntries         TimeEntry[]
  weeklyCapacityHours Decimal      @default(40) @db.Decimal(6, 2)
  lastLoginAt         DateTime?
  /// A lock set on purpose. Wrong passwords no longer set it (audit SEC-10): they slow their network down.
  lockedUntil         DateTime?
  /// Audit SEC-3: raised on a role change, deactivation or password change. Every access token carries
  /// the value it was issued under (`av`); one that differs is refused at once, not when it expires.
  authVersion         Int          @default(0)
  locale              String       @default("fa")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  roles                UserRole[]
  sessions             Session[]
  ownedLeads           Lead[]              @relation("LeadOwner")
  sourcedLeads         Lead[]              @relation("LeadSourceUser")
  ownedOpportunities   Opportunity[]       @relation("OpportunityOwner")
  accountCompanies     Company[]           @relation("CompanyAccountOwner")
  salesCompanies       Company[]           @relation("CompanySalesOwner")
  accountProjects      Project[]           @relation("ProjectAccountOwner")
  assignedTasks        Task[]              @relation("TaskAssignee")
  workOrderOwnerships  WorkOrder[]         @relation("WorkOrderOwner")
  allocations          Allocation[]
  auditEvents          AuditEvent[]
  notifications        Notification[]
  formSubmissions      FormSubmission[]    @relation("FormSubmitter")
  formAssignments      FormSubmission[]    @relation("FormAssignee")
  formApprovals        FormApproval[]
  qcReviews            QcReview[]
  revisionsAssigned    Revision[]          @relation("RevisionAssignee")
  ownedRisks           Risk[]
  ownedIssues          Issue[]
  decisions            Decision[]
  stateTransitions     StateTransition[]
  aiInteractions       AiInteraction[]
  raciAssignments      RaciAssignment[]
  documents            Document[]
  comments             Comment[]
  annotations          Annotation[]      @relation("AnnotationAuthor")
  messengerLink        MessengerLink?
  messengerActions     MessengerAction[]
  pushSubscriptions    PushSubscription[]
  signatureEnvelopes   SignatureEnvelope[]
  portalInvites        PortalUser[]
  portalReplies        PortalMessage[]
  clientApprovals      ClientApproval[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  identities           UserIdentity[]
  otpCodes             OtpCode[]
  oauthStates          OAuthState[]
  identityLinkOffers   IdentityLinkOffer[]
  smsMessages          SmsMessage[]
  loginTickets         LoginTicket[]
  signupDecisions      SignupRequest[]     @relation("SignupDecider")
  signupAccounts       SignupRequest[]     @relation("SignupAccount")
  aiConversations      AiConversation[]
  guideVideos          GuideVideo[]       @relation("GuideVideoUploader")

  @@index([organizationId, departmentId])
  @@index([email])
  @@map("users")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Why it ended (Hivamis task 4): only ROTATED — or a row from before this was recorded — makes a
  /// second presentation of its token a sign of theft.
  revokedReason    String?
  /// Audit SEC-3: the sign-in this row continues — the first session's id, carried through every
  /// rotation. An access token issued before a rotation stays good while its family has a live row.
  familyId         String
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/* ═══════════════════════ CRM ═══════════════════════ */

model Company {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName      String
  brandName      String?
  industry       String?
  nationalId     String?
  economicCode   String?
  /// Roadmap #32: the buyer's postal code — required on an identified-buyer e-invoice.
  postalCode     String?
  website        String?
  phone          String?
  address        String?
  accountOwnerId String?
  accountOwner   User?        @relation("CompanyAccountOwner", fields: [accountOwnerId], references: [id])
  salesOwnerId   String?
  salesOwner     User?        @relation("CompanySalesOwner", fields: [salesOwnerId], references: [id])
  healthScore    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  contacts      Contact[]
  brandKit        BrandKit?
  portalUsers     PortalUser[]
  clientApprovals ClientApproval[]
  leads         Lead[]
  opportunities Opportunity[]
  projects      Project[]
  contracts     Contract[]
  invoices      Invoice[]
  activities    Activity[]
  meetings      Meeting[]
  documents     Document[]
  formSubmissions FormSubmission[]

  @@index([organizationId])
  // What a contact's composite key points at: a contact's organisation is its company's (ADR-067).
  @@unique([id, organizationId])
  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid())
  /// The company's organisation, held on the contact too so every query scopes on it directly
  /// (audit SEC-1, ADR-067). The composite key below makes the database refuse any other.
  organizationId String
  companyId String
  company   Company  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  fullName  String
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  portalUser      PortalUser?
  clientApprovals ClientApproval[]
  deletedAt DateTime?

  @@index([companyId])
  @@index([organizationId, companyId])
  @@map("contacts")
}

model Lead {
  id             String    @id @default(uuid())
  organizationId String
  code           String    @unique
  name           String
  companyName    String
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  contactName    String?
  /// «تلفن همراه» — 09xxxxxxxxx for anything entered since Hivamis task 2; how a repeated lead is found.
  phone          String?
  email          String?
  /// SALES_TEAM | MARKETER | STAFF | DIRECT | PARTNER — then exactly who or what, below.
  source         String
  /// SALES_TEAM: a member of the sales unit; STAFF: a colleague outside it.
  sourceUserId     String?
  sourceUser       User?         @relation("LeadSourceUser", fields: [sourceUserId], references: [id])
  /// MARKETER or PARTNER: one of the organisation's list.
  sourceReferrerId String?
  sourceReferrer   LeadReferrer? @relation(fields: [sourceReferrerId], references: [id])
  /// DIRECT: PHONE | EXHIBITION | EVENT | CAMPAIGN
  sourceChannel    String?
  estimatedValue Decimal?  @db.Decimal(20, 2)
  need           String?
  state          String    @default("NEW")
  ownerId        String?
  owner          User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  disqualifyReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  opportunities Opportunity[]

  @@index([organizationId, state])
  @@index([organizationId, phone])
  @@map("leads")
}

model Opportunity {
  id                String    @id @default(uuid())
  organizationId    String
  code              String    @unique
  title             String
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?     @relation(fields: [leadId], references: [id])
  estimatedValue    Decimal   @db.Decimal(20, 2)
  expectedCloseDate DateTime?
  servicesNeeded    String[]  @default([])
  description       String?
  state             String    @default("NEW")
  ownerId           String?
  owner             User?     @relation("OpportunityOwner", fields: [ownerId], references: [id])
  lostReason        String?
  wonAt             DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  briefs     Brief[]
  activities Activity[]
  projects   Project[]
  formSubmissions FormSubmission[]

  @@index([organizationId, state])
  @@index([companyId])
  @@map("opportunities")
}

model Activity {
  id            String       @id @default(uuid())
  organizationId String
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          String
  occurredAt    DateTime
  summary       String
  nextStep      String?
  nextStepDue   DateTime?
  createdById   String
  createdAt     DateTime     @default(now())

  @@index([companyId])
  @@index([opportunityId])
  @@map("activities")
}

/* ═══════════════════════ Brief → Proposal → Pricing ═══════════════════════ */

model Brief {
  id                   String      @id @default(uuid())
  organizationId       String
  code                 String      @unique
  opportunityId        String
  opportunity          Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title                String
  businessObjective    String?
  targetAudience       String?
  scope                String?
  expectedDeliverables String?
  budgetRange          Decimal?    @db.Decimal(20, 2)
  desiredDeadline      DateTime?
  unitsNeeded          String[]    @default([])
  competitorContext    String?
  constraints          String?
  successCriteria      String?
  state                String      @default("DRAFT")
  /** Populated by the completeness guard; drives the KPI "Brief Completeness". */
  completenessScore    Int         @default(0)
  /// How *specific* the brief is, not merely whether it is filled (roadmap #25) — 0–100, and
  /// the band it falls in. Kept so the return rate can be read against it over time.
  qualityScore         Int?
  qualityBand          String?
  missingItems         String[]    @default([])
  returnReason         String?
  returnCount          Int         @default(0)
  submittedById        String?
  reviewedById         String?
  approvedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  proposals Proposal[]
  projects  Project[]

  @@index([organizationId, state])
  @@map("briefs")
}

model Proposal {
  id                  String   @id @default(uuid())
  organizationId      String
  code                String   @unique
  briefId             String
  brief               Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  title               String
  version             Int      @default(1)
  executiveSummary    String?
  approach            String?
  deliverablesSummary String?
  timelineSummary     String?
  state               String   @default("DRAFT")

  // Pricing — Doc_H §12: totalCost is declared by units, salePrice/margin only via pricing.set_price
  totalCost           Decimal? @db.Decimal(20, 2)
  salePrice           Decimal? @db.Decimal(20, 2)
  marginPercent       Decimal? @db.Decimal(7, 2)
  paymentTerms        String?
  contractScaleBand   String?
  pricingRationale    String?
  pricedById          String?
  pricedAt            DateTime?
  pricingApprovedById String?
  pricingApprovedAt   DateTime?

  clientFeedback      String?
  clientDecision      String?
  revisionCount       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  workOrders  WorkOrder[]
  qcReviews   QcReview[]
  costDeclarations CostDeclaration[]
  revisions   Revision[]
  contracts   Contract[]
  projects    Project[]
  versions    ProposalVersion[]
  deliverables Deliverable[]
  documents   Document[]

  @@index([organizationId, state])
  @@map("proposals")
}

model ProposalVersion {
  id          String   @id @default(uuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  changeNote  String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([proposalId, version])
  @@map("proposal_versions")
}

model CostDeclaration {
  id             String     @id @default(uuid())
  organizationId String
  proposalId     String?
  proposal       Proposal?  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  workOrderId    String?
  workOrder      WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  departmentCode String
  internalCost   Decimal    @db.Decimal(20, 2)
  externalCost   Decimal    @default(0) @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  externalCurrency     String    @default("IRR")
  fxRate               Decimal   @default(1) @db.Decimal(24, 6)
  fxRateDate           DateTime?
  originalExternalCost Decimal?  @db.Decimal(20, 2)
  items          Json       @default("[]")
  assumptions    String?
  declaredById   String
  createdAt      DateTime   @default(now())

  @@index([proposalId])
  @@index([workOrderId])
  @@map("cost_declarations")
}

/* ═══════════════════════ Handoff (Doc_H rule 2) ═══════════════════════ */

model Handoff {
  id                 String   @id @default(uuid())
  organizationId     String
  code               String   @unique
  companyId          String
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id])
  contractId         String?
  salesOwnerId       String
  accountOwnerId     String
  commitmentsMade    String
  clientExpectations String
  sensitivities      String?
  openItems          String?
  state              String   @default("DRAFT")
  acceptedAt         DateTime?
  returnReason       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, state])
  @@map("handoffs")
}

/* ═══════════════════════ Project & execution ═══════════════════════ */

model Project {
  id             String       @id @default(uuid())
  organizationId String
  code           String       @unique
  name           String
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  briefId        String?
  brief          Brief?       @relation(fields: [briefId], references: [id])
  proposalId     String?
  proposal       Proposal?    @relation(fields: [proposalId], references: [id])
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  accountOwnerId String
  accountOwner   User         @relation("ProjectAccountOwner", fields: [accountOwnerId], references: [id])
  objective      String?
  inScope        String?
  outOfScope     String?
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  plannedBudget  Decimal?     @db.Decimal(20, 2)
  contractValue  Decimal?     @db.Decimal(20, 2)
  /// Roadmap #28: copied from the registered contract — its currency and value as written.
  contractCurrency      String   @default("IRR")
  originalContractValue Decimal? @db.Decimal(20, 2)
  /// Roadmap #29: how revenue is earned as the work goes — MILESTONE | EFFORT | COST.
  revenueMethod         String   @default("EFFORT")
  revenueEntries        RevenueEntry[]
  mediaOrders           MediaOrder[]
  state          String       @default("DRAFT")
  /// The project's reference in the system it came from (roadmap #48): a migration file run twice
  /// finds it and does not create it again.
  legacyRef      String?
  healthStatus   String       @default("GREEN")
  closedAt       DateTime?
  cancelReason   String?
  holdReason     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  authorizations   ExecutionAuthorization[]
  lessonReviews    LessonReview[]
  milestones       Milestone[]
  deliverables     Deliverable[]
  workOrders       WorkOrder[]
  tasks            Task[]
  raciAssignments  RaciAssignment[]
  changeRequests   ChangeRequest[]
  risks            Risk[]
  issues           Issue[]
  decisions        Decision[]
  meetings         Meeting[]
  statusReports    StatusReport[]
  contracts        Contract[]
  invoices         Invoice[]
  payments         Payment[]
  allocations      Allocation[]
  outsourceRequests OutsourceRequest[]
  portalMessages   PortalMessage[]
  documents        Document[]
  feedbacks        Feedback[]
  lessonsLearned   LessonLearned[]
  closureChecklist ClosureChecklist?
  activities       Activity[]
  handoffs         Handoff[]
  formSubmissions  FormSubmission[]
  comments         Comment[]

  @@index([organizationId, state])
  @@index([companyId])
  @@unique([organizationId, legacyRef])
  @@map("projects")
}

/// Doc_H §13 — a project may not enter execution without one of the three authorisation bases.
model ExecutionAuthorization {
  id                String    @id @default(uuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  basis             String
  contractId        String?
  invoiceId         String?
  referenceDocument String
  notes             String?
  authorizedById    String
  authorizedAt      DateTime  @default(now())
  revokedAt         DateTime?
  revokeReason      String?

  @@index([projectId])
  @@map("execution_authorizations")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  /// Roadmap #29: the share of the contract value earned when this milestone is done (percent).
  revenueShare Decimal? @db.Decimal(5, 2)
  sortOrder   Int       @default(0)

  @@index([projectId])
  @@map("milestones")
}

model RaciAssignment {
  id             String  @id @default(uuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity       String
  departmentCode String
  raciRole       String
  userId         String?
  user           User?   @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@map("raci_assignments")
}

model WorkOrder {
  id                   String    @id @default(uuid())
  organizationId       String
  code                 String    @unique
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId           String?
  proposal             Proposal? @relation(fields: [proposalId], references: [id])
  targetDepartmentCode String
  title                String
  scopeOfWork          String
  brief                String
  expectedOutput       String
  outputFormat         String
  deadline             DateTime
  ownerId              String
  owner                User      @relation("WorkOrderOwner", fields: [ownerId], references: [id])
  budget               Decimal?  @db.Decimal(20, 2)
  requiredResources    String?
  priority             String    @default("NORMAL")
  state                String    @default("DRAFT")
  acceptedAt           DateTime?
  acceptedById         String?
  committedDate        DateTime?
  clarificationNote    String?
  submittedAt          DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tasks            Task[]
  deliverables     Deliverable[]
  costDeclarations CostDeclaration[]
  qcReviews        QcReview[]
  outsourceRequests OutsourceRequest[]

  @@index([organizationId, state])
  @@index([projectId])
  @@index([targetDepartmentCode, state])
  @@map("work_orders")
}

model Task {
  id             String     @id @default(uuid())
  organizationId String
  code           String     @unique
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId    String?
  workOrder      WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  deliverableId  String?
  deliverable    Deliverable? @relation(fields: [deliverableId], references: [id])
  title          String
  description    String?
  departmentCode String
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate        DateTime?
  estimateHours  Decimal?   @db.Decimal(8, 2)
  /// Maintained as the sum of timeEntries; never edited directly.
  actualHours    Decimal?   @db.Decimal(8, 2)
  timeEntries    TimeEntry[]
  priority       String     @default("NORMAL")
  state          String     @default("CREATED")
  /// Doc_H §6 — no verbal task: every task must trace to one of six authorised source documents.
  sourceType     String
  sourceRef      String
  blockReason    String?
  acceptedAt     DateTime?
  submittedAt    DateTime?
  closedAt       DateTime?
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  dependsOn    TaskDependency[] @relation("DependentTask")
  dependedOnBy TaskDependency[] @relation("PrerequisiteTask")
  qcReviews    QcReview[]
  revisions    Revision[]
  comments     Comment[]

  @@index([organizationId, state])
  @@index([projectId, state])
  @@index([assigneeId, state])
  @@index([departmentCode, state])
  @@map("tasks")
}

model TaskDependency {
  id             String @id @default(uuid())
  taskId         String
  task           Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Task   @relation("PrerequisiteTask", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  kind           String @default("FINISH_TO_START")

  @@unique([taskId, prerequisiteId])
  @@map("task_dependencies")
}

model Deliverable {
  id             String     @id @default(uuid())
  organizationId String
  code           String     @unique
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId     String?
  proposal       Proposal?  @relation(fields: [proposalId], references: [id])
  workOrderId    String?
  workOrder      WorkOrder? @relation(fields: [workOrderId], references: [id])
  name           String
  description    String?
  departmentCode String
  format         String?
  version        String     @default("v1")
  dueDate        DateTime?
  state          String     @default("PLANNED")
  submittedAt    DateTime?
  deliveredAt    DateTime?
  acceptedAt     DateTime?
  rejectReason   String?
  /// QC stage zero (roadmap #22): the mechanical checks run when the unit hands over — PASS,
  /// WARN or FAIL — when they last ran, and what they found. A reviewer sees them before opening a file.
  stageZeroVerdict  String?
  stageZeroAt       DateTime?
  stageZeroFindings Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  qcReviews QcReview[]
  revisions Revision[]
  tasks     Task[]
  documents Document[]
  annotations Annotation[]

  @@index([organizationId, state])
  @@index([projectId, state])
  @@map("deliverables")
}

/* ═══════════════════════ Quality control (Doc_H §9, §10) ═══════════════════════ */

model QcReview {
  id             String       @id @default(uuid())
  organizationId String
  code           String       @unique
  level          String
  deliverableId  String?
  deliverable    Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  workOrderId    String?
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  proposalId     String?
  proposal       Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checklist      Json         @default("{}")
  verdict        String       @default("PENDING")
  findings       String?
  reviewerId     String
  reviewer       User         @relation(fields: [reviewerId], references: [id])
  reviewedAt     DateTime     @default(now())

  revisions Revision[]
  annotations Annotation[]
  /// Photos taken at the review (roadmap #49) — evidence of the check, not part of the deliverable.
  documents   Document[]

  @@index([organizationId, level, verdict])
  @@index([deliverableId])
  @@map("qc_reviews")
}

model Revision {
  id                       String       @id @default(uuid())
  organizationId           String
  code                     String       @unique
  deliverableId            String?
  deliverable              Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  proposalId               String?
  proposal                 Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  taskId                   String?
  task                     Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  qcReviewId               String?
  qcReview                 QcReview?    @relation(fields: [qcReviewId], references: [id])
  /// Doc_H §10 — mandatory, non-null: no revision may exist without a recorded reason.
  reason                   String
  requiredCorrection       String
  responsibleDepartmentCode String
  assigneeId               String?
  assignee                 User?        @relation("RevisionAssignee", fields: [assigneeId], references: [id])
  dueDate                  DateTime
  state                    String       @default("REQUESTED")
  round                    Int          @default(1)
  resolvedAt               DateTime?
  rejectNote               String?
  requestedById            String
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  annotations Annotation[]

  @@index([organizationId, state])
  @@index([responsibleDepartmentCode, state])
  @@map("revisions")
}

/* ═══════════════════════ Change control (Doc_H §8) ═══════════════════════ */

model ChangeRequest {
  id             String   @id @default(uuid())
  organizationId String
  code           String   @unique
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  requestedChange String
  requestedBy    String
  requestedDate  DateTime
  priority       String   @default("NORMAL")
  state          String   @default("SUBMITTED")

  scopeVerdict   String   @default("UNDETERMINED")
  scopeRationale String?
  scopeReviewedById String?
  scopeReviewedAt DateTime?

  // Doc_H §8 — the six mandatory impact dimensions
  timeImpactDays   Decimal? @db.Decimal(8, 2)
  costImpact       Decimal? @db.Decimal(20, 2)
  resourceImpact   String?
  scopeImpact      String?
  qualityImpact    String?
  contractImpact   String?
  proposedPrice    Decimal? @db.Decimal(20, 2)
  impactAssessedById String?
  impactAssessedAt DateTime?

  customerDecision String?
  customerDecidedAt DateTime?
  rejectReason     String?
  closedAt         DateTime?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  amendments Amendment[]

  @@index([organizationId, state])
  @@index([projectId, state])
  @@map("change_requests")
}

/* ═══════════════════════ Contract & legal ═══════════════════════ */

model Contract {
  id             String    @id @default(uuid())
  organizationId String
  code           String    @unique
  contractNumber String?
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalId     String?
  proposal       Proposal? @relation(fields: [proposalId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  title          String
  contractValue  Decimal   @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  currency       String    @default("IRR")
  fxRate         Decimal   @default(1) @db.Decimal(24, 6)
  fxRateDate     DateTime?
  originalValue  Decimal?  @db.Decimal(20, 2)
  startDate      DateTime
  endDate        DateTime
  scopeSummary   String?
  paymentTerms   String?
  state          String    @default("REQUESTED")
  legalReviewNote String?
  revisionNote   String?
  signedDate     DateTime?
  registeredAt   DateTime?
  terminateReason String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  amendments Amendment[]
  invoices   Invoice[]
  documents  Document[]
  signatureEnvelopes SignatureEnvelope[]

  @@index([organizationId, state])
  @@index([companyId])
  @@map("contracts")
}

model Amendment {
  id                String         @id @default(uuid())
  contractId        String
  contract          Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changeRequestId   String?
  changeRequest     ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  amendmentNumber   String
  effectiveDate     DateTime
  changes           String
  valueDelta        Decimal        @default(0) @db.Decimal(20, 2)
  /// Roadmap #28: for a contract in another currency, the delta as written and the rate that converted it.
  originalValueDelta Decimal?      @db.Decimal(20, 2)
  fxRate             Decimal       @default(1) @db.Decimal(24, 6)
  fxRateDate         DateTime?
  durationDeltaDays Int            @default(0)
  createdById       String
  createdAt         DateTime       @default(now())

  @@index([contractId])
  @@map("amendments")
}

/* ═══════════════════════ Finance ═══════════════════════ */

model Invoice {
  id             String    @id @default(uuid())
  organizationId String
  code           String    @unique
  kind           String
  number         String
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  contractId     String?
  contract       Contract? @relation(fields: [contractId], references: [id])
  issueDate      DateTime
  dueDate        DateTime?
  lines          Json      @default("[]")
  subtotal       Decimal   @db.Decimal(20, 2)
  taxPercent     Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(20, 2)
  total          Decimal   @db.Decimal(20, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  currency           String    @default("IRR")
  /// Base units per one unit of `currency`, as in force on the issue date — frozen with the invoice.
  fxRate             Decimal   @default(1) @db.Decimal(24, 6)
  /// The date of the rate used (the latest on or before the issue date).
  fxRateDate         DateTime?
  originalSubtotal   Decimal?  @db.Decimal(20, 2)
  originalTaxAmount  Decimal?  @db.Decimal(20, 2)
  originalTotal      Decimal?  @db.Decimal(20, 2)
  /// Settlement is counted in the invoice's own currency; paidAmount is that, at the invoice's rate.
  originalPaidAmount Decimal?  @db.Decimal(20, 2)
  state          String    @default("DRAFT")
  notes          String?
  cancelReason   String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments Payment[]

  @@index([organizationId, state])
  @@index([companyId])
  @@map("invoices")
  mediaOrders        MediaOrder[]
  taxSubmissions     TaxSubmission[]
  /// Roadmap #33: the accounting export that posted it, and the one that reversed it after cancellation.
  accountingExportId         String?
  accountingExport           AccountingExport? @relation("InvoicePosted", fields: [accountingExportId], references: [id])
  accountingReversalExportId String?
  accountingReversalExport   AccountingExport? @relation("InvoiceReversed", fields: [accountingReversalExportId], references: [id])
}

model Payment {
  id             String    @id @default(uuid())
  organizationId String
  invoiceId      String?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  direction      String
  amount         Decimal   @db.Decimal(20, 2)
  /// Roadmap #28: the currency these figures were written in. The base columns above stay in the
  /// organisation's currency, so every report sums like with like; null originals mean "written in base".
  currency        String    @default("IRR")
  fxRate          Decimal   @default(1) @db.Decimal(24, 6)
  fxRateDate      DateTime?
  originalAmount  Decimal?  @db.Decimal(20, 2)
  /// How much of the linked invoice this settles, in the invoice's currency.
  settledOriginal Decimal?  @db.Decimal(20, 2)
  /// Roadmap #31: a payment to a media vendor for this order — pass-through, not the project's cost.
  mediaOrderId    String?
  mediaOrder      MediaOrder? @relation(fields: [mediaOrderId], references: [id], onDelete: SetNull)
  /// Roadmap #33: the accounting export that posted it.
  accountingExportId String?
  accountingExport   AccountingExport? @relation(fields: [accountingExportId], references: [id])
  occurredAt     DateTime
  method         String    @default("TRANSFER")
  reference      String?
  description    String?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([organizationId, direction])
  @@index([invoiceId])
  @@index([projectId])
  @@map("payments")
}

model Settlement {
  id             String   @id @default(uuid())
  projectId      String   @unique
  totalInvoiced  Decimal  @db.Decimal(20, 2)
  totalReceived  Decimal  @db.Decimal(20, 2)
  balance        Decimal  @db.Decimal(20, 2)
  status         String
  notes          String?
  settledById    String
  settledAt      DateTime @default(now())

  @@map("settlements")
}

/* ═══════════════════════ Resources & suppliers (Doc_H §5) ═══════════════════════ */

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  kind           String
  departmentCode String?
  specialty      String?
  contactName    String?
  phone          String?
  email          String?
  dayRate        Decimal? @db.Decimal(20, 2)
  averageRating  Decimal? @db.Decimal(3, 2)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evaluations       SupplierEvaluation[]
  outsourceRequests OutsourceRequest[]
  payments          Payment[]

  @@index([organizationId, kind])
  @@map("suppliers")
  mediaOrders    MediaOrder[]
}

model SupplierEvaluation {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  projectId     String?
  quality       Int
  timeliness    Int
  communication Int
  costValue     Int
  wouldReuse    Boolean
  comments      String?
  evaluatedById String
  createdAt     DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_evaluations")
}

model OutsourceRequest {
  id                   String     @id @default(uuid())
  organizationId       String
  code                 String     @unique
  projectId            String
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId          String?
  workOrder            WorkOrder? @relation(fields: [workOrderId], references: [id])
  kind                 String
  supplierId           String?
  supplier             Supplier?  @relation(fields: [supplierId], references: [id])
  proposedSupplierName String?
  scopeOfWork          String
  estimatedCost        Decimal    @db.Decimal(20, 2)
  neededBy             DateTime
  justification        String
  state                String     @default("REQUESTED")
  approvedById         String?
  approvedAt           DateTime?
  rejectReason         String?
  requestedById        String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([organizationId, state])
  @@map("outsource_requests")
}

model Allocation {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  hoursPerDay  Decimal  @db.Decimal(5, 2)
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([userId, fromDate, toDate])
  @@index([projectId])
  @@map("allocations")
}

/* ═══════════════════════ Governance registers ═══════════════════════ */

model Risk {
  id           String    @id @default(uuid())
  organizationId String
  code         String    @unique
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String
  probability  String
  impact       String
  mitigation   String?
  state        String    @default("OPEN")
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, state])
  @@map("risks")
}

model Issue {
  id               String    @id @default(uuid())
  organizationId   String
  code             String    @unique
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String
  severity         String
  state            String    @default("OPEN")
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id])
  targetResolution DateTime?
  resolvedAt       DateTime?
  resolution       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, state])
  @@map("issues")
}

model Decision {
  id           String   @id @default(uuid())
  organizationId String
  code         String   @unique
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  context      String
  decision     String
  alternatives String?
  decidedById  String
  decidedBy    User     @relation(fields: [decidedById], references: [id])
  decidedAt    DateTime
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@map("decisions")
}

model Meeting {
  id          String   @id @default(uuid())
  organizationId String
  code        String   @unique
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String
  subject     String
  heldAt      DateTime
  attendees   String
  agenda      String?
  decisions   String?
  actions     Json     @default("[]")
  minutesRecordedAt DateTime?
  /// The notes or transcript the minutes were drawn from (roadmap #23) — the evidence behind them.
  minutesSource     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@map("meetings")
}

model StatusReport {
  id              String   @id @default(uuid())
  organizationId  String
  code            String   @unique
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  period          String
  progress        String
  completed       String?
  inProgress      String?
  next            String?
  timelineStatus  String?
  risks           String?
  issues          String?
  decisionsNeeded String?
  financialStatus String?
  createdById     String
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@map("status_reports")
}

/* ═══════════════════════ Closure & customer success (Doc_H §15) ═══════════════════════ */

model ClosureChecklist {
  id                        String   @id @default(uuid())
  projectId                 String   @unique
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allDeliverablesDelivered  Boolean  @default(false)
  finalQcDone               Boolean  @default(false)
  clientApprovalRecorded    Boolean  @default(false)
  closureReportDone         Boolean  @default(false)
  financialStatusClear      Boolean  @default(false)
  feedbackRecorded          Boolean  @default(false)
  lessonsLearnedRecorded    Boolean  @default(false)
  closedInSystem            Boolean  @default(false)
  notes                     String?
  updatedById               String?
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())

  @@map("closure_checklists")
}

model Feedback {
  id                  String   @id @default(uuid())
  organizationId      String
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  csat                Int
  nps                 Int
  qualityRating       Int?
  timelinessRating    Int?
  communicationRating Int?
  positives           String?
  improvements        String?
  futureNeeds         String?
  recordedById        String
  createdAt           DateTime @default(now())

  @@index([projectId])
  @@map("feedbacks")
}

model LessonLearned {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviews        LessonReview[]
  title          String
  category       String
  situation      String
  lesson         String
  recommendation String
  recordedById   String
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@map("lessons_learned")
}

/* ═══════════════════════ Form engine ═══════════════════════ */

model FormDefinition {
  id             String   @id @default(uuid())
  organizationId String
  no             Int
  code           String
  nameFa         String
  nameEn         String
  category       String
  module         String
  senderDepts    String[] @default([])
  receiverDepts  String[] @default([])
  approverRoles  String[] @default([])
  slaCode        String?
  binding        String?
  nextProcessFa  String?
  schema         Json
  /// Conditional approval rules evaluated against the submitted values (roadmap #17).
  routing        Json     @default("[]")
  /// Ordered approval stages with optional quorum (roadmap #18); empty means a single stage.
  approvalChain  Json     @default("[]")
  /// When this organisation last edited the form in the designer (roadmap #15). Set means the
  /// seed must not push the catalogue's schema over it again.
  customizedAt   DateTime?
  customizedById String?
  /// A form this organisation added for itself: outside the Doc_H catalogue, never re-seeded.
  isCustom       Boolean  @default(false)
  isActive       Boolean  @default(true)
  /// Bumped whenever `schema` changes; each value has a FormDefinitionVersion row behind it.
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions FormSubmission[]
  versions    FormDefinitionVersion[]

  /// Roadmap #50: a code names a form within its organisation; another organisation has its own.
  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([module])
  @@map("form_definitions")
}

/// A definition's schema as it stood at one version. Submissions pin a version, so a form can
/// change without rewriting what people already filled in — or what an archived PDF shows.
model FormDefinitionVersion {
  id           String         @id @default(uuid())
  definitionId String
  definition   FormDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version      Int
  schema       Json
  /// The routing rules in force at this version — a submission is judged by its own version.
  routing      Json           @default("[]")
  /// The approval chain in force at this version.
  approvalChain Json          @default("[]")
  nameFa       String
  note         String?
  createdById  String?
  createdAt    DateTime       @default(now())

  @@unique([definitionId, version])
  @@map("form_definition_versions")
}

model FormSubmission {
  id             String         @id @default(uuid())
  organizationId String
  code           String         @unique
  definitionId   String
  definition     FormDefinition @relation(fields: [definitionId], references: [id])
  /// The definition version this was filled in under. Rendering and validation use it, not
  /// whatever the definition says today.
  definitionVersion Int         @default(1)
  data           Json
  state          String         @default("DRAFT")
  submittedById  String
  submittedBy    User           @relation("FormSubmitter", fields: [submittedById], references: [id])
  assignedToId   String?
  assignedTo     User?          @relation("FormAssignee", fields: [assignedToId], references: [id])
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// A key the client generated before the form left the device (roadmap #19). A submission
  /// queued offline and retried over a flaky link must file once, not once per attempt.
  clientKey      String?
  /// Who must approve this submission: the form's own roles plus whatever its routing rules
  /// added for these values (roadmap #17). Empty on rows written before routing existed.
  requiredRoles  String[] @default([])
  /// The rules that fired, with the sentence each was written in — why those roles are there.
  routing        Json?
  /// The approval stages this submission must pass, and how far it has got (roadmap #18).
  stages         Json?
  /// Index of the stage awaiting a decision; equals stages.length once every stage has cleared.
  currentStage   Int      @default(0)
  /// Roles that may decide *right now* — the waiting stage's roles. Kept as a column so an
  /// approval inbox is one query, and empty once the form is decided.
  currentRoles   String[] @default([])
  /// The domain record this submission created or drove, when the form has a typed binding.
  boundEntity    String?
  boundEntityId  String?
  submittedAt    DateTime?
  decidedAt      DateTime?
  returnReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  approvals FormApproval[]
  documents Document[]

  @@unique([organizationId, clientKey])
  @@index([organizationId, state])
  @@index([definitionId, state])
  @@index([assignedToId, state])
  @@index([projectId])
  @@map("form_submissions")
}

model FormApproval {
  id           String         @id @default(uuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approverId   String
  approver     User           @relation(fields: [approverId], references: [id])
  /// The stage this decision was recorded against (roadmap #18); null on pre-chain rows.
  stage        String?
  decision     String
  comment      String?
  decidedAt    DateTime       @default(now())

  @@index([submissionId])
  @@map("form_approvals")
}

/* ═══════════════════════ SLA engine ═══════════════════════ */

model SlaPolicy {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  labelFa        String
  labelEn        String
  hours          Decimal  @db.Decimal(8, 2)
  warnAt         Decimal  @default(0.75) @db.Decimal(4, 3)
  docRef         String?
  isActive       Boolean  @default(true)
  /// Roadmap #50: the organisation set its own hours; the catalogue no longer moves them on upgrade.
  customizedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clocks SlaClock[]

  @@unique([organizationId, code])
  @@map("sla_policies")
}

model SlaClock {
  id           String    @id @default(uuid())
  organizationId String
  policyId     String
  policy       SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  startedAt    DateTime  @default(now())
  dueAt        DateTime
  stoppedAt    DateTime?
  pausedAt     DateTime?
  /// Wall-clock seconds spent paused, for people.
  pausedSeconds Int      @default(0)
  /// Working hours spent paused, for the arithmetic: consumed = elapsed − pausedHours.
  pausedHours  Decimal   @default(0) @db.Decimal(8, 2)
  state        String    @default("RUNNING")
  warnedAt     DateTime?
  /// When the owner was told this clock was *predicted* to breach — once per clock (roadmap #8).
  riskNotifiedAt DateTime?
  /// The probability that prompted that message, kept so the prediction can be judged afterwards.
  riskProbability Decimal? @db.Decimal(4, 3)
  breachedAt   DateTime?
  ownerId      String?
  pauses       SlaPause[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([organizationId, state])
  @@index([entityType, entityId])
  @@index([state, dueAt])
  @@map("sla_clocks")
}

/// One pause of one clock: who, why, and for how long. The clock carries the running totals;
/// this is the record behind them, so "why was this late" has an answer with names on it.
model SlaPause {
  id             String    @id @default(uuid())
  organizationId String
  clockId        String
  clock          SlaClock  @relation(fields: [clockId], references: [id], onDelete: Cascade)
  kind           String
  reason         String
  pausedAt       DateTime  @default(now())
  resumedAt      DateTime?
  /// Working hours between pausedAt and resumedAt, fixed at resume.
  businessHours  Decimal?  @db.Decimal(8, 2)
  pausedById     String?
  resumedById    String?
  createdAt      DateTime  @default(now())

  @@index([clockId])
  @@index([organizationId, kind])
  @@map("sla_pauses")
}

/* ═══════════════════════ Documents ═══════════════════════ */

model Document {
  id             String          @id @default(uuid())
  organizationId String
  fileName       String
  storedName     String          @unique
  mimeType       String
  sizeBytes      Int
  checksum       String?
  version        Int             @default(1)
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract?       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliverableId  String?
  deliverable    Deliverable?    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  submissionId   String?
  submission     FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// Roadmap #35: a file presented with a proposal — the deck the client is asked to approve.
  proposalId     String?
  proposal       Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// Evidence of a QC review (roadmap #49): a photo from the set is the review's, not the deliverable's.
  qcReviewId     String?
  qcReview       QcReview?       @relation(fields: [qcReviewId], references: [id], onDelete: Cascade)
  /// Roadmap #34: shown to the client in the portal. Off unless someone in Account turns it on.
  clientVisible  Boolean         @default(false)
  /// Roadmap #42: the family of versions this file belongs to — the first version's id — and, once
  /// a newer version is uploaded, when and by which file it was superseded. `version` counts within it.
  lineageId      String?
  supersededAt   DateTime?
  supersededById String?
  /// What the file itself says: dimensions, colour space, duration, pages, font family.
  metadata       Json?
  /// On a client's brand library: LOGO | FONT | GUIDELINE | IMAGE | OTHER.
  brandRole      String?
  tags           String[]        @default([])
  uploadedById   String
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?

  annotations       Annotation[]
  envelopesSent     SignatureEnvelope[] @relation("EnvelopeOriginal")
  envelopesSigned   SignatureEnvelope[] @relation("EnvelopeSigned")

  @@index([organizationId])
  @@index([projectId])
  @@index([lineageId])
  @@index([qcReviewId])
  @@map("documents")
}

model Comment {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  body        String
  mentions    String[] @default([])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType, entityId])
  @@map("comments")
}

/* ═══════════════════════ Audit, workflow log, notifications, AI ═══════════════════════ */

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  action         String
  entityType     String
  entityId       String?
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  /// Set when the actor held the permission only through a delegation: "A, as B's delegate".
  onBehalfOfId   String?
  /// Roadmap #46: the API key the request came through — the actor is the key's creator.
  apiKeyId       String?
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_events")
}

model StateTransition {
  id         String   @id @default(uuid())
  organizationId String
  entityType String
  entityId   String
  fromState  String
  toState    String
  action     String
  reason     String?
  /// Written by a cascade from another record's move, not by someone acting on this one.
  cascade      Boolean  @default(false)
  /// The state a record had when it came over from a previous system (roadmap #48) — recorded,
  /// not moved: no guard ran, and mining, the rule lab and webhooks leave it out.
  opening      Boolean  @default(false)
  /// See AuditEvent.onBehalfOfId.
  onBehalfOfId String?
  /// The rule-set versions in force when this happened (RuleSetVersion ids).
  rulesVersionId       String?
  permissionsVersionId String?
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
  /// Audit LOG-1: the id of the transaction that wrote it, set by the database. A reader that stops
  /// below the oldest transaction still running sees every row there will ever be up to that point —
  /// which createdAt, the transaction's start time, cannot promise. 0 for rows from before.
  txid       BigInt   @default(dbgenerated("((pg_current_xact_id())::text)::bigint"))

  @@index([entityType, entityId, createdAt])
  @@index([organizationId, txid, id])
  @@map("state_transitions")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  severity   String    @default("INFO")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Doc_H-derived AI governance: every AI call is recorded with its actor, scope and grounding.
/// Something in the audit trail that does not look like its usual self (roadmap #26). The trail
/// was always complete and inspectable; nobody inspects it until after the fact. An alert is
/// the same data, raised while it can still matter — and it only ever informs a person: it never
/// locks an account, because a false positive on someone's record has a human cost.
model SecurityAlert {
  id             String    @id @default(uuid())
  organizationId String
  /// OFF_HOURS_EXPORT | DOWNLOAD_SURGE | OUT_OF_SCOPE_ACCESS | DENIAL_SURGE | LOGIN_FAILURES | TOKEN_REUSE
  kind           String
  /// INFO | MEDIUM | HIGH | CRITICAL
  severity       String
  actorId        String?
  ipAddress      String?
  windowStart    DateTime
  windowEnd      DateTime
  /// Counts, the person's own baseline, and the event ids behind them — the case, not a verdict.
  evidence       Json
  messageFa      String
  /// One alert per kind, subject and window: a rescan updates it instead of raising it again.
  fingerprint    String
  /// OPEN | ACKNOWLEDGED | DISMISSED
  status         String    @default("OPEN")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, createdAt])
  @@map("security_alerts")
}

/// A past lesson, weighed against a new project (roadmap #44). Doc_H makes lessons mandatory
/// at closure and puts them on the closing checklist, but a lesson nobody reads is a ritual.
/// Surfacing them at kick-off is half the answer; recording what the team *did* with each one
/// is the other half, and it is what turns "we archive" into "we learn".
model LessonReview {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         LessonLearned @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// APPLIED — it changed how this project is being run; NOT_RELEVANT — considered and set aside.
  decision       String
  note           String?
  reviewedById   String
  createdAt      DateTime @default(now())

  @@unique([projectId, lessonId])
  @@index([organizationId, projectId])
  @@map("lesson_reviews")
}

/// One indexed piece of organisational memory (roadmap #21): a brief, a proposal, a set of
/// meeting minutes, a lesson learned, a piece of client feedback — reduced to the text worth
/// remembering and the vector that text embeds to.
///
/// The vector is a plain float array rather than a pgvector column so the feature needs no
/// extension to work (ADR-006 — one datastore, and no new one). Where pgvector *is* installed,
/// an ANN index is a drop-in addition; the arithmetic below does not change.
model MemoryDocument {
  id             String   @id @default(uuid())
  organizationId String
  /// brief | proposal | meeting | lessonLearned | feedback | statusReport | caseStudy
  entityType     String
  entityId       String
  /// The project this memory belongs to, when it has one — for filtering and for #44.
  projectId      String?
  companyId      String?
  titleFa        String
  /// The text that was embedded, kept so a result can show why it matched.
  body           String
  /// Normalised, lower-cased text used for the lexical half of the search.
  searchText     String
  vector         Float[]
  dims           Int
  /// Which embedder produced the vector — results say so rather than implying one quality.
  model          String
  /// updatedAt of the source record when this was indexed; a later one means it is stale.
  sourceUpdatedAt DateTime
  indexedAt      DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([organizationId, entityType])
  @@index([organizationId, projectId])
  @@map("memory_documents")
}

model AiInteraction {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  capability     String
  entityType     String?
  entityId       String?
  model          String
  promptSummary  String
  responseText   String?
  groundingRefs  Json     @default("[]")
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  succeeded      Boolean  @default(true)
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("ai_interactions")
}

model Counter {
  id     String @id @default(uuid())
  scope  String @unique
  value  Int    @default(0)

  @@map("counters")
}

/// An exchange rate (roadmap #28): base-currency units for one unit of `currency`, in force from
/// `effectiveDate` until the next one. Records keep the rate they were converted at, so correcting
/// a rate here never moves a figure already booked.
model ExchangeRate {
  id             String   @id @default(uuid())
  organizationId String
  currency       String
  rate           Decimal  @db.Decimal(24, 6)
  effectiveDate  DateTime @db.Date
  /// MANUAL | IMPORT
  source         String   @default("MANUAL")
  note           String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, currency, effectiveDate])
  @@map("exchange_rates")
}

/// A project's recognised revenue as frozen when its period was closed (roadmap #29). The open
/// period is computed live; a closed one never changes — a late correction lands in the next
/// open period as a catch-up, the way a closed month is treated in any set of books.
model RevenueEntry {
  id               String   @id @default(uuid())
  organizationId   String
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Jalali month, «1405-07».
  period           String
  periodEnd        DateTime
  method           String
  /// Share of the work done by the period's end, 0..1.
  progress         Decimal  @db.Decimal(7, 6)
  /// Contract value in force at the period's end (base currency).
  contractValue    Decimal  @db.Decimal(20, 2)
  recognisedToDate Decimal  @db.Decimal(20, 2)
  /// Recognised in this period: to date, less what earlier periods froze.
  amount           Decimal  @db.Decimal(20, 2)
  invoicedToDate   Decimal  @db.Decimal(20, 2)
  /// The figures the progress was computed from, so a closed month can be explained later.
  basis            Json
  createdAt        DateTime @default(now())

  @@unique([projectId, period])
  @@index([organizationId, period])
  @@map("revenue_entries")
}

/// A closed accounting month (roadmap #29). Closed in order; never reopened.
model RevenuePeriod {
  id             String   @id @default(uuid())
  organizationId String
  period         String
  periodStart    DateTime
  periodEnd      DateTime
  closedAt       DateTime @default(now())
  closedById     String
  /// Recognised, invoiced, labour and external cost for the month, as they stood at closing.
  totals         Json

  @@unique([organizationId, period])
  @@map("revenue_periods")
}

/**
 * Media bought on a client's behalf (roadmap #31). The vendor's net is a pass-through — billed to
 * the client and paid to the vendor, never the agency's revenue; the agency's revenue is the
 * commission (COMMISSION) or the markup (MARKUP). All four figures are computed when the order is
 * written and kept in base; an order in another currency keeps its originals and rate (#28).
 */
model MediaOrder {
  id                   String    @id @default(uuid())
  organizationId       String
  code                 String    @unique
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id])
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id])
  workOrderId          String?
  /// TV | RADIO | OUTDOOR | PRINT | DIGITAL | CINEMA | OTHER
  channel              String
  placement            String
  flightStart          DateTime
  flightEnd            DateTime
  /// COMMISSION | MARKUP
  pricingModel         String
  commissionPercent    Decimal   @db.Decimal(5, 2)
  /// The vendor's price as quoted: gross (COMMISSION) or net (MARKUP), in `currency`.
  quotedAmount         Decimal   @db.Decimal(20, 2)
  /// Base: what the client is billed for the media, what the vendor is owed, and the difference.
  clientAmount         Decimal   @db.Decimal(20, 2)
  netAmount            Decimal   @db.Decimal(20, 2)
  agencyRevenue        Decimal   @db.Decimal(20, 2)
  currency             String    @default("IRR")
  fxRate               Decimal   @default(1) @db.Decimal(24, 6)
  fxRateDate           DateTime?
  originalClientAmount Decimal?  @db.Decimal(20, 2)
  originalNetAmount    Decimal?  @db.Decimal(20, 2)
  /// The vendor's invoice, in `currency` — reconciled against the booked net.
  vendorInvoiceNumber  String?
  vendorInvoiceAmount  Decimal?  @db.Decimal(20, 2)
  vendorInvoiceDate    DateTime?
  discrepancyNote      String?
  proofNote            String?
  /// The intermediary invoice the client was billed on.
  clientInvoiceId      String?
  clientInvoice        Invoice?  @relation(fields: [clientInvoiceId], references: [id], onDelete: SetNull)
  state                String    @default("DRAFT")
  bookedAt             DateTime?
  airedAt              DateTime?
  reconciledAt         DateTime?
  cancelReason         String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments             Payment[]
  @@index([organizationId, state])
  @@index([projectId])
  @@map("media_orders")
}

/**
 * A key for a system rather than a person (roadmap #46). It acts with its creator's authority,
 * narrowed to `permissions` and never wider than the creator's own at the time of each request;
 * only a hash of the secret is kept. Revoked, expired, or whose creator is gone: it stops.
 */
model ApiKey {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  /// The public part printed on the key («hiva_<prefix>_…»); how a request finds its key.
  prefix             String    @unique
  /// SHA-256 of the whole key. The secret is shown once, at creation, and never again.
  secretHash         String
  permissions        String[]
  rateLimitPerMinute Int       @default(60)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  lastUsedIp         String?
  revokedAt          DateTime?
  revokedById        String?
  revokeReason       String?
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId])
  @@map("api_keys")
}

/**
 * A webhook (roadmap #46): state transitions the creator may read, sent to `url`, signed with
 * `secret`. The transition log is the outbox; `cursorAt`/`cursorId` is how far it has been read.
 */
model WebhookSubscription {
  id                  String    @id @default(uuid())
  organizationId      String
  name                String
  url                 String
  /// Signs every delivery (HMAC-SHA256). Shown once, at creation.
  secret              String
  /// «entity.action», «entity.*» or «*».
  events              String[]
  active              Boolean   @default(true)
  /// Nothing that happened before this is sent: when the subscription was made, or last reactivated.
  cursorAt            DateTime  @default(now())
  /// Audit LOG-1: where the dispatcher has read to in the transition log, by (txid, id). Starts at the
  /// oldest transaction running when the subscription was made.
  cursorTxid          BigInt    @default(dbgenerated("((pg_snapshot_xmin(pg_current_snapshot()))::text)::bigint"))
  cursorId            String?
  consecutiveFailures Int       @default(0)
  disabledAt          DateTime?
  disabledReason      String?
  createdById         String
  createdBy           User      @relation(fields: [createdById], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deliveries          WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_subscriptions")
}

/** One event to one subscriber, retried with backoff until it lands or is given up on. */
model WebhookDelivery {
  id             String              @id @default(uuid())
  organizationId String
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// The state transition it reports; null for a test ping.
  transitionId   String?
  event          String
  payload        Json
  /// PENDING | DELIVERED | DEAD
  status         String              @default("PENDING")
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@unique([subscriptionId, transitionId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/**
 * The organisation as a taxpayer in سامانهٔ مؤدیان (roadmap #32): its fiscal memory, its own
 * identifiers, and the default service and unit codes its invoice lines are reported under.
 */
model TaxProfile {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  /// «شناسهٔ یکتای حافظهٔ مالیاتی» — six characters; the first part of every tax number.
  memoryId           String
  /// The seller's taxpayer number (tins): the national ID of a legal entity.
  sellerTaxId        String
  economicCode       String?
  postalCode         String?
  /// Branch code (sbc), when invoices are issued by a registered branch.
  branchCode         String?
  /// The 13-digit service/goods code (sstid) lines are reported under unless they carry their own.
  defaultServiceCode String
  /// The measurement-unit code (mu) for a line of service.
  defaultUnitCode    String
  updatedById        String
  updatedAt          DateTime @updatedAt

  @@map("tax_profiles")
}

/**
 * One report of an invoice to سامانهٔ مؤدیان (roadmap #32): the original, a correction, or a
 * cancellation — each with its own 22-character tax number, the payload exactly as sent, and what
 * the tax authority said. A correction or cancellation names the tax number it replaces.
 */
model TaxSubmission {
  id               String    @id @default(uuid())
  organizationId   String
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id])
  /// ORIGINAL | CORRECTION | CANCELLATION  (ins 1 | 2 | 3)
  subject          String
  serial           Int
  taxId            String    @unique
  /// The accepted tax number a correction or cancellation refers to (irtaxid).
  referenceTaxId   String?
  payload          Json
  /// QUEUED | SENT | ACCEPTED | REJECTED | FAILED
  status           String    @default("QUEUED")
  referenceNumber  String?
  /// What the authority (or the transport) said, in its own words.
  errors           Json?
  attempts         Int       @default(0)
  /// sandbox | live — where it was sent; null while queued.
  channel          String?
  submittedAt      DateTime?
  respondedAt      DateTime?
  createdById      String
  createdAt        DateTime  @default(now())

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("tax_submissions")
}

/**
 * How this organisation's books name things (roadmap #33): the ledger account for each kind of
 * posting, the detail (تفصیلی) code of each client, and the columns its accounting package imports.
 */
model AccountingSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique
  /// { receivable, revenue, vat, mediaClearing, bank, cash, clientAdvance, projectCost, fxGain, fxLoss } → account code
  accounts       Json
  /// companyId → detail code
  clientCodes    Json     @default("{}")
  /// { columns: [{ field, header }], dateFormat: JALALI | GREGORIAN }
  layout         Json
  updatedById    String
  updatedAt      DateTime @updatedAt

  @@map("accounting_settings")
}

/**
 * One batch of vouchers handed to the accounting package (roadmap #33). The file is kept exactly as
 * produced, so it can be downloaded again; what it posted is marked, so it is never posted twice.
 */
model AccountingExport {
  id               String    @id @default(uuid())
  organizationId   String
  number           Int
  periodTo         DateTime
  vouchers         Int
  lines            Int
  debitTotal       Decimal   @db.Decimal(20, 2)
  creditTotal      Decimal   @db.Decimal(20, 2)
  fileName         String
  content          String
  createdById      String
  createdAt        DateTime  @default(now())
  postedInvoices   Invoice[] @relation("InvoicePosted")
  reversedInvoices Invoice[] @relation("InvoiceReversed")
  postedPayments   Payment[]

  @@unique([organizationId, number])
  @@map("accounting_exports")
}

/// Roadmap #35 — a client's approval, kept as evidence: who (the contact the link was sent to,
/// and the code their mailbox received), when, from where, and the SHA-256 of exactly what they
/// were shown. The decision is sealed into a per-organisation hash chain; a sealed row is not
/// changed afterwards (a trigger refuses it).
model ClientApproval {
  id             String   @id @default(uuid())
  organizationId String
  code           String   @unique
  /// DELIVERABLE | PROPOSAL
  subjectType    String
  subjectId      String
  /// The state the subject must still be in for the decision to apply.
  subjectState   String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName    String
  contactEmail   String
  message        String?
  /// What the client is shown, frozen when the request is made: the subject, its client-facing
  /// content, and each file with its size and SHA-256.
  manifest       Json
  manifestHash   String
  /// SHA-256 of the link's secret; the secret itself is never stored.
  tokenHash      String   @unique
  /// EMAIL — the link went to the contact's address; MANUAL — it was handed to staff to pass on.
  channel        String
  /// PENDING | APPROVED | CHANGES_REQUESTED | CANCELLED | EXPIRED
  status         String   @default("PENDING")
  expiresAt      DateTime
  requestedById  String
  requestedBy    User     @relation(fields: [requestedById], references: [id])
  createdAt      DateTime @default(now())

  codeHash       String?
  codeExpiresAt  DateTime?
  codeAttempts   Int      @default(0)
  codesSent      Int      @default(0)

  /// APPROVE | REQUEST_CHANGES
  decision         String?
  comment          String?
  signerName       String?
  /// EMAIL_CODE — a one-time code sent to the contact's address at decision time; LINK — the link alone.
  verification     String?
  decidedAt        DateTime?
  decidedIp        String?
  decidedUserAgent String?
  sequence         Int?
  prevEvidenceHash String?
  /// Exactly what was hashed, so the hash can be recomputed.
  evidence         Json?
  evidenceHash     String?  @unique
  /// Set when the decision could not be applied to the subject — the evidence stands regardless.
  transitionError  String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?

  events ClientApprovalEvent[]

  @@unique([organizationId, sequence])
  @@index([subjectType, subjectId])
  @@index([organizationId, status])
  @@map("client_approvals")
}

/// Everything that happened to a request, as the client's side saw it — opened, each file
/// downloaded, a code sent, the decision — with address and browser.
model ClientApprovalEvent {
  id         String         @id @default(uuid())
  /// Order of writing — two events in one millisecond still have one order.
  seq        Int            @default(autoincrement())
  approvalId String
  approval   ClientApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  /// CREATED | SENT | OPENED | FILE_VIEWED | FILE_MISMATCH | CODE_SENT | CODE_REJECTED | DECIDED | CANCELLED | EXPIRED
  kind       String
  documentId String?
  ip         String?
  userAgent  String?
  at         DateTime       @default(now())

  @@index([approvalId, at])
  @@map("client_approval_events")
}

/// Roadmap #34 — a client contact's own sign-in to the portal. Not a staff user: no roles, no
/// permissions, its own tokens; it sees its company's projects and nothing else.
model PortalUser {
  id              String    @id @default(uuid())
  organizationId  String
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId       String    @unique
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email           String    @unique
  /// INVITED | ACTIVE | DISABLED
  status          String    @default("INVITED")
  passwordHash    String?
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String
  invitedBy       User      @relation(fields: [invitedById], references: [id])
  lockedUntil     DateTime?
  /// Raised to end every session at once — on disabling, or a new password.
  tokenVersion    Int       @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages PortalMessage[]

  @@index([companyId])
  @@map("portal_users")
}

/// A message on a project between the client (in the portal) and Account (in the app).
model PortalMessage {
  id             String      @id @default(uuid())
  organizationId String
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portalUserId   String?
  portalUser     PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  body           String
  createdAt      DateTime    @default(now())

  @@index([projectId, createdAt])
  @@map("portal_messages")
}

/// Roadmap #36 — a contract sent for electronic signature through a provider: the exact PDF sent
/// (its SHA-256), who signs and in what order, what the provider reported, and the signed PDF it
/// returned. When every signer has signed, the contract is signed through the workflow engine.
model SignatureEnvelope {
  id                 String    @id @default(uuid())
  organizationId     String
  code               String    @unique
  contractId         String
  contract           Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// sandbox | http
  provider           String
  providerRef        String?
  /// SENT | COMPLETED | DECLINED | VOIDED | EXPIRED
  status             String    @default("SENT")
  documentId         String
  document           Document  @relation("EnvelopeOriginal", fields: [documentId], references: [id])
  originalSha256     String
  signedDocumentId   String?
  signedDocument     Document? @relation("EnvelopeSigned", fields: [signedDocumentId], references: [id])
  signedSha256       String?
  expiresAt          DateTime
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  voidedAt           DateTime?
  voidReason         String?
  /// Set when the completed signature could not be applied to the contract.
  transitionError    String?

  signers SignatureSigner[]
  events  SignatureEvent[]

  @@index([contractId])
  @@index([status])
  @@map("signature_envelopes")
}

model SignatureSigner {
  id            String            @id @default(uuid())
  envelopeId    String
  envelope      SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  order         Int
  /// CLIENT | AGENCY
  party         String
  name          String
  email         String
  contactId     String?
  userId        String?
  /// PENDING | SIGNED | DECLINED
  status        String            @default("PENDING")
  signedAt      DateTime?
  declineReason String?
  /// What the provider reports of the signing certificate: subject, serial, issuer, validity.
  certificate   Json?
  ip            String?
  /// The sandbox provider's signing link secret, hashed; a real provider keeps its own.
  tokenHash     String?           @unique

  @@unique([envelopeId, order])
  @@map("signature_signers")
}

model SignatureEvent {
  id         String            @id @default(uuid())
  seq        Int               @default(autoincrement())
  envelopeId String
  envelope   SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  /// SENT | SIGNED | DECLINED | COMPLETED | VOIDED | EXPIRED | SYNC_FAILED | APPLIED
  kind       String
  detail     Json?
  at         DateTime          @default(now())

  @@index([envelopeId, seq])
  @@map("signature_events")
}

/// Roadmap #40 — a staff member's messenger chat, linked by a one-time code they sent the bot
/// themselves. Notifications that matter reach them there, and approvals can be decided there.
model MessengerLink {
  id             String   @id @default(uuid())
  organizationId String
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sandbox | bale | telegram
  provider       String
  chatId         String
  username       String?
  linkedAt       DateTime @default(now())

  @@unique([provider, chatId])
  @@map("messenger_links")
}

/// One thing a person may do from the messenger, behind an unguessable token: link their chat,
/// or decide one form approval. Single use, and it expires.
model MessengerAction {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// LINK | FORM_DECISION
  kind           String
  token          String    @unique
  /// For FORM_DECISION: { submissionId, decision, pairToken }
  payload        Json      @default("{}")
  /// OPEN | AWAITING_REASON | DONE | EXPIRED
  state          String    @default("OPEN")
  expiresAt      DateTime
  usedAt         DateTime?
  result         Json?
  /// The chat message the buttons are on, to update it with the outcome.
  chatId         String?
  messageId      String?
  createdAt      DateTime  @default(now())

  @@index([userId, state])
  @@map("messenger_actions")
}

/// Every message to and from the bot: the outbox that retries, and the record of what was said.
model MessengerMessage {
  id                String    @id @default(uuid())
  organizationId    String
  userId            String?
  provider          String
  chatId            String
  /// OUT | IN
  direction         String
  text              String
  /// [[{ text, action? , url? }]] — rows of buttons
  buttons           Json?
  /// QUEUED | SENT | FAILED | RECEIVED
  status            String
  providerMessageId String?
  attempts          Int       @default(0)
  error             String?
  notificationKind  String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([provider, chatId, createdAt])
  @@map("messenger_messages")
}

/// Roadmap #38 — feedback placed on the file itself: a pin on an image, a moment in a video, a
/// region of a PDF page. Positions are fractions of the rendered size, so they hold at any zoom.
/// A QC review that fails carries its open annotations into the revision's required correction.
model Annotation {
  id             String     @id @default(uuid())
  organizationId String
  deliverableId  String
  deliverable    Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The SHA-256 of the file as it was annotated — a newer upload is a new version, not this one.
  documentSha256 String
  /// PIN (image) | TIMECODE (video) | HIGHLIGHT (PDF)
  kind           String
  /// Ordinal on its file: the number drawn on the pin.
  number         Int
  page           Int?
  x              Float?
  y              Float?
  w              Float?
  h              Float?
  timeSec        Float?
  note           String
  /// OPEN | RESOLVED
  status         String     @default("OPEN")
  authorId       String
  author         User       @relation("AnnotationAuthor", fields: [authorId], references: [id])
  createdAt      DateTime   @default(now())
  qcReviewId     String?
  qcReview       QcReview?  @relation(fields: [qcReviewId], references: [id], onDelete: SetNull)
  revisionId     String?
  revision       Revision?  @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolvedById   String?

  @@unique([documentId, number])
  @@index([deliverableId, status])
  @@map("annotations")
}

/// Roadmap #42 — a client's brand, as the organisation holds it: the palette and the typefaces
/// (the logo files and identity guide are Documents on the company with a brandRole).
model BrandKit {
  id             String   @id @default(uuid())
  organizationId String
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// [{ name, hex, role: PRIMARY | SECONDARY | ACCENT | NEUTRAL }]
  colors         Json     @default("[]")
  /// [{ family, usage }]
  fonts          Json     @default("[]")
  notes          String?
  updatedById    String
  updatedAt      DateTime @updatedAt

  @@map("brand_kits")
}

/// An organisation's own rule on a transition (roadmap #47): a guard the move must satisfy, or a
/// notice sent when it happens. Never edited in place — a change is a new version under the same
/// code, and the version it replaces is retired — so a transition can name the rule it met.
model CustomRule {
  id             String    @id @default(uuid())
  organizationId String
  /// Stable across versions: RUL-000001. Waivers and the audit trail name it as `custom:<code>`.
  code           String
  version        Int
  /// GUARD | NOTIFY
  kind           String
  entity         String
  action         String
  labelFa        String
  messageFa      String?
  /// #17's condition language. A GUARD's must hold for the move; a NOTIFY's decides whether to tell.
  when           Json?
  notifyRoles    String[]  @default([])
  createdById    String
  createdAt      DateTime  @default(now())
  retiredAt      DateTime?
  retiredById    String?
  supersededById String?

  @@unique([organizationId, code, version])
  @@index([organizationId, entity, action])
  @@map("custom_rules")
}

/// A one-time link that lets a person set their first password (roadmap #48). Staff imported in
/// bulk never have a password in a file: they get this, by email when mail is on, or shown once
/// to the administrator to pass on. Only the SHA-256 of the token is kept.
model AccountActivation {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("account_activations")
}

/// A browser that asked to be told (roadmap #49): Web Push to the phone, for the three loops whose
/// deadlines are hours. The endpoint is the push service's address for this one browser; p256dh and
/// auth are the browser's keys, which each payload is encrypted to — the service carries it unread.
model PushSubscription {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String    @unique
  p256dh         String
  auth           String
  /// What the browser said it was, for the person to tell their devices apart.
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastSuccessAt  DateTime?
  /// Failures in a row; a delivery resets it.
  failures       Int       @default(0)
  disabledAt     DateTime?
  /// GONE (the service forgot it) | REJECTED (the service refused our key) | FAILING (failed too often)
  /// | NOT_ALLOWED (its service is no longer in PUSH_SERVICE_HOSTS)
  disabledReason String?

  messages PushMessage[]

  @@index([userId])
  @@map("push_subscriptions")
}

/// One notice to one browser: the outbox that retries, and the record of what the push service said.
model PushMessage {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  body           String?
  /// Where tapping the notice opens — always a path in this app.
  url            String
  tag            String?
  /// QUEUED | SENT | FAILED | GONE
  status         String           @default("QUEUED")
  attempts       Int              @default(0)
  statusCode     Int?
  error          String?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("push_messages")
}

/// Keys an installation makes for itself when none are configured: the VAPID pair that names this
/// server to push services (roadmap #49). Configured keys (VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY) win.
model ServerKey {
  name       String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("server_keys")
}

/// Who outside the system a lead can name as its source (Hivamis task 2): marketers, whom the system
/// admin keeps, and partner companies, which a seller may add as they name one.
model LeadReferrer {
  id             String    @id @default(uuid())
  organizationId String
  /// MARKETER | PARTNER
  kind           String
  name           String
  phone          String?
  note           String?
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  leads Lead[]

  @@unique([organizationId, kind, name])
  @@map("lead_referrers")
}

/// What an organisation's system administrator granted a role (Hivamis task 6). The newest row per
/// role is in force; earlier ones stay, superseded, as the record of who granted what and when. The
/// full-access roles never appear here: they hold everything, always.
model RoleGrant {
  id             String    @id @default(uuid())
  organizationId String
  roleCode       String
  permissions    String[]
  note           String?
  grantedById    String
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  @@index([organizationId, roleCode])
  @@map("role_grants")
}

/* ── Signing in and joining (Hivamis task 4) ─────────────────────────────── */

/// An account somewhere else that signs this person in — today, Google. `subject` is the provider's
/// permanent id for the person; the email is kept for display only and never used to sign in.
model UserIdentity {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  subject    String
  email      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// A one-time code sent by SMS: to sign in, to sign up, or to prove a mobile is one's own. Only an
/// HMAC of the code is kept; five wrong tries spend it.
model OtpCode {
  id         String    @id @default(uuid())
  purpose    String
  phone      String
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

/// What was sent by SMS. Outside the sandbox the code itself is never stored.
model SmsMessage {
  id        String   @id @default(uuid())
  phone     String
  text      String
  provider  String
  status    String
  error     String?
  /// Audit SEC-6: what the code was for, and whose account it opens. The outbox shows a sandboxed code
  /// only when it opens no account (asking to join) or is the reader's own.
  purpose   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sms_outbox")
}

/// A Google sign-in in progress: the state the browser carries out and back, with the PKCE verifier
/// and nonce that tie the answer to this request. Ten minutes, one use.
model OAuthState {
  id           String    @id @default(uuid())
  stateHash    String    @unique
  provider     String
  mode         String
  codeVerifier String
  nonce        String
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Roadmap #50: the organisation an «ask to join with Google» began in — the callback returns to
  /// the installation's one address, which names no organisation.
  organizationId String?
  /// Audit SEC-5: the hash of a nonce kept in a cookie of the browser that began the flow. The callback
  /// is honoured only in that browser, so nobody can hand another person the end of their own sign-in.
  bindingHash  String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("oauth_states")
}

/// Audit SEC-5: a Google account whose verified address is a person's work address. It is not linked —
/// and signs nobody in — until that person proves the account is theirs once, by password or a code to
/// their mobile. Ten minutes, one use, five tries.
model IdentityLinkOffer {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  subject    String
  email      String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("identity_link_offers")
}

/// The hand-off from a provider's redirect to the app: a single-use ticket, a minute long, that the
/// page trades for its session — so no token ever travels in a URL.
model LoginTicket {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("login_tickets")
}

/// Someone asking to join the organisation, with a mobile or a Google account they proved is theirs.
/// Nothing is granted until the system administrator approves — and then they choose the unit and roles.
model SignupRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  method         String
  fullName       String
  email          String
  phone          String?
  googleSubject  String?
  departmentCode String?
  note           String?
  status         String       @default("PENDING")
  decidedById    String?
  decidedBy      User?        @relation("SignupDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  userId         String?
  user           User?        @relation("SignupAccount", fields: [userId], references: [id], onDelete: SetNull)
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status, createdAt])
  @@map("signup_requests")
}

/* ── The local assistant (Hivamis task 5) ────────────────────────────────── */

/// A person's conversation with the assistant — theirs alone; nobody else, administrators included,
/// reads it. What each turn did (model, tools, timing) goes to ai_interactions for the AI log.
model AiConversation {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// One message: what the person asked, what the assistant answered, or what a tool returned to it.
model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolName       String?
  toolArgs       Json?
  /// What the answer offers to do next — open a form ready to fill, open a page — for the person to click.
  actions        Json           @default("[]")
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// A recorded video for one section of the guide (Hivamis task 8), in one language — the
/// organisation's own screen recording, uploaded by the system administrator. One per section and
/// language: a new upload replaces the old one.
model GuideVideo {
  id             String   @id @default(uuid())
  organizationId String
  sectionId      String
  locale         String
  title          String
  storedName     String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  uploadedBy     User     @relation("GuideVideoUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([organizationId, sectionId, locale])
  @@map("guide_videos")
}

/// Roadmap #50: each time the reference data — roles, units, SLA policies, the form catalogue — was
/// brought up to the running version: on start-up after an upgrade, or by hand.
model SystemUpgrade {
  id         String    @id @default(uuid())
  appVersion String
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json      @default("{}")

  @@index([startedAt])
  @@map("system_upgrades")
}

/// Audit SEC-10: a wrong password or code, kept against what was typed and the network it came from —
/// not against the account. Throttle state, not evidence: the audit trail keeps LOGIN_FAILED, and a
/// success clears its pair.
model SignInFailure {
  id         String   @id @default(uuid())
  /// The email or mobile as typed (normalised), prefixed `portal:` for the client portal.
  identifier String
  /// The client's /24 (IPv4) or /64 (IPv6).
  network    String
  createdAt  DateTime @default(now())

  @@index([identifier, network, createdAt])
  @@index([createdAt])
  @@map("sign_in_failures")
}
