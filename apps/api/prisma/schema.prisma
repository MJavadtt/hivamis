/**
 * ═══════════════════════ Form engine ═══════════════════════
 */

model FormDefinition {
  id             String    @id @default(uuid())
  organizationId String
  no             Int
  code           String
  nameFa         String
  nameEn         String
  category       String
  module         String
  senderDepts    String[]  @default([])
  receiverDepts  String[]  @default([])
  approverRoles  String[]  @default([])
  slaCode        String?
  binding        String?
  nextProcessFa  String?
  schema         Json
  /// Conditional approval rules evaluated against the submitted values (roadmap #17).
  routing        Json      @default("[]")
  /// Ordered approval stages with optional quorum (roadmap #18); empty means a single stage.
  approvalChain  Json      @default("[]")
  /// When this organisation last edited the form in the designer (roadmap #15). Set means the
  /// seed must not push the catalogue's schema over it again.
  customizedAt   DateTime?
  customizedById String?
  /// A form this organisation added for itself: outside the Doc_H catalogue, never re-seeded.
  isCustom       Boolean   @default(false)
  isActive       Boolean   @default(true)
  /// Bumped whenever `schema` changes; each value has a FormDefinitionVersion row behind it.
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submissions FormSubmission[]
  versions    FormDefinitionVersion[]

  /// Roadmap #50: a code names a form within its organisation; another organisation has its own.
  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([module])
  @@map("form_definitions")
}

/// A definition's schema as it stood at one version. Submissions pin a version, so a form can
/// change without rewriting what people already filled in — or what an archived PDF shows.
model FormDefinitionVersion {
  id            String         @id @default(uuid())
  definitionId  String
  definition    FormDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version       Int
  schema        Json
  /// The routing rules in force at this version — a submission is judged by its own version.
  routing       Json           @default("[]")
  /// The approval chain in force at this version.
  approvalChain Json           @default("[]")
  nameFa        String
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())

  @@unique([definitionId, version])
  @@map("form_definition_versions")
}

model FormSubmission {
  id                String         @id @default(uuid())
  organizationId    String
  code              String         @unique
  definitionId      String
  definition        FormDefinition @relation(fields: [definitionId], references: [id])
  /// The definition version this was filled in under. Rendering and validation use it, not
  /// whatever the definition says today.
  definitionVersion Int            @default(1)
  data              Json
  state             String         @default("DRAFT")
  submittedById     String
  submittedBy       User           @relation("FormSubmitter", fields: [submittedById], references: [id])
  assignedToId      String?
  assignedTo        User?          @relation("FormAssignee", fields: [assignedToId], references: [id])
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// A key the client generated before the form left the device (roadmap #19). A submission
  /// queued offline and retried over a flaky link must file once, not once per attempt.
  clientKey         String?
  /// Who must approve this submission: the form's own roles plus whatever its routing rules
  /// added for these values (roadmap #17). Empty on rows written before routing existed.
  requiredRoles     String[]       @default([])
  /// The rules that fired, with the sentence each was written in — why those roles are there.
  routing           Json?
  /// The approval stages this submission must pass, and how far it has got (roadmap #18).
  stages            Json?
  /// Index of the stage awaiting a decision; equals stages.length once every stage has cleared.
  currentStage      Int            @default(0)
  /// Roles that may decide *right now* — the waiting stage's roles. Kept as a column so an
  /// approval inbox is one query, and empty once the form is decided.
  currentRoles      String[]       @default([])
  /// The domain record this submission created or drove, when the form has a typed binding.
  boundEntity       String?
  boundEntityId     String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  returnReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  approvals FormApproval[]
  documents Document[]

  @@unique([organizationId, clientKey])
  @@index([organizationId, state])
  @@index([definitionId, state])
  @@index([assignedToId, state])
  @@index([projectId])
  @@map("form_submissions")
}

model FormApproval {
  id           String         @id @default(uuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approverId   String
  approver     User           @relation(fields: [approverId], references: [id])
  /// The stage this decision was recorded against (roadmap #18); null on pre-chain rows.
  stage        String?
  decision     String
  comment      String?
  decidedAt    DateTime       @default(now())

  @@index([submissionId])
  @@map("form_approvals")
}

/**
 * ═══════════════════════ SLA engine ═══════════════════════
 */

model SlaPolicy {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  labelFa        String
  labelEn        String
  hours          Decimal   @db.Decimal(8, 2)
  warnAt         Decimal   @default(0.75) @db.Decimal(4, 3)
  docRef         String?
  isActive       Boolean   @default(true)
  /// Roadmap #50: the organisation set its own hours; the catalogue no longer moves them on upgrade.
  customizedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clocks SlaClock[]

  @@unique([organizationId, code])
  @@map("sla_policies")
}

model SlaClock {
  id              String     @id @default(uuid())
  organizationId  String
  policyId        String
  policy          SlaPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  startedAt       DateTime   @default(now())
  dueAt           DateTime
  stoppedAt       DateTime?
  pausedAt        DateTime?
  /// Wall-clock seconds spent paused, for people.
  pausedSeconds   Int        @default(0)
  /// Working hours spent paused, for the arithmetic: consumed = elapsed − pausedHours.
  pausedHours     Decimal    @default(0) @db.Decimal(8, 2)
  state           String     @default("RUNNING")
  warnedAt        DateTime?
  /// When the owner was told this clock was *predicted* to breach — once per clock (roadmap #8).
  riskNotifiedAt  DateTime?
  /// The probability that prompted that message, kept so the prediction can be judged afterwards.
  riskProbability Decimal?   @db.Decimal(4, 3)
  breachedAt      DateTime?
  ownerId         String?
  pauses          SlaPause[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([organizationId, state])
  @@index([entityType, entityId])
  @@index([state, dueAt])
  @@map("sla_clocks")
}

/// One pause of one clock: who, why, and for how long. The clock carries the running totals;
/// this is the record behind them, so "why was this late" has an answer with names on it.
model SlaPause {
  id             String    @id @default(uuid())
  organizationId String
  clockId        String
  clock          SlaClock  @relation(fields: [clockId], references: [id], onDelete: Cascade)
  kind           String
  reason         String
  pausedAt       DateTime  @default(now())
  resumedAt      DateTime?
  /// Working hours between pausedAt and resumedAt, fixed at resume.
  businessHours  Decimal?  @db.Decimal(8, 2)
  pausedById     String?
  resumedById    String?
  createdAt      DateTime  @default(now())

  @@index([clockId])
  @@index([organizationId, kind])
  @@map("sla_pauses")
}

/**
 * ═══════════════════════ Documents ═══════════════════════
 */

model Document {
  id                 String            @id @default(uuid())
  organizationId     String
  fileName           String
  storedName         String            @unique
  mimeType           String
  /// A double holds any whole number of bytes up to 8 PiB, and stays a plain number in JSON (ADR-124).
  sizeBytes          Float
  checksum           String?
  version            Int               @default(1)
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId         String?
  contract           Contract?         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliverableId      String?
  deliverable        Deliverable?      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  submissionId       String?
  submission         FormSubmission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// Roadmap #35: a file presented with a proposal — the deck the client is asked to approve.
  proposalId         String?
  proposal           Proposal?         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// Evidence of a QC review (roadmap #49): a photo from the set is the review's, not the deliverable's.
  qcReviewId         String?
  qcReview           QcReview?         @relation(fields: [qcReviewId], references: [id], onDelete: Cascade)
  /// Audit F-5: a file shared in a conversation — its members' alone, served only by the chat's own
  /// route; the message it went with, once sent.
  chatConversationId String?
  chatConversation   ChatConversation? @relation(fields: [chatConversationId], references: [id], onDelete: Cascade)
  chatMessageId      String?
  chatMessage        ChatMessage?      @relation("ChatAttachments", fields: [chatMessageId], references: [id], onDelete: SetNull)
  /// Audit F-6: the person whose photo this is — not a file of the organisation's records.
  avatarOf           User?             @relation("UserAvatar")
  /// ADR-103: a venue's photo, or a deployment project's file — read only with venue.read or site.read.
  /// `siteRecordType`/`siteRecordId` name what in the project it is evidence of: a contract version, an
  /// approval, an installation, a payment, a deposit deduction. `category` is a photo's kind (entrance,
  /// inside…) or the evidence's; `caption` and `takenAt` are what the uploader said of it.
  venueId            String?
  venue              Venue?            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  siteProjectId      String?
  siteProject        SiteProject?      @relation(fields: [siteProjectId], references: [id], onDelete: Cascade)
  siteRecordType     String?
  siteRecordId       String?
  /// A file on any other record (ADR-121): FILE_RECORD_TYPES names the kind; read as that record is.
  recordType         String?
  recordId           String?
  category           String?
  caption            String?
  takenAt            DateTime?
  /// Roadmap #34: shown to the client in the portal. Off unless someone in Account turns it on.
  clientVisible      Boolean           @default(false)
  /// Roadmap #42: the family of versions this file belongs to — the first version's id — and, once
  /// a newer version is uploaded, when and by which file it was superseded. `version` counts within it.
  lineageId          String?
  supersededAt       DateTime?
  supersededById     String?
  /// What the file itself says: dimensions, colour space, duration, pages, font family.
  metadata           Json?
  /// On a client's brand library: LOGO | FONT | GUIDELINE | IMAGE | OTHER.
  brandRole          String?
  tags               String[]          @default([])
  uploadedById       String
  uploadedBy         User              @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime          @default(now())
  deletedAt          DateTime?
  /// Audit LOG-5: kept as it is, deleted or not, until the hold is lifted — a dispute, an inquiry.
  legalHold          Boolean           @default(false)
  legalHoldReason    String?
  /// Audit LOG-5: when the file itself was removed, FILE_RETENTION_DAYS after the document was deleted.
  /// The row stays: what was here, who put it, and when it went.
  purgedAt           DateTime?

  annotations     Annotation[]
  envelopesSent   SignatureEnvelope[] @relation("EnvelopeOriginal")
  envelopesSigned SignatureEnvelope[] @relation("EnvelopeSigned")

  @@index([organizationId])
  @@index([projectId])
  @@index([lineageId])
  @@index([qcReviewId])
  @@index([chatConversationId])
  @@index([venueId])
  @@index([siteProjectId, siteRecordType, siteRecordId])
  @@index([organizationId, recordType, recordId])
  @@map("documents")
}

model Comment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  body       String
  mentions   String[] @default([])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@map("comments")
}

/**
 * ═══════════════════════ Audit, workflow log, notifications, AI ═══════════════════════
 */

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  action         String
  entityType     String
  entityId       String?
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id])
  /// Set when the actor held the permission only through a delegation: "A, as B's delegate".
  onBehalfOfId   String?
  /// The system administrator who did this in the actor's account (owner's report, 2026-10-23): the
  /// actor is whose account it was, this is who was at the keyboard.
  impersonatorId String?
  impersonator   User?    @relation("AuditImpersonator", fields: [impersonatorId], references: [id])
  /// Roadmap #46: the API key the request came through — the actor is the key's creator.
  apiKeyId       String?
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([impersonatorId])
  @@map("audit_events")
}

model StateTransition {
  id                   String   @id @default(uuid())
  organizationId       String
  entityType           String
  entityId             String
  fromState            String
  toState              String
  action               String
  reason               String?
  /// Written by a cascade from another record's move, not by someone acting on this one.
  cascade              Boolean  @default(false)
  /// The state a record had when it came over from a previous system (roadmap #48) — recorded,
  /// not moved: no guard ran, and mining, the rule lab and webhooks leave it out.
  opening              Boolean  @default(false)
  /// See AuditEvent.onBehalfOfId.
  onBehalfOfId         String?
  /// The rule-set versions in force when this happened (RuleSetVersion ids).
  rulesVersionId       String?
  permissionsVersionId String?
  actorId              String
  actor                User     @relation(fields: [actorId], references: [id])
  createdAt            DateTime @default(now())
  /// Audit LOG-1: the id of the transaction that wrote it, set by the database. A reader that stops
  /// below the oldest transaction still running sees every row there will ever be up to that point —
  /// which createdAt, the transaction's start time, cannot promise. 0 for rows from before.
  txid                 BigInt   @default(dbgenerated("((pg_current_xact_id())::text)::bigint"))

  @@index([entityType, entityId, createdAt])
  @@index([organizationId, txid, id])
  @@map("state_transitions")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  severity   String    @default("INFO")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Doc_H-derived AI governance: every AI call is recorded with its actor, scope and grounding.
/// Something in the audit trail that does not look like its usual self (roadmap #26). The trail
/// was always complete and inspectable; nobody inspects it until after the fact. An alert is
/// the same data, raised while it can still matter — and it only ever informs a person: it never
/// locks an account, because a false positive on someone's record has a human cost.
model SecurityAlert {
  id             String    @id @default(uuid())
  organizationId String
  /// OFF_HOURS_EXPORT | DOWNLOAD_SURGE | OUT_OF_SCOPE_ACCESS | DENIAL_SURGE | LOGIN_FAILURES | TOKEN_REUSE
  kind           String
  /// INFO | MEDIUM | HIGH | CRITICAL
  severity       String
  actorId        String?
  ipAddress      String?
  windowStart    DateTime
  windowEnd      DateTime
  /// Counts, the person's own baseline, and the event ids behind them — the case, not a verdict.
  evidence       Json
  messageFa      String
  /// One alert per kind, subject and window: a rescan updates it instead of raising it again.
  fingerprint    String
  /// OPEN | ACKNOWLEDGED | DISMISSED
  status         String    @default("OPEN")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, createdAt])
  @@map("security_alerts")
}

/// A past lesson, weighed against a new project (roadmap #44). Doc_H makes lessons mandatory
/// at closure and puts them on the closing checklist, but a lesson nobody reads is a ritual.
/// Surfacing them at kick-off is half the answer; recording what the team *did* with each one
/// is the other half, and it is what turns "we archive" into "we learn".
model LessonReview {
  id             String        @id @default(uuid())
  organizationId String
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         LessonLearned @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// APPLIED — it changed how this project is being run; NOT_RELEVANT — considered and set aside.
  decision       String
  note           String?
  reviewedById   String
  createdAt      DateTime      @default(now())

  @@unique([projectId, lessonId])
  @@index([organizationId, projectId])
  @@map("lesson_reviews")
}

/// One indexed piece of organisational memory (roadmap #21): a brief, a proposal, a set of
/// meeting minutes, a lesson learned, a piece of client feedback — reduced to the text worth
/// remembering and the vector that text embeds to.
///
/// The vector is a plain float array rather than a pgvector column so the feature needs no
/// extension to work (ADR-006 — one datastore, and no new one). Where pgvector *is* installed,
/// an ANN index is a drop-in addition; the arithmetic below does not change.
model MemoryDocument {
  id              String   @id @default(uuid())
  organizationId  String
  /// brief | proposal | meeting | lessonLearned | feedback | statusReport | caseStudy
  entityType      String
  entityId        String
  /// The project this memory belongs to, when it has one — for filtering and for #44.
  projectId       String?
  companyId       String?
  titleFa         String
  /// The text that was embedded, kept so a result can show why it matched.
  body            String
  /// Normalised, lower-cased text used for the lexical half of the search.
  searchText      String
  vector          Float[]
  dims            Int
  /// Which embedder produced the vector — results say so rather than implying one quality.
  model           String
  /// updatedAt of the source record when this was indexed; a later one means it is stale.
  sourceUpdatedAt DateTime
  indexedAt       DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([organizationId, entityType])
  @@index([organizationId, projectId])
  @@map("memory_documents")
}

model AiInteraction {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  capability     String
  entityType     String?
  entityId       String?
  model          String
  promptSummary  String
  responseText   String?
  groundingRefs  Json     @default("[]")
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  succeeded      Boolean  @default(true)
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("ai_interactions")
}

model Counter {
  id    String @id @default(uuid())
  scope String @unique
  value Int    @default(0)

  @@map("counters")
}

/// An exchange rate (roadmap #28): base-currency units for one unit of `currency`, in force from
/// `effectiveDate` until the next one. Records keep the rate they were converted at, so correcting
/// a rate here never moves a figure already booked.
model ExchangeRate {
  id             String   @id @default(uuid())
  organizationId String
  currency       String
  rate           Decimal  @db.Decimal(24, 6)
  effectiveDate  DateTime @db.Date
  /// MANUAL | IMPORT
  source         String   @default("MANUAL")
  note           String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, currency, effectiveDate])
  @@map("exchange_rates")
}

/// A project's recognised revenue as frozen when its period was closed (roadmap #29). The open
/// period is computed live; a closed one never changes — a late correction lands in the next
/// open period as a catch-up, the way a closed month is treated in any set of books.
model RevenueEntry {
  id               String   @id @default(uuid())
  organizationId   String
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Jalali month, «1405-07».
  period           String
  periodEnd        DateTime
  method           String
  /// Share of the work done by the period's end, 0..1.
  progress         Decimal  @db.Decimal(7, 6)
  /// Contract value in force at the period's end (base currency).
  contractValue    Decimal  @db.Decimal(20, 2)
  recognisedToDate Decimal  @db.Decimal(20, 2)
  /// Recognised in this period: to date, less what earlier periods froze.
  amount           Decimal  @db.Decimal(20, 2)
  invoicedToDate   Decimal  @db.Decimal(20, 2)
  /// The figures the progress was computed from, so a closed month can be explained later.
  basis            Json
  createdAt        DateTime @default(now())

  @@unique([projectId, period])
  @@index([organizationId, period])
  @@map("revenue_entries")
}

/// A closed accounting month (roadmap #29). Closed in order; never reopened.
model RevenuePeriod {
  id             String   @id @default(uuid())
  organizationId String
  period         String
  periodStart    DateTime
  periodEnd      DateTime
  closedAt       DateTime @default(now())
  closedById     String
  /// Recognised, invoiced, labour and external cost for the month, as they stood at closing.
  totals         Json

  @@unique([organizationId, period])
  @@map("revenue_periods")
}

/**
 * Media bought on a client's behalf (roadmap #31). The vendor's net is a pass-through — billed to
 * the client and paid to the vendor, never the agency's revenue; the agency's revenue is the
 * commission (COMMISSION) or the markup (MARKUP). All four figures are computed when the order is
 * written and kept in base; an order in another currency keeps its originals and rate (#28).
 */
model MediaOrder {
  id                   String    @id @default(uuid())
  organizationId       String
  code                 String    @unique
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id])
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id])
  workOrderId          String?
  /// TV | RADIO | OUTDOOR | PRINT | DIGITAL | CINEMA | OTHER
  channel              String
  placement            String
  flightStart          DateTime
  flightEnd            DateTime
  /// COMMISSION | MARKUP
  pricingModel         String
  commissionPercent    Decimal   @db.Decimal(5, 2)
  /// The vendor's price as quoted: gross (COMMISSION) or net (MARKUP), in `currency`.
  quotedAmount         Decimal   @db.Decimal(20, 2)
  /// Base: what the client is billed for the media, what the vendor is owed, and the difference.
  clientAmount         Decimal   @db.Decimal(20, 2)
  netAmount            Decimal   @db.Decimal(20, 2)
  agencyRevenue        Decimal   @db.Decimal(20, 2)
  currency             String    @default("IRR")
  fxRate               Decimal   @default(1) @db.Decimal(24, 6)
  fxRateDate           DateTime?
  originalClientAmount Decimal?  @db.Decimal(20, 2)
  originalNetAmount    Decimal?  @db.Decimal(20, 2)
  /// The vendor's invoice, in `currency` — reconciled against the booked net.
  vendorInvoiceNumber  String?
  vendorInvoiceAmount  Decimal?  @db.Decimal(20, 2)
  vendorInvoiceDate    DateTime?
  discrepancyNote      String?
  proofNote            String?
  /// The intermediary invoice the client was billed on.
  clientInvoiceId      String?
  clientInvoice        Invoice?  @relation(fields: [clientInvoiceId], references: [id], onDelete: SetNull)
  state                String    @default("DRAFT")
  bookedAt             DateTime?
  airedAt              DateTime?
  reconciledAt         DateTime?
  cancelReason         String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments Payment[]

  @@index([organizationId, state])
  @@index([projectId])
  @@map("media_orders")
}

/**
 * A key for a system rather than a person (roadmap #46). It acts with its creator's authority,
 * narrowed to `permissions` and never wider than the creator's own at the time of each request;
 * only a hash of the secret is kept. Revoked, expired, or whose creator is gone: it stops.
 */
model ApiKey {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  /// The public part printed on the key («hiva_<prefix>_…»); how a request finds its key.
  prefix             String    @unique
  /// SHA-256 of the whole key. The secret is shown once, at creation, and never again.
  secretHash         String
  permissions        String[]
  rateLimitPerMinute Int       @default(60)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  lastUsedIp         String?
  revokedAt          DateTime?
  revokedById        String?
  revokeReason       String?
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId])
  @@map("api_keys")
}

/**
 * A webhook (roadmap #46): state transitions the creator may read, sent to `url`, signed with
 * `secret`. The transition log is the outbox; `cursorAt`/`cursorId` is how far it has been read.
 */
model WebhookSubscription {
  id                  String            @id @default(uuid())
  organizationId      String
  name                String
  url                 String
  /// Signs every delivery (HMAC-SHA256). Shown once, at creation.
  secret              String
  /// «entity.action», «entity.*» or «*».
  events              String[]
  active              Boolean           @default(true)
  /// Nothing that happened before this is sent: when the subscription was made, or last reactivated.
  cursorAt            DateTime          @default(now())
  /// Audit LOG-1: where the dispatcher has read to in the transition log, by (txid, id). Starts at the
  /// oldest transaction running when the subscription was made.
  cursorTxid          BigInt            @default(dbgenerated("((pg_snapshot_xmin(pg_current_snapshot()))::text)::bigint"))
  cursorId            String?
  consecutiveFailures Int               @default(0)
  disabledAt          DateTime?
  disabledReason      String?
  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveries          WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_subscriptions")
}

/**
 * One event to one subscriber, retried with backoff until it lands or is given up on.
 */
model WebhookDelivery {
  id             String              @id @default(uuid())
  organizationId String
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// The state transition it reports; null for a test ping.
  transitionId   String?
  event          String
  payload        Json
  /// PENDING | DELIVERED | DEAD
  status         String              @default("PENDING")
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@unique([subscriptionId, transitionId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/**
 * The organisation as a taxpayer in سامانهٔ مؤدیان (roadmap #32): its fiscal memory, its own
 * identifiers, and the default service and unit codes its invoice lines are reported under.
 */
model TaxProfile {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  /// «شناسهٔ یکتای حافظهٔ مالیاتی» — six characters; the first part of every tax number.
  memoryId           String
  /// The seller's taxpayer number (tins): the national ID of a legal entity.
  sellerTaxId        String
  economicCode       String?
  postalCode         String?
  /// Branch code (sbc), when invoices are issued by a registered branch.
  branchCode         String?
  /// The 13-digit service/goods code (sstid) lines are reported under unless they carry their own.
  defaultServiceCode String
  /// The measurement-unit code (mu) for a line of service.
  defaultUnitCode    String
  updatedById        String
  updatedAt          DateTime @updatedAt

  @@map("tax_profiles")
}

/**
 * One report of an invoice to سامانهٔ مؤدیان (roadmap #32): the original, a correction, or a
 * cancellation — each with its own 22-character tax number, the payload exactly as sent, and what
 * the tax authority said. A correction or cancellation names the tax number it replaces.
 */
model TaxSubmission {
  id              String    @id @default(uuid())
  organizationId  String
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  /// ORIGINAL | CORRECTION | CANCELLATION  (ins 1 | 2 | 3)
  subject         String
  serial          Int
  taxId           String    @unique
  /// The accepted tax number a correction or cancellation refers to (irtaxid).
  referenceTaxId  String?
  payload         Json
  /// QUEUED | SENT | ACCEPTED | REJECTED | FAILED
  status          String    @default("QUEUED")
  referenceNumber String?
  /// What the authority (or the transport) said, in its own words.
  errors          Json?
  attempts        Int       @default(0)
  /// sandbox | live — where it was sent; null while queued.
  channel         String?
  submittedAt     DateTime?
  respondedAt     DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("tax_submissions")
}

/**
 * How this organisation's books name things (roadmap #33): the ledger account for each kind of
 * posting, the detail (تفصیلی) code of each client, and the columns its accounting package imports.
 */
model AccountingSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique
  /// { receivable, revenue, vat, mediaClearing, bank, cash, clientAdvance, projectCost, fxGain, fxLoss } → account code
  accounts       Json
  /// companyId → detail code
  clientCodes    Json     @default("{}")
  /// { columns: [{ field, header }], dateFormat: JALALI | GREGORIAN }
  layout         Json
  updatedById    String
  updatedAt      DateTime @updatedAt

  @@map("accounting_settings")
}

/**
 * One batch of vouchers handed to the accounting package (roadmap #33). The file is kept exactly as
 * produced, so it can be downloaded again; what it posted is marked, so it is never posted twice.
 */
model AccountingExport {
  id               String    @id @default(uuid())
  organizationId   String
  number           Int
  periodTo         DateTime
  vouchers         Int
  lines            Int
  debitTotal       Decimal   @db.Decimal(20, 2)
  creditTotal      Decimal   @db.Decimal(20, 2)
  fileName         String
  content          String
  createdById      String
  createdAt        DateTime  @default(now())
  postedInvoices   Invoice[] @relation("InvoicePosted")
  reversedInvoices Invoice[] @relation("InvoiceReversed")
  postedPayments   Payment[]

  @@unique([organizationId, number])
  @@map("accounting_exports")
}

/// Roadmap #35 — a client's approval, kept as evidence: who (the contact the link was sent to,
/// and the code their mailbox received), when, from where, and the SHA-256 of exactly what they
/// were shown. The decision is sealed into a per-organisation hash chain; a sealed row is not
/// changed afterwards (a trigger refuses it).
model ClientApproval {
  id             String   @id @default(uuid())
  organizationId String
  code           String   @unique
  /// DELIVERABLE | PROPOSAL
  subjectType    String
  subjectId      String
  /// The state the subject must still be in for the decision to apply.
  subjectState   String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName    String
  contactEmail   String
  message        String?
  /// What the client is shown, frozen when the request is made: the subject, its client-facing
  /// content, and each file with its size and SHA-256.
  manifest       Json
  manifestHash   String
  /// SHA-256 of the link's secret; the secret itself is never stored.
  tokenHash      String   @unique
  /// EMAIL — the link went to the contact's address; MANUAL — it was handed to staff to pass on.
  channel        String
  /// PENDING | APPROVED | CHANGES_REQUESTED | CANCELLED | EXPIRED
  status         String   @default("PENDING")
  expiresAt      DateTime
  requestedById  String
  requestedBy    User     @relation(fields: [requestedById], references: [id])
  createdAt      DateTime @default(now())

  codeHash      String?
  codeExpiresAt DateTime?
  codeAttempts  Int       @default(0)
  codesSent     Int       @default(0)

  /// APPROVE | REQUEST_CHANGES
  decision         String?
  comment          String?
  signerName       String?
  /// EMAIL_CODE — a one-time code sent to the contact's address at decision time; LINK — the link alone.
  verification     String?
  decidedAt        DateTime?
  decidedIp        String?
  decidedUserAgent String?
  sequence         Int?
  prevEvidenceHash String?
  /// Exactly what was hashed, so the hash can be recomputed.
  evidence         Json?
  evidenceHash     String?   @unique
  /// Set when the decision could not be applied to the subject — the evidence stands regardless.
  transitionError  String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?

  events ClientApprovalEvent[]

  @@unique([organizationId, sequence])
  @@index([subjectType, subjectId])
  @@index([organizationId, status])
  @@map("client_approvals")
}

/// Everything that happened to a request, as the client's side saw it — opened, each file
/// downloaded, a code sent, the decision — with address and browser.
model ClientApprovalEvent {
  id         String         @id @default(uuid())
  /// Order of writing — two events in one millisecond still have one order.
  seq        Int            @default(autoincrement())
  approvalId String
  approval   ClientApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  /// CREATED | SENT | OPENED | FILE_VIEWED | FILE_MISMATCH | CODE_SENT | CODE_REJECTED | DECIDED | CANCELLED | EXPIRED
  kind       String
  documentId String?
  ip         String?
  userAgent  String?
  at         DateTime       @default(now())

  @@index([approvalId, at])
  @@map("client_approval_events")
}

/// Roadmap #34 — a client contact's own sign-in to the portal. Not a staff user: no roles, no
/// permissions, its own tokens; it sees its company's projects and nothing else.
model PortalUser {
  id              String    @id @default(uuid())
  organizationId  String
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId       String    @unique
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email           String    @unique
  /// INVITED | ACTIVE | DISABLED
  status          String    @default("INVITED")
  passwordHash    String?
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String
  invitedBy       User      @relation(fields: [invitedById], references: [id])
  lockedUntil     DateTime?
  /// Raised to end every session at once — on disabling, or a new password.
  tokenVersion    Int       @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages PortalMessage[]

  @@index([companyId])
  @@map("portal_users")
}

/// A message on a project between the client (in the portal) and Account (in the app).
model PortalMessage {
  id             String      @id @default(uuid())
  organizationId String
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portalUserId   String?
  portalUser     PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  body           String
  createdAt      DateTime    @default(now())

  @@index([projectId, createdAt])
  @@map("portal_messages")
}

/// Roadmap #36 — a contract sent for electronic signature through a provider: the exact PDF sent
/// (its SHA-256), who signs and in what order, what the provider reported, and the signed PDF it
/// returned. When every signer has signed, the contract is signed through the workflow engine.
model SignatureEnvelope {
  id               String    @id @default(uuid())
  organizationId   String
  code             String    @unique
  contractId       String
  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// sandbox | http
  provider         String
  providerRef      String?
  /// SENT | COMPLETED | DECLINED | VOIDED | EXPIRED
  status           String    @default("SENT")
  documentId       String
  document         Document  @relation("EnvelopeOriginal", fields: [documentId], references: [id])
  originalSha256   String
  signedDocumentId String?
  signedDocument   Document? @relation("EnvelopeSigned", fields: [signedDocumentId], references: [id])
  signedSha256     String?
  expiresAt        DateTime
  createdById      String
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  voidedAt         DateTime?
  voidReason       String?
  /// Set when the completed signature could not be applied to the contract.
  transitionError  String?

  signers SignatureSigner[]
  events  SignatureEvent[]

  @@index([contractId])
  @@index([status])
  @@map("signature_envelopes")
}

model SignatureSigner {
  id            String            @id @default(uuid())
  envelopeId    String
  envelope      SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  order         Int
  /// CLIENT | AGENCY
  party         String
  name          String
  email         String
  contactId     String?
  userId        String?
  /// PENDING | SIGNED | DECLINED
  status        String            @default("PENDING")
  signedAt      DateTime?
  declineReason String?
  /// What the provider reports of the signing certificate: subject, serial, issuer, validity.
  certificate   Json?
  ip            String?
  /// The sandbox provider's signing link secret, hashed; a real provider keeps its own.
  tokenHash     String?           @unique

  @@unique([envelopeId, order])
  @@map("signature_signers")
}

model SignatureEvent {
  id         String            @id @default(uuid())
  seq        Int               @default(autoincrement())
  envelopeId String
  envelope   SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  /// SENT | SIGNED | DECLINED | COMPLETED | VOIDED | EXPIRED | SYNC_FAILED | APPLIED
  kind       String
  detail     Json?
  at         DateTime          @default(now())

  @@index([envelopeId, seq])
  @@map("signature_events")
}

/// Long polling's place in the bot's updates, and which process is reading them (audit F-9).
/// Telegram gives a bot's updates to one reader: a lease, renewed each poll, decides which.
model MessengerPollState {
  provider   String    @id
  holder     String?
  leaseUntil DateTime?
  nextOffset BigInt    @default(0)
  lastPollAt DateTime?
  lastError  String?
  updatedAt  DateTime  @default(now()) @updatedAt

  @@map("messenger_poll_state")
}

/// Roadmap #40 — a staff member's messenger chat, linked by a one-time code they sent the bot
/// themselves. Notifications that matter reach them there, and approvals can be decided there.
model MessengerLink {
  id             String   @id @default(uuid())
  organizationId String
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sandbox | bale | telegram
  provider       String
  chatId         String
  username       String?
  linkedAt       DateTime @default(now())

  @@unique([provider, chatId])
  @@map("messenger_links")
}

/// One thing a person may do from the messenger, behind an unguessable token: link their chat,
/// or decide one form approval. Single use, and it expires.
model MessengerAction {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// LINK | FORM_DECISION
  kind           String
  token          String    @unique
  /// For FORM_DECISION: { submissionId, decision, pairToken }
  payload        Json      @default("{}")
  /// OPEN | AWAITING_REASON | DONE | EXPIRED
  state          String    @default("OPEN")
  expiresAt      DateTime
  usedAt         DateTime?
  result         Json?
  /// The chat message the buttons are on, to update it with the outcome.
  chatId         String?
  messageId      String?
  createdAt      DateTime  @default(now())

  @@index([userId, state])
  @@map("messenger_actions")
}

/// Every message to and from the bot: the outbox that retries, and the record of what was said.
model MessengerMessage {
  id                String    @id @default(uuid())
  organizationId    String
  userId            String?
  provider          String
  chatId            String
  /// OUT | IN
  direction         String
  text              String
  /// [[{ text, action? , url? }]] — rows of buttons
  buttons           Json?
  /// QUEUED | SENT | FAILED | RECEIVED
  status            String
  providerMessageId String?
  attempts          Int       @default(0)
  error             String?
  notificationKind  String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([provider, chatId, createdAt])
  @@map("messenger_messages")
}

/// Roadmap #38 — feedback placed on the file itself: a pin on an image, a moment in a video, a
/// region of a PDF page. Positions are fractions of the rendered size, so they hold at any zoom.
/// A QC review that fails carries its open annotations into the revision's required correction.
model Annotation {
  id             String      @id @default(uuid())
  organizationId String
  deliverableId  String
  deliverable    Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The SHA-256 of the file as it was annotated — a newer upload is a new version, not this one.
  documentSha256 String
  /// PIN (image) | TIMECODE (video) | HIGHLIGHT (PDF)
  kind           String
  /// Ordinal on its file: the number drawn on the pin.
  number         Int
  page           Int?
  x              Float?
  y              Float?
  w              Float?
  h              Float?
  timeSec        Float?
  note           String
  /// OPEN | RESOLVED
  status         String      @default("OPEN")
  authorId       String
  author         User        @relation("AnnotationAuthor", fields: [authorId], references: [id])
  createdAt      DateTime    @default(now())
  qcReviewId     String?
  qcReview       QcReview?   @relation(fields: [qcReviewId], references: [id], onDelete: SetNull)
  revisionId     String?
  revision       Revision?   @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolvedById   String?

  @@unique([documentId, number])
  @@index([deliverableId, status])
  @@map("annotations")
}

/// Roadmap #42 — a client's brand, as the organisation holds it: the palette and the typefaces
/// (the logo files and identity guide are Documents on the company with a brandRole).
model BrandKit {
  id             String   @id @default(uuid())
  organizationId String
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// [{ name, hex, role: PRIMARY | SECONDARY | ACCENT | NEUTRAL }]
  colors         Json     @default("[]")
  /// [{ family, usage }]
  fonts          Json     @default("[]")
  notes          String?
  updatedById    String
  updatedAt      DateTime @updatedAt

  @@map("brand_kits")
}

/// An organisation's own rule on a transition (roadmap #47): a guard the move must satisfy, or a
/// notice sent when it happens. Never edited in place — a change is a new version under the same
/// code, and the version it replaces is retired — so a transition can name the rule it met.
model CustomRule {
  id             String    @id @default(uuid())
  organizationId String
  /// Stable across versions: RUL-000001. Waivers and the audit trail name it as `custom:<code>`.
  code           String
  version        Int
  /// GUARD | NOTIFY
  kind           String
  entity         String
  action         String
  labelFa        String
  messageFa      String?
  /// #17's condition language. A GUARD's must hold for the move; a NOTIFY's decides whether to tell.
  when           Json?
  notifyRoles    String[]  @default([])
  createdById    String
  createdAt      DateTime  @default(now())
  retiredAt      DateTime?
  retiredById    String?
  supersededById String?

  @@unique([organizationId, code, version])
  @@index([organizationId, entity, action])
  @@map("custom_rules")
}

/// A one-time link that lets a person set their first password (roadmap #48). Staff imported in
/// bulk never have a password in a file: they get this, by email when mail is on, or shown once
/// to the administrator to pass on. Only the SHA-256 of the token is kept.
model AccountActivation {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("account_activations")
}

/// A browser that asked to be told (roadmap #49): Web Push to the phone, for the three loops whose
/// deadlines are hours. The endpoint is the push service's address for this one browser; p256dh and
/// auth are the browser's keys, which each payload is encrypted to — the service carries it unread.
model PushSubscription {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String    @unique
  p256dh         String
  auth           String
  /// What the browser said it was, for the person to tell their devices apart.
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastSuccessAt  DateTime?
  /// Failures in a row; a delivery resets it.
  failures       Int       @default(0)
  disabledAt     DateTime?
  /// GONE (the service forgot it) | REJECTED (the service refused our key) | FAILING (failed too often)
  /// | NOT_ALLOWED (its service is no longer in PUSH_SERVICE_HOSTS)
  disabledReason String?

  messages PushMessage[]

  @@index([userId])
  @@map("push_subscriptions")
}

/// One notice to one browser: the outbox that retries, and the record of what the push service said.
model PushMessage {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  body           String?
  /// Where tapping the notice opens — always a path in this app.
  url            String
  tag            String?
  /// QUEUED | SENT | FAILED | GONE
  status         String           @default("QUEUED")
  attempts       Int              @default(0)
  statusCode     Int?
  error          String?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("push_messages")
}

/// Keys an installation makes for itself when none are configured: the VAPID pair that names this
/// server to push services (roadmap #49). Configured keys (VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY) win.
model ServerKey {
  name       String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("server_keys")
}

/// Who outside the system a lead can name as its source (Hivamis task 2): marketers, whom the system
/// admin keeps, and partner companies, which a seller may add as they name one.
model LeadReferrer {
  id             String   @id @default(uuid())
  organizationId String
  /// MARKETER | PARTNER
  kind           String
  name           String
  phone          String?
  note           String?
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads Lead[]

  @@unique([organizationId, kind, name])
  @@map("lead_referrers")
}

/// What an organisation's system administrator granted a role (Hivamis task 6). The newest row per
/// role is in force; earlier ones stay, superseded, as the record of who granted what and when. The
/// full-access roles never appear here: they hold everything, always.
model RoleGrant {
  id             String    @id @default(uuid())
  organizationId String
  roleCode       String
  permissions    String[]
  note           String?
  grantedById    String
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  @@index([organizationId, roleCode])
  @@map("role_grants")
}

/**
 * ── Signing in and joining (Hivamis task 4) ───────────────────────────────
 */

/// An account somewhere else that signs this person in — today, Google. `subject` is the provider's
/// permanent id for the person; the email is kept for display only and never used to sign in.
model UserIdentity {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  subject    String
  email      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// A one-time code sent by SMS: to sign in, to sign up, or to prove a mobile is one's own. Only an
/// HMAC of the code is kept; five wrong tries spend it.
model OtpCode {
  id         String    @id @default(uuid())
  purpose    String
  phone      String
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

/// What was sent by SMS. Outside the sandbox the code itself is never stored.
model SmsMessage {
  id        String   @id @default(uuid())
  phone     String
  text      String
  provider  String
  status    String
  error     String?
  /// Audit SEC-6: what the code was for, and whose account it opens. The outbox shows a sandboxed code
  /// only when it opens no account (asking to join) or is the reader's own.
  purpose   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sms_outbox")
}

/// A Google sign-in in progress: the state the browser carries out and back, with the PKCE verifier
/// and nonce that tie the answer to this request. Ten minutes, one use.
model OAuthState {
  id             String    @id @default(uuid())
  stateHash      String    @unique
  provider       String
  mode           String
  codeVerifier   String
  nonce          String
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Roadmap #50: the organisation an «ask to join with Google» began in — the callback returns to
  /// the installation's one address, which names no organisation.
  organizationId String?
  /// Audit SEC-5: the hash of a nonce kept in a cookie of the browser that began the flow. The callback
  /// is honoured only in that browser, so nobody can hand another person the end of their own sign-in.
  bindingHash    String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@map("oauth_states")
}

/// Audit SEC-5: a Google account whose verified address is a person's work address. It is not linked —
/// and signs nobody in — until that person proves the account is theirs once, by password or a code to
/// their mobile. Ten minutes, one use, five tries.
model IdentityLinkOffer {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  subject    String
  email      String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("identity_link_offers")
}

/// The hand-off from a provider's redirect to the app: a single-use ticket, a minute long, that the
/// page trades for its session — so no token ever travels in a URL.
model LoginTicket {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("login_tickets")
}

/// Someone asking to join the organisation, with a mobile or a Google account they proved is theirs.
/// Nothing is granted until the system administrator approves — and then they choose the unit and roles.
model SignupRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  method         String
  fullName       String
  email          String
  phone          String?
  googleSubject  String?
  /// A request by email and password: the chosen password, hashed at once; cleared when decided.
  passwordHash   String?
  departmentCode String?
  note           String?
  status         String       @default("PENDING")
  decidedById    String?
  decidedBy      User?        @relation("SignupDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  userId         String?
  user           User?        @relation("SignupAccount", fields: [userId], references: [id], onDelete: SetNull)
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status, createdAt])
  @@map("signup_requests")
}

/**
 * ── The local assistant (Hivamis task 5) ──────────────────────────────────
 */

/// What the assistant proposed to do for someone (audit F-4): each step as the exact request it would
/// make. Nothing runs until that person approves steps; then each runs through the ordinary API with
/// their own token. The plan and what came of it stay here and in the audit trail.
model AiPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  /// [{ kind, summaryFa, summaryEn, request: { method, path, body }, issue? }]
  steps          Json
  /// PROPOSED | EXECUTED | PARTIAL | FAILED | DECLINED
  status         String       @default("PROPOSED")
  /// [{ index, status: DONE | FAILED | DECLINED, code?, message? }]
  outcome        Json?
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  @@index([userId, createdAt])
  @@map("ai_plans")
}

/// Team chat (audit F-5): a direct conversation between two people, a private group, or a channel
/// any colleague may join. Its members read it; beyond them only a reviewer holding chat.oversight,
/// each look recorded with its reason.
model ChatConversation {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// DIRECT | GROUP | CHANNEL
  kind           String
  title          String?
  topic          String?
  /// DIRECT only: the two people's ids, sorted and joined — one conversation per pair.
  directKey      String?
  createdById    String
  createdBy      User          @relation("ChatConversationCreator", fields: [createdById], references: [id])
  lastMessageAt  DateTime?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  members        ChatMember[]
  messages       ChatMessage[]
  documents      Document[]

  @@unique([organizationId, directKey])
  @@index([organizationId, kind])
  @@map("chat_conversations")
}

/// Who is in a conversation, and how they want to hear of it. Leaving keeps the row (`leftAt`).
model ChatMember {
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OWNER | ADMIN | MEMBER
  role           String           @default("MEMBER")
  muted          Boolean          @default(false)
  /// ALL | MENTIONS | NONE — away from the page; the unread count is always kept.
  notify         String           @default("ALL")
  lastReadAt     DateTime?
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_members")
}

/// One message. Edited, it keeps what it said before (chat_message_edits); deleted, it is hidden
/// from the conversation and kept.
model ChatMessage {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation("ChatMessageAuthor", fields: [authorId], references: [id])
  body           String
  replyToId      String?
  replyTo        ChatMessage?      @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]     @relation("ChatReplies")
  /// People named in it: they hear of it even when they hear only of mentions.
  mentionIds     String[]          @default([])
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime          @default(now())
  edits          ChatMessageEdit[]
  attachments    Document[]        @relation("ChatAttachments")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// What a message said before an edit.
model ChatMessageEdit {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body      String
  editedAt  DateTime    @default(now())

  @@index([messageId])
  @@map("chat_message_edits")
}

/// Audit F-7: a write a device may send more than once — an offline queue replaying after a lost
/// answer — is done once. The first successful answer is kept a week and given again to the same
/// key; the same key on a different request is refused.
model IdempotencyKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  method         String
  path           String
  /// SHA-256 of the method, path and body: a key answers only the request it was made for.
  requestHash    String
  statusCode     Int?
  response       Json?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// A person's conversation with the assistant — theirs alone; nobody else, administrators included,
/// reads it. What each turn did (model, tools, timing) goes to ai_interactions for the AI log.
model AiConversation {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// One message: what the person asked, what the assistant answered, or what a tool returned to it.
model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolName       String?
  toolArgs       Json?
  /// What the answer offers to do next — open a form ready to fill, open a page — for the person to click.
  actions        Json           @default("[]")
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// A recorded video for one section of the guide (Hivamis task 8), in one language — the
/// organisation's own screen recording, uploaded by the system administrator. One per section and
/// language: a new upload replaces the old one.
model GuideVideo {
  id             String   @id @default(uuid())
  organizationId String
  sectionId      String
  locale         String
  title          String
  storedName     String
  mimeType       String
  sizeBytes      Float
  uploadedById   String
  uploadedBy     User     @relation("GuideVideoUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([organizationId, sectionId, locale])
  @@map("guide_videos")
}

/// Roadmap #50: each time the reference data — roles, units, SLA policies, the form catalogue — was
/// brought up to the running version: on start-up after an upgrade, or by hand.
model SystemUpgrade {
  id         String    @id @default(uuid())
  appVersion String
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json      @default("{}")

  @@index([startedAt])
  @@map("system_upgrades")
}

/// Audit SEC-10: a wrong password or code, kept against what was typed and the network it came from —
/// not against the account. Throttle state, not evidence: the audit trail keeps LOGIN_FAILED, and a
/// success clears its pair.
model SignInFailure {
  id         String   @id @default(uuid())
  /// The email or mobile as typed (normalised), prefixed `portal:` for the client portal.
  identifier String
  /// The client's /24 (IPv4) or /64 (IPv6).
  network    String
  createdAt  DateTime @default(now())

  @@index([identifier, network, createdAt])
  @@index([createdAt])
  @@map("sign_in_failures")
}

/**
 * ═══════════════════════ Meeting bookings (audit F-9) ═══════════════════════
 * The Telegram meeting platform's domain, in Hivamis: rooms, equipment, parking and vehicles, and
 * the bookings that hold them. Every row carries its organisation. A confirmed booking's holds are
 * rows the database refuses to overlap (exclusion constraints on a generated range), so no race in
 * the application can book one room, or one person, twice.
 */

/// Where bookable things are: a building or floor of the organisation's, or somewhere outside.
model BookingLocation {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  kind           String             @default("INSIDE")
  address        String?
  building       String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  resources      BookableResource[]

  @@unique([organizationId, name])
  @@map("booking_locations")
}

/// A room, a piece of equipment, a car park or a vehicle a meeting can hold.
model BookableResource {
  id             String            @id @default(uuid())
  organizationId String
  type           String
  name           String
  description    String?
  locationId     String?
  location       BookingLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Seats for a room, spaces for parking; one for anything booked whole.
  capacity       Int               @default(1)
  floor          String?
  features       String[]          @default([])
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  roomOf         Booking[]         @relation("BookingRoom")
  parkingOf      Booking[]         @relation("BookingParking")
  bookedWith     BookingResource[]
  holds          ResourceHold[]

  @@unique([organizationId, name])
  @@index([organizationId, type])
  @@map("bookable_resources")
}

/// A meeting booked: when, where, who and what it needs. Its state moves only through the workflow.
model Booking {
  id             String               @id @default(uuid())
  organizationId String
  code           String               @unique
  state          String               @default("DRAFT")
  title          String
  description    String?
  kind           String               @default("INTERNAL")
  startsAt       DateTime
  endsAt         DateTime
  organizerId    String
  organizer      User                 @relation("BookingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  approverId     String?
  approver       User?                @relation("BookingApprover", fields: [approverId], references: [id], onDelete: SetNull)
  roomId         String?
  room           BookableResource?    @relation("BookingRoom", fields: [roomId], references: [id], onDelete: SetNull)
  /// Where, when it is not a bookable room.
  placeNote      String?
  parkingId      String?
  parking        BookableResource?    @relation("BookingParking", fields: [parkingId], references: [id], onDelete: SetNull)
  parkingSpaces  Int                  @default(0)
  projectId      String?
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// The Hivamis meeting made on confirmation, where its minutes are kept.
  meetingId      String?              @unique
  meeting        Meeting?             @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  submittedAt    DateTime?
  decidedAt      DateTime?
  /// Why it was rejected, or what to change.
  decisionNote   String?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  participants   BookingParticipant[]
  resources      BookingResource[]
  guests         BookingGuest[]
  catering       BookingCatering[]
  resourceHolds  ResourceHold[]
  personHolds    PersonHold[]

  @@index([organizationId, state])
  @@index([organizationId, startsAt])
  @@index([organizerId])
  @@index([approverId])
  @@map("bookings")
}

model BookingParticipant {
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  response       String    @default("PENDING")
  respondedAt    DateTime?

  @@id([bookingId, userId])
  @@index([userId])
  @@map("booking_participants")
}

/// Equipment or a vehicle a booking asks for, besides its room and parking.
model BookingResource {
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceId     String
  resource       BookableResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  organizationId String

  @@id([bookingId, resourceId])
  @@index([resourceId])
  @@map("booking_resources")
}

/// Someone from outside the organisation, expected at reception.
model BookingGuest {
  id             String    @id @default(uuid())
  organizationId String
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName       String
  company        String?
  email          String?
  phone          String?
  isVip          Boolean   @default(false)
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  checkedInById  String?
  checkedInBy    User?     @relation("GuestCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([bookingId])
  @@map("booking_guests")
}

model CateringOption {
  id             String            @id @default(uuid())
  organizationId String
  labelFa        String
  labelEn        String
  unitPrice      Decimal           @default(0) @db.Decimal(14, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  orders         BookingCatering[]

  @@unique([organizationId, labelFa])
  @@map("catering_options")
}

model BookingCatering {
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  optionId       String
  option         CateringOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  organizationId String
  quantity       Int

  @@id([bookingId, optionId])
  @@map("booking_catering")
}

/// What a confirmed booking occupies. `period` is generated from the two instants; an exclusion
/// constraint refuses two exclusive holds of one resource that overlap. Parking is shared up to its
/// capacity, counted under an advisory lock.
model ResourceHold {
  id             String                  @id @default(uuid())
  organizationId String
  resourceId     String
  resource       BookableResource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  spaces         Int                     @default(1)
  exclusive      Boolean                 @default(true)
  period         Unsupported("tsrange")?
  createdAt      DateTime                @default(now())

  @@index([bookingId])
  @@map("resource_holds")
}

/// A person held by a confirmed booking: nobody is in two meetings at once.
model PersonHold {
  id             String                  @id @default(uuid())
  organizationId String
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  period         Unsupported("tsrange")?
  createdAt      DateTime                @default(now())

  @@index([bookingId])
  @@map("person_holds")
}

/// A team within one of Doc_H's units (list 3, item 6): Creative's «طراحی» and «ویدئو». The unit stays
/// what the process routes to; the team says who works together inside it.
model Team {
  id             String     @id @default(uuid())
  organizationId String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  nameFa         String
  nameEn         String     @default("")
  leadId         String?
  lead           User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  color          String?
  /// Set when the team is wound up; its members are left without a team, its history stays.
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  members        User[]     @relation("TeamMembers")

  @@unique([organizationId, departmentId, nameFa])
  @@index([departmentId])
  @@map("teams")
}

/**
 * ── ADR-103: venues, deployment projects and rentals ─────────────────────────
 */

/// The organisation's own lists: venue types, grades, audiences, cooperation models, payment methods,
/// contact roles, channels, charge and photo categories. A record keeps the code it was given; an option
/// is retired (isActive false), never deleted, so what was written under it keeps its meaning.
model SiteOption {
  id             String   @id @default(uuid())
  organizationId String
  list           String
  code           String
  labelFa        String
  labelEn        String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  /// What the option means to the rules: a cooperation model's `requiresContract`, a method's `isCheque`.
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, list, code])
  @@map("site_options")
}

/// How the rentals run, one row per organisation (siteSettingsSchema): reminders, proration, overpayment,
/// what activation and closure ask for, which venue fields are required, the SMS templates.
model SiteSettings {
  organizationId String   @id
  settings       Json     @default("{}")
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}

/// A place a counter, a stand or an activation can go: a mall, a metro station, an amusement park.
model Venue {
  id             String    @id @default(uuid())
  organizationId String
  code           String    @unique
  name           String
  /// The name and the phone reduced to what identifies them (nameKey, phoneKey) — for finding duplicates.
  nameKey        String
  province       String
  city           String
  address        String?
  typeCode       String
  gradeCode      String?
  audienceCodes  String[]  @default([])
  phone          String?
  phoneKey       String?
  email          String?
  website        String?
  notes          String?
  isActive       Boolean   @default(true)
  /// MANUAL or IMPORT; an imported venue keeps the row it came from, as the file had it.
  source         String    @default("MANUAL")
  importId       String?
  importedValues Json?
  /// Venues an authorised person said are other places, though they look alike.
  distinctFrom   String[]  @default([])
  /// A duplicate merged into another venue: kept, archived, pointing at the one that stays.
  mergedIntoId   String?
  version        Int       @default(1)
  createdById    String
  createdBy      User      @relation("VenueCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  contacts     VenueContact[]
  channels     VenueChannel[]
  siteProjects SiteProject[]
  documents    Document[]
  messages     VenueMessage[]

  @@unique([id, organizationId])
  @@index([organizationId, province, city])
  @@index([organizationId, typeCode])
  @@index([organizationId, nameKey])
  @@index([organizationId, phoneKey])
  @@map("venues")
}

/// Someone at a venue: its managing director, marketing, technical, anyone the organisation names a role for.
model VenueContact {
  id             String    @id @default(uuid())
  organizationId String
  venueId        String
  venue          Venue     @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  fullName       String
  roleCode       String
  jobTitle       String?
  phone          String?
  phoneKey       String?
  email          String?
  notes          String?
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  channels     VenueChannel[]
  negotiations SiteNegotiationParticipant[]
  messages     VenueMessage[]

  @@unique([id, organizationId])
  @@index([organizationId, venueId])
  @@index([organizationId, phoneKey])
  @@map("venue_contacts")
}

/// A way to reach a venue or one of its people: email, WhatsApp, Telegram, a website.
model VenueChannel {
  id             String        @id @default(uuid())
  organizationId String
  venueId        String
  venue          Venue         @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contactId      String?
  contact        VenueContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  typeCode       String
  value          String
  note           String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, venueId])
  @@map("venue_channels")
}

/// One placement in one venue — the document's «پروژه» — from the first look at the place to the deposit
/// back. Its state moves only through the workflow engine (SITE_PROJECT_WORKFLOW). A campaign in several
/// venues is several of these under one client project.
model SiteProject {
  id                  String    @id @default(uuid())
  organizationId      String
  code                String    @unique
  name                String
  venueId             String
  venue               Venue     @relation(fields: [venueId, organizationId], references: [id, organizationId])
  /// Where in the venue: the floor, the hall, beside which entrance.
  placement           String?
  projectId           String?
  project             Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  companyId           String?
  company             Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  responsibleId       String?
  responsible         User?     @relation("SiteProjectResponsible", fields: [responsibleId], references: [id])
  cooperationCode     String?
  state               String    @default("DRAFT")
  currency            String    @default("IRR")
  contractStart       DateTime?
  contractEnd         DateTime?
  depositAmount       Decimal?  @db.Decimal(20, 2)
  rentAmount          Decimal?  @db.Decimal(20, 2)
  rentPeriod          String    @default("MONTHLY")
  rentDueDay          Int?
  rentMethodCode      String?
  chargeAmount        Decimal?  @db.Decimal(20, 2)
  chargeDueDay        Int?
  chargeMethodCode    String?
  installPlannedAt    DateTime?
  installedAt         DateTime?
  installDays         Int?
  installStatus       String    @default("NOT_STARTED")
  installCost         Decimal?  @db.Decimal(20, 2)
  transportCost       Decimal?  @db.Decimal(20, 2)
  installNotes        String?
  notes               String?
  scheduleGeneratedAt DateTime?
  /// What was owed, paid, deducted and returned the day it closed — the closure's statement, kept.
  closureStatement    Json?
  closedAt            DateTime?
  cancelReason        String?
  /// Bumped by every edit: a change made on an older reading is refused, not merged over a newer one.
  version             Int       @default(1)
  createdById         String
  createdBy           User      @relation("SiteProjectCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  negotiations   SiteNegotiation[]
  contracts      SiteContract[]
  approvals      SiteApproval[]
  counters       SiteCounter[]
  assignments    SiteAssignment[]
  obligations    SiteObligation[]
  payments       SitePayment[]
  depositEntries SiteDepositEntry[]
  documents      Document[]
  messages       VenueMessage[]

  @@unique([id, organizationId])
  @@index([organizationId, state])
  @@index([organizationId, venueId])
  @@index([organizationId, contractEnd])
  @@index([projectId])
  @@map("site_projects")
}

/// A conversation with the venue about terms — before the contract, and periodically after it.
model SiteNegotiation {
  id                 String      @id @default(uuid())
  organizationId     String
  siteProjectId      String
  siteProject        SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  heldAt             DateTime
  channel            String      @default("MEETING")
  summary            String
  proposedRent       Decimal?    @db.Decimal(20, 2)
  proposedRentPeriod String?
  proposedDeposit    Decimal?    @db.Decimal(20, 2)
  proposedCharge     Decimal?    @db.Decimal(20, 2)
  otherTerms         String?
  outcome            String      @default("OPEN")
  nextAction         String?
  followUpAt         DateTime?
  followUpDoneAt     DateTime?
  assigneeId         String?
  assignee           User?       @relation("SiteNegotiationAssignee", fields: [assigneeId], references: [id])
  createdById        String
  createdBy          User        @relation("SiteNegotiationCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  participants SiteNegotiationParticipant[]

  @@index([organizationId, siteProjectId, heldAt])
  @@index([organizationId, followUpAt])
  @@map("site_negotiations")
}

/// Who was at a negotiation: someone from the venue, a colleague, or someone named who is neither.
model SiteNegotiationParticipant {
  id            String          @id @default(uuid())
  negotiationId String
  negotiation   SiteNegotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       VenueContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  name          String?

  @@index([negotiationId])
  @@map("site_negotiation_participants")
}

/// A version of the agreement with the venue — a formal contract, an informal one, or the invoice terms —
/// with its decision. A new version supersedes the last; none is ever rewritten after its decision.
model SiteContract {
  id              String      @id @default(uuid())
  organizationId  String
  siteProjectId   String
  siteProject     SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  version         Int
  reference       String?
  cooperationCode String?
  startDate       DateTime?
  endDate         DateTime?
  /// The project's terms when it was written: rent, period, charge, deposit, currency.
  terms           Json
  status          String      @default("DRAFT")
  notes           String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       User?       @relation("SiteContractDecidedBy", fields: [decidedById], references: [id])
  decisionComment String?
  createdById     String
  createdBy       User        @relation("SiteContractCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([siteProjectId, version])
  @@index([organizationId, status])
  @@map("site_contracts")
}

/// A decision on the project recorded with who made it: the contract's, the client's (employer's) —
/// taken at the client and recorded here with its evidence — a deposit deduction's.
model SiteApproval {
  id             String      @id @default(uuid())
  organizationId String
  siteProjectId  String
  siteProject    SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// CONTRACT | EMPLOYER | DEDUCTION
  kind           String
  /// What it decided: the contract version, the deduction; for the employer, CONTRACT | INSTALLATION | GENERAL.
  subject        String?
  subjectId      String?
  decision       String
  comment        String?
  /// A colleague who decided, or the client's person, named as they signed.
  decidedById    String?
  decidedBy      User?       @relation("SiteApprovalDecidedBy", fields: [decidedById], references: [id])
  approverName   String?
  approverTitle  String?
  decidedAt      DateTime
  recordedById   String
  recordedBy     User        @relation("SiteApprovalRecordedBy", fields: [recordedById], references: [id])
  createdAt      DateTime    @default(now())

  @@index([organizationId, siteProjectId, kind])
  @@map("site_approvals")
}

/// A counter (or any structure) built for the project: how many, its size, what one cost to make.
model SiteCounter {
  id             String      @id @default(uuid())
  organizationId String
  siteProjectId  String
  siteProject    SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  label          String
  quantity       Int         @default(1)
  widthCm        Int?
  depthCm        Int?
  heightCm       Int?
  specs          String?
  unitCost       Decimal?    @db.Decimal(20, 2)
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId, siteProjectId])
  @@map("site_counters")
}

/// Someone at the venue for the project: a promoter in the counter, an installer, a supervisor — a
/// colleague, or a person from outside named here.
model SiteAssignment {
  id             String      @id @default(uuid())
  organizationId String
  siteProjectId  String
  siteProject    SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role           String      @default("PROMOTER")
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  personName     String?
  phone          String?
  startsOn       DateTime?
  endsOn         DateTime?
  shift          String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId, siteProjectId])
  @@map("site_assignments")
}

/// Something owed for the placement: a month's rent, a month's service charge, the deposit, a penalty,
/// installation, transport. `settledAmount` is what its allocations add to, kept in the same transaction
/// as they are written; the allocations are the record.
model SiteObligation {
  id             String      @id @default(uuid())
  organizationId String
  siteProjectId  String
  siteProject    SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind           String
  categoryCode   String?
  description    String?
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime
  amount         Decimal     @db.Decimal(20, 2)
  currency       String
  settledAmount  Decimal     @default(0) @db.Decimal(20, 2)
  status         String      @default("OPEN")
  /// A scheduled one's place in the schedule (RENT:2026-10-23): made once, however often the schedule is.
  scheduleKey    String?
  source         String      @default("MANUAL")
  closeReason    String?
  closedAt       DateTime?
  createdById    String
  createdBy      User        @relation("SiteObligationCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  allocations    SiteAllocation[]
  depositEntries SiteDepositEntry[]

  @@unique([id, organizationId])
  @@unique([siteProjectId, scheduleKey])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, siteProjectId])
  @@map("site_obligations")
}

/// Money paid to the venue (OUT) or back from it (IN). Never edited: a mistake is reversed, with its
/// reason, and paid again. `clientKey` makes a payment sent twice a payment recorded once.
model SitePayment {
  id             String      @id @default(uuid())
  organizationId String
  siteProjectId  String
  siteProject    SiteProject @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  direction      String      @default("OUT")
  /// OUT: OBLIGATIONS — what is owed. IN: DEPOSIT_REFUND — the deposit back; CREDIT_REFUND — an overpayment back.
  purpose        String      @default("OBLIGATIONS")
  amount         Decimal     @db.Decimal(20, 2)
  currency       String
  paidAt         DateTime
  methodCode     String
  reference      String?
  chequeNumber   String?
  chequeBank     String?
  chequeDate     DateTime?
  note           String?
  clientKey      String
  recordedById   String
  recordedBy     User        @relation("SitePaymentRecordedBy", fields: [recordedById], references: [id])
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?       @relation("SitePaymentReversedBy", fields: [reversedById], references: [id])
  reversalReason String?
  createdAt      DateTime    @default(now())

  allocations    SiteAllocation[]
  depositEntries SiteDepositEntry[]

  @@unique([organizationId, clientKey])
  @@index([organizationId, siteProjectId])
  @@index([organizationId, paidAt])
  @@map("site_payments")
}

/// What settled what: part of a payment put against an obligation, or a deposit deduction the venue took
/// for it. Exactly one source; reversed with its source, never deleted.
model SiteAllocation {
  id             String            @id @default(uuid())
  organizationId String
  obligationId   String
  obligation     SiteObligation    @relation(fields: [obligationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  paymentId      String?
  payment        SitePayment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  depositEntryId String?
  depositEntry   SiteDepositEntry? @relation(fields: [depositEntryId], references: [id], onDelete: Cascade)
  amount         Decimal           @db.Decimal(20, 2)
  reversedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([obligationId])
  @@index([paymentId])
  @@map("site_allocations")
}

/// The deposit's own ledger, beside the payments that put it with the venue: what the venue keeps
/// (DEDUCTION, with its reason, approved) and what it gives back (REFUND, from an IN payment). The deposit
/// itself is never rewritten to show either.
model SiteDepositEntry {
  id              String          @id @default(uuid())
  organizationId  String
  siteProjectId   String
  siteProject     SiteProject     @relation(fields: [siteProjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind            String
  amount          Decimal         @db.Decimal(20, 2)
  currency        String
  reason          String?
  obligationId    String?
  obligation      SiteObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         SitePayment?    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// PROPOSED → APPROVED | REJECTED; VOID when its payment is reversed.
  status          String
  decidedById     String?
  decidedBy       User?           @relation("SiteDepositDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionComment String?
  recordedById    String
  recordedBy      User            @relation("SiteDepositRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())

  allocations SiteAllocation[]

  @@index([organizationId, siteProjectId])
  @@map("site_deposit_entries")
}

/// One reminder sent: of what, how long before (or, negative, after) it was due, by which channel, to
/// whom. The unique key is what makes the daily run safe to repeat — a reminder goes out once.
model SiteReminder {
  id             String    @id @default(uuid())
  organizationId String
  siteProjectId  String?
  event          String
  subjectType    String
  subjectId      String
  dueDate        DateTime
  offsetDays     Int
  channel        String
  /// A user id, or for SMS the number it went to.
  recipient      String
  /// SENT (in the app; for SMS, accepted by the provider) | SANDBOX | FAILED — retried while attempts last.
  status         String
  attempts       Int       @default(1)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, subjectType, subjectId, event, offsetDays, channel, recipient])
  @@index([organizationId, createdAt])
  @@index([status, attempts])
  @@map("site_reminders")
}

/// An SMS to a venue or one of its people, and what became of it. SENT is the provider's acceptance;
/// DELIVERED and UNDELIVERED only what the provider later reports — nothing is called delivered on hope.
model VenueMessage {
  id             String        @id @default(uuid())
  organizationId String
  venueId        String?
  venue          Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        VenueContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  siteProjectId  String?
  siteProject    SiteProject?  @relation(fields: [siteProjectId], references: [id], onDelete: SetNull)
  phone          String
  text           String
  templateKey    String?
  provider       String
  status         String
  providerRef    String?
  error          String?
  attempts       Int           @default(1)
  sentById       String?
  sentBy         User?         @relation(fields: [sentById], references: [id])
  createdAt      DateTime      @default(now())
  sentAt         DateTime?
  checkedAt      DateTime?

  @@index([organizationId, createdAt])
  @@index([status, attempts])
  @@map("venue_messages")
}

/// An Excel file brought in: what kind, how matches were treated, and row by row what became of it.
model SiteImport {
  id             String   @id @default(uuid())
  organizationId String
  kind           String
  mode           String
  fileName       String
  fileSha256     String
  totalRows      Int
  created        Int
  updated        Int
  failed         Int
  /// Each row's outcome, its errors in words (capped at the first 2000 rows).
  report         Json
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("site_imports")
}

/// A list's filters kept under a name — the person's own, or shared with the organisation.
model SiteSavedView {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page           String
  name           String
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, page])
  @@map("site_saved_views")
}

/// What a move from another system made of each of its records (the owner's Mizito, 2026-10-28): run
/// twice, it makes nothing twice, and every record can say where it came from.
model ImportLink {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The system it came from: `mizito`, `sheet`.
  source         String
  /// The source's own id, with its kind: `user:…`, `task:…`.
  externalId     String
  entityType     String
  entityId       String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, source, externalId])
  @@index([entityType, entityId])
  @@map("import_links")
}

/// What a person typed and has not saved (ADR-122): theirs alone, kept until it is saved or they delete it.
model UserDraft {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Where it belongs: the page, and the dialog on it.
  key            String
  title          String
  path           String
  /// Each field: its label, what was typed, and what the field held when typing began.
  fields         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, key])
  @@index([organizationId])
  @@map("user_drafts")
}
