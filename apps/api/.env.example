# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER@localhost:5432/hiva_os?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage

# ── Extensions (roadmap #47) ───────────────────────────────────────────────────
# A directory of .js/.mjs modules adding guards and effects; unset loads none.
# See apps/api/extensions/examples. Code here runs with the API's own rights.
# EXTENSIONS_DIR=./extensions/installed

# ── PDF engine ────────────────────────────────────────────────────────────────
# Leave unset locally: the renderer finds the Playwright cache or an installed Chrome.
# The Docker image sets this to /usr/bin/chromium.
PDF_BROWSER_PATH=
MAX_UPLOAD_MB=25

# ── AI (optional — the AI module degrades gracefully when unset) ───────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_ENABLED=false

# ── Background jobs ───────────────────────────────────────────────────────────
JOBS_ENABLED=true
SLA_TICK_CRON=*/5 * * * *
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Load the fifteen demo accounts and demo business records.
# Never set this in production — the demo password is published in README.md.
SEED_DEMO_DATA=true

# Which proxies may set X-Forwarded-For. `false` (default) trusts nothing, which is correct
# when the API is reached directly. Behind one reverse proxy, set 1.
TRUST_PROXY=false

# Simultaneous Chromium renders (each ~150MB RSS) and the queue depth behind them.
# Beyond PDF_MAX_CONCURRENCY * PDF_QUEUE_FACTOR waiting requests, callers get 503 immediately.
PDF_MAX_CONCURRENCY=2
PDF_QUEUE_FACTOR=4

# ── Outbound mail (optional) ───────────────────────────────────────────────────
# With MAIL_ENABLED unset, notifications stay in-app and nothing throws — the same
# graceful-degradation contract the AI subsystem uses.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Web Push to phones (roadmap #49, optional) ─────────────────────────────────
# The VAPID pair that names this server to the browsers' push services. Left empty, the
# installation makes one on first use and keeps it in the database. Set it once in production:
# changing it later silences every phone until its owner opens the app again.
# Generate: pnpm --filter @hiva/api exec tsx -e "import('./src/push/crypto.js').then(m=>console.log(m.generateVapidKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact the push services may use (Apple requires one).
VAPID_SUBJECT=
# `off` records pushes and sends none — for an installation with no route to the push services.
PUSH_DELIVERY=on
# Push services a subscription may point at (each host and its subdomains). Nothing else is called.
PUSH_SERVICE_HOSTS=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,web.push.apple.com,notify.windows.com

# ── The chat assistant (Hivamis task 5) ─────────────────────────────────────────
# A local model served by Ollama: free, unlimited, and nothing said to it leaves the network.
# Install Ollama, `ollama pull qwen3:14b`, and keep it off the internet (it has no authentication).
# `off`: the assistant says it is turned off on this installation.
CHAT_MODE=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# Answers written at once; the rest queue and are told their place.
CHAT_CONCURRENCY=1

# ── The guide's videos (Hivamis task 8) ─────────────────────────────────────────
# Largest screen recording the system administrator may add to a guide section, in MB.
GUIDE_VIDEO_MAX_MB=200
