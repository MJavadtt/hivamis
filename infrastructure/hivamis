#!/usr/bin/env bash
# Hivamis on one machine, with Docker Compose (roadmap #50).
#
#   infrastructure/hivamis prereqs                 (as root) Docker, Compose, openssl, curl on Ubuntu 22.04/24.04 or Debian 12
#   infrastructure/hivamis install --org-name NAME --org-slug SLUG --admin-email EMAIL --admin-name NAME
#                                  [--domain HOST] [--port 8080] [--multi] [--model NAME | --no-ai] [--image] [--speech]
#   infrastructure/hivamis status
#   infrastructure/hivamis model [pull [NAME] | auto]   the assistant's model: show it, fetch one, or
#                                  choose again for this machine (GPU or not, its memory) and switch to it
#   infrastructure/hivamis backup
#   infrastructure/hivamis reset --admin EMAIL [--slug SLUG] [--yes]   a clean start: every person and record but
#                                  that system administrator, the history kept; a backup first, a new password asked
#   infrastructure/hivamis restore --db FILE.dump [--storage FILE.tar.gz] --yes
#   infrastructure/hivamis upgrade [--pull] [--no-backup]
#   infrastructure/hivamis tenant list | create … | update …     (the API's own commands)
#   infrastructure/hivamis import-mizito --mizito FILE [--sheet FILE] [--extra FILE] --as EMAIL [--commit]
#                                  a move from Mizito and the client sheet: without --commit, what it would make;
#                                  with it, a backup first, then made — run again, it makes nothing twice
#   infrastructure/hivamis passwords --as EMAIL [--out FILE] [--commit]
#                                  a temporary password for everyone who never had one, changed at the first
#                                  sign-in: without --commit, who; with it, set and written to FILE (default
#                                  hivamis-passwords.csv, readable by you only) — hand them on, then delete it
#
# HIVAMIS_ENV_FILE    the settings file (default: .env beside docker-compose.yml)
# HIVAMIS_BACKUP_DIR  where backups go (default: ./backups); RETENTION_DAYS (default 30)
# HIVAMIS_DRY_RUN=1   print every command instead of running it
# HIVAMIS_MEMORY_GB, HIVAMIS_GPU=0|1   what the model is chosen for, when detection should not decide
# HIVAMIS_OS_RELEASE  the os-release file prereqs reads (default /etc/os-release)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${HIVAMIS_ENV_FILE:-$ROOT/.env}"
BACKUP_DIR="${HIVAMIS_BACKUP_DIR:-$ROOT/backups}"
RETENTION_DAYS="${RETENTION_DAYS:-30}"
DRY="${HIVAMIS_DRY_RUN:-0}"

say() { printf '%s\n' "$*" >&2; }
die() { say "✗ $*"; exit 1; }
run() { if [ "$DRY" = 1 ]; then printf '+ %s\n' "$*"; else "$@"; fi; }
compose() { run docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" "$@"; }
# A command whose output is a file: the redirect is part of what a dry run shows.
compose_to() { local out="$1"; shift
  if [ "$DRY" = 1 ]; then printf '+ docker compose %s > %s\n' "$*" "$out"; else docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" "$@" > "$out"; fi; }
compose_from() { local in="$1"; shift
  if [ "$DRY" = 1 ]; then printf '+ docker compose %s < %s\n' "$*" "$in"; else docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" "$@" < "$in"; fi; }
env_get() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }
# Sets one setting in the settings file: in place when it is there, appended when it is not.
env_set() {
  if grep -qE "^$1=" "$ENV_FILE" 2>/dev/null; then
    run sed -i.bak -e "s|^$1=.*|$1=$2|" "$ENV_FILE"; run rm -f "$ENV_FILE.bak"
  elif [ "$DRY" = 1 ]; then printf '+ echo %s=%s >> %s\n' "$1" "$2" "$ENV_FILE"
  else printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"; fi
}
secret() { openssl rand -base64 "$1" | tr -d '\n/+='; }
cli() { compose exec -T api node dist/cli.js "$@"; }
need_tools() {
  [ "$DRY" = 1 ] && return 0
  command -v docker >/dev/null || die "Docker is not installed. On Ubuntu 22.04/24.04 or Debian 12: sudo infrastructure/hivamis prereqs"
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is not available (docker compose). On Ubuntu 22.04/24.04 or Debian 12: sudo infrastructure/hivamis prereqs"
}

wait_healthy() {
  if [ "$DRY" = 1 ]; then printf '+ wait for http://api:4000/health/ready\n'; return 0; fi
  say "→ waiting for the API (migrations and the reference data run first) …"
  for _ in $(seq 1 90); do
    if docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" exec -T api curl -fsS http://127.0.0.1:4000/health/ready >/dev/null 2>&1; then
      say "✓ the API is ready"; return 0
    fi
    sleep 2
  done
  die "the API did not become ready; see: docker compose logs api"
}

# ── The assistant's model (audit F-1) ───────────────────────────────────────────────────────────

has_gpu() {
  if [ -n "${HIVAMIS_GPU:-}" ]; then [ "$HIVAMIS_GPU" = 1 ]; return; fi
  command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1
}

# The memory the model runs in, in whole GB: the GPU's when there is one, the machine's otherwise.
memory_gb() {
  if [ -n "${HIVAMIS_MEMORY_GB:-}" ]; then printf '%s' "$HIVAMIS_MEMORY_GB"; return; fi
  if has_gpu; then
    local mib
    mib="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc 0-9)"
    if [ -n "$mib" ]; then printf '%s' "$(( mib / 1024 ))"; return; fi
  fi
  if [ -r /proc/meminfo ]; then awk '/^MemTotal:/ { printf "%d", $2 / 1048576 }' /proc/meminfo; return; fi
  if command -v sysctl >/dev/null 2>&1; then printf '%s' "$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"; return; fi
  printf '0'
}

gpu_flag() { if has_gpu; then echo 1; else echo 0; fi; }

# The model for the memory it runs in, leaving room for the database and the API beside it.
# qwen3:30b is a mixture of experts: 30B parameters with about 3B at work for each word, so it is
# both stronger than the dense 14b and several times faster — on a GPU of 20 GB (about 19 GB), or on
# a CPU with 32 GB of memory. The owner's report (2026-10-23): 14b was slow and missed its tools.
model_for() {
  local gb="$1" gpu="${2:-0}"
  if [ "$gpu" = 1 ]; then
    if [ "$gb" -ge 20 ]; then echo qwen3:30b; elif [ "$gb" -ge 10 ]; then echo qwen3:14b; elif [ "$gb" -ge 6 ]; then echo qwen3:8b; else echo qwen3:4b; fi
  else
    if [ "$gb" -ge 32 ]; then echo qwen3:30b; elif [ "$gb" -ge 12 ]; then echo qwen3:8b; else echo qwen3:4b; fi
  fi
}

# How much the model reads at once, in tokens. The prompt, the tools, a page's forms and five rounds
# of tool answers overran 8192, and the model lost its tools from the front. 30b keeps 32K in about
# 3 GB beside its 19.
ctx_for() {
  case "$1" in
    *:30b*|*:32b*) echo 32768 ;;
    *) if [ "${2:-0}" -ge 12 ]; then echo 16384; else echo 8192; fi ;;
  esac
}

# Docker hands an NVIDIA card to a container only through NVIDIA's container toolkit.
gpu_runtime() { [ "$DRY" = 1 ] || docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia; }
# An NVIDIA card the system has no driver for: the model would run on the CPU, slowly.
card_without_driver() {
  [ -z "${HIVAMIS_GPU:-}" ] && ! has_gpu && command -v lspci >/dev/null 2>&1 && lspci 2>/dev/null | grep -qi nvidia
}
driver_hint() {
  say "! This machine has an NVIDIA card but no driver for it, so the model runs on the CPU, slowly."
  say "  Install the driver and restart (Ubuntu: sudo ubuntu-drivers install && sudo reboot),"
  say "  then: sudo infrastructure/hivamis prereqs && infrastructure/hivamis model auto"
}

# The service the model runs in: on the GPU, or the CPU.
model_service() { case "$(env_get COMPOSE_PROFILES)" in *ai-gpu*) echo ollama-gpu ;; *) echo ollama ;; esac; }

model_present() {
  [ "$DRY" = 1 ] && { printf '+ check that %s is in the model store\n' "$1"; return 0; }
  docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" exec -T "$(model_service)" ollama list 2>/dev/null \
    | awk 'NR > 1 { print $1 }' | grep -qx -e "$1" -e "$1:latest"
}

# Fetched by the one container allowed out (ollama-pull); the server itself has no route to the internet.
pull_model() {
  local model="$1"
  say "→ fetching the assistant's model, $model — several GB, once; progress below"
  compose --profile pull run --rm ollama-pull "$model" \
    || die "the model $model could not be fetched. Check this server's internet access, then: infrastructure/hivamis model pull"
  # Not finished without it: an assistant with no model can only say that it is unavailable.
  model_present "$model" || die "$model is not in the model store after fetching it — see: docker compose logs $(model_service)"
  say "✓ the model $model is ready"
}

# Pictures (audit F-2): off unless asked for. On a GPU with 16 GB, FLUX.1-schnell (Apache-2.0);
# otherwise Stable Diffusion 1.5 (CreativeML OpenRAIL-M), which a CPU can draw — slowly.
image_model_for() { if has_gpu && [ "$1" -ge 16 ]; then echo flux.1-schnell; else echo sd-1.5-ggml; fi; }

image_present() {
  [ "$DRY" = 1 ] && { printf '+ check that %s is on the picture server\n' "$1"; return 0; }
  docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" exec -T api curl -fsS http://imagegen:8080/v1/models 2>/dev/null \
    | grep -q "\"$1\""
}

pull_image_model() {
  local model="$1"
  say "→ fetching the picture model, $model — several GB, once"
  compose --profile pull run --rm imagegen-pull models install "$model" \
    || die "the picture model $model could not be fetched. Check this server's internet access, then: docker compose run --rm imagegen-pull models install $model"
  compose restart imagegen 2>/dev/null || compose restart imagegen-gpu
  image_present "$model" || die "$model is not on the picture server after fetching it — see: docker compose logs imagegen"
  say "✓ the picture model $model is ready"
}

# Speech to text (audit F-4): Whisper on the installation's own speech server.
SPEECH_MODEL="Systran/faster-whisper-medium"
pull_speech_model() {
  say "→ fetching the speech model, $SPEECH_MODEL — about 1.5 GB, once"
  compose --profile pull run --rm speech-pull "$SPEECH_MODEL" \
    || die "the speech model could not be fetched. Check this server's internet access, then: docker compose run --rm speech-pull $SPEECH_MODEL"
  compose restart speech
  if [ "$DRY" = 1 ]; then printf '+ check that the speech server answers\n'; return 0; fi
  docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" exec -T api curl -fsS http://speech:8000/health >/dev/null 2>&1 \
    || die "the speech server does not answer — see: docker compose logs speech"
  say "✓ speech to text is ready"
}

model_wanted() { [ "$(env_get CHAT_MODE)" != off ] && [ -n "$(env_get COMPOSE_PROFILES)" ]; }

cmd_model() {
  [ -f "$ENV_FILE" ] || [ "$DRY" = 1 ] || die "$ENV_FILE not found — install first"
  local model; model="$(env_get OLLAMA_MODEL)"
  case "${1:-}" in
    pull)
      if [ -n "${2:-}" ] && [ "$2" != "$model" ]; then
        say "→ OLLAMA_MODEL: $model → $2"
        env_set OLLAMA_MODEL "$2"
        env_set OLLAMA_NUM_CTX "$(ctx_for "$2" "$(memory_gb)")"
        model="$2"
      fi
      pull_model "$model"
      # A new model is the API's to use only once it restarts with the new setting.
      if [ -n "${2:-}" ]; then compose up -d api; fi
      ;;
    auto)
      # Chooses again for this machine as it is now — a GPU made reachable since the install, more
      # memory — and switches to it: the profile, the model, how much it reads, then the API.
      local gpu gb want profiles now
      gpu="$(gpu_flag)"; gb="$(memory_gb)"; want="$(model_for "$gb" "$gpu")"
      if [ "$gpu" = 1 ]; then
        gpu_runtime || die "the NVIDIA card is here but Docker cannot reach it — run: sudo infrastructure/hivamis prereqs"
        now=ai-gpu
      else
        now=ai
        card_without_driver && driver_hint
      fi
      profiles="$(env_get COMPOSE_PROFILES | tr ',' '\n' | grep -vx -e ai -e ai-gpu | paste -sd, -)"
      profiles="$now${profiles:+,$profiles}"
      say "→ the assistant: $want on the $( [ "$gpu" = 1 ] && echo GPU || echo CPU ) (${gb} GB detected), reading $(ctx_for "$want" "$gb") tokens at once"
      env_set COMPOSE_PROFILES "$profiles"
      env_set CHAT_MODE ollama
      env_set OLLAMA_MODEL "$want"
      env_set OLLAMA_NUM_CTX "$(ctx_for "$want" "$gb")"
      # The model's other service, if it ran, steps aside for this one.
      if [ "$now" = ai-gpu ]; then compose rm -sf ollama; else compose rm -sf ollama-gpu; fi
      compose up -d
      pull_model "$want"
      compose up -d api
      say "✓ the assistant now runs $want"
      ;;
    "")
      local gb; gb="$(memory_gb)"
      say "model: ${model:-none}   reads: $(env_get OLLAMA_NUM_CTX) tokens   profile: $(env_get COMPOSE_PROFILES)"
      say "this machine: $( has_gpu && echo GPU || echo CPU ), ${gb} GB → $(model_for "$gb" "$(gpu_flag)")"
      card_without_driver && driver_hint
      # Where the model sits now: "100% GPU" is the card, "100% CPU" the processor.
      [ "$DRY" = 1 ] || compose exec -T "$(model_service)" ollama ps 2>/dev/null || true
      ;;
    *) die "model [pull [NAME] | auto]" ;;
  esac
}

# ── What the server needs (audit F-8) ──────────────────────────────────────────────────────────

# Docker Engine and Compose from Docker's own repository — the distributions' packages lag behind
# Compose v2 — with openssl for the secrets and curl for the checks. Only on the systems this is
# tested on; anywhere else it says what to install rather than guessing.
cmd_prereqs() {
  local release="${HIVAMIS_OS_RELEASE:-/etc/os-release}"
  [ -r "$release" ] || die "cannot read $release to tell which system this is"
  local id version codename
  id="$(. "$release"; printf '%s' "${ID:-}")"
  version="$(. "$release"; printf '%s' "${VERSION_ID:-}")"
  codename="$(. "$release"; printf '%s' "${VERSION_CODENAME:-}")"
  case "$id:$version" in
    ubuntu:22.04|ubuntu:24.04|debian:12) ;;
    *) die "prereqs knows Ubuntu 22.04, Ubuntu 24.04 and Debian 12; this is ${id:-unknown} ${version:-}. Install Docker Engine with the Compose plugin (https://docs.docker.com/engine/install/), and openssl and curl, then run install." ;;
  esac
  [ "$DRY" = 1 ] || [ "$(id -u)" = 0 ] || die "prereqs installs system packages: run it as root (sudo infrastructure/hivamis prereqs)"
  say "→ $id $version ($codename): Docker Engine, Compose, openssl and curl"
  run apt-get update
  run apt-get install -y ca-certificates curl gnupg openssl
  if [ "$DRY" = 1 ] || ! docker compose version >/dev/null 2>&1; then
    run install -m 0755 -d /etc/apt/keyrings
    run curl -fsSL "https://download.docker.com/linux/$id/gpg" -o /etc/apt/keyrings/docker.asc
    run chmod a+r /etc/apt/keyrings/docker.asc
    local arch; arch="$( [ "$DRY" = 1 ] && printf amd64 || dpkg --print-architecture)"
    local line="deb [arch=$arch signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$id $codename stable"
    if [ "$DRY" = 1 ]; then printf '+ echo %s > /etc/apt/sources.list.d/docker.list\n' "$line"; else printf '%s\n' "$line" > /etc/apt/sources.list.d/docker.list; fi
    run apt-get update
    run apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  else
    say "✓ Docker and Compose are here already"
  fi
  # A host with systemd starts the engine now and at every boot; a container using its host's
  # engine (the CI) has no service to start.
  if [ "$DRY" = 1 ] || { command -v systemctl >/dev/null && [ -d /run/systemd/system ]; }; then run systemctl enable --now docker; fi
  [ "$DRY" = 1 ] || docker info >/dev/null 2>&1 || die "Docker is installed but its engine does not answer — see: systemctl status docker"
  # The GPU: Docker reaches an NVIDIA card only through NVIDIA's container toolkit. Without it the
  # model ran on the CPU (the owner's report, 2026-10-23). The driver itself is the system's, and
  # needs a restart, so it is named rather than installed here.
  if has_gpu; then
    if gpu_runtime && [ "$DRY" != 1 ]; then
      say "✓ Docker reaches the NVIDIA card already"
    else
      say "→ NVIDIA GPU: the container toolkit, so the model runs on the card"
      run install -m 0755 -d /etc/apt/keyrings
      run curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey -o /etc/apt/keyrings/nvidia-container-toolkit.asc
      local nv="deb [signed-by=/etc/apt/keyrings/nvidia-container-toolkit.asc] https://nvidia.github.io/libnvidia-container/stable/deb/\$(ARCH) /"
      if [ "$DRY" = 1 ]; then printf '+ echo %s > /etc/apt/sources.list.d/nvidia-container-toolkit.list\n' "$nv"; else printf '%s\n' "$nv" > /etc/apt/sources.list.d/nvidia-container-toolkit.list; fi
      run apt-get update
      run apt-get install -y nvidia-container-toolkit
      run nvidia-ctk runtime configure --runtime=docker
      if [ "$DRY" = 1 ] || { command -v systemctl >/dev/null && [ -d /run/systemd/system ]; }; then run systemctl restart docker; fi
      gpu_runtime || die "the toolkit is installed but Docker still cannot reach the card — see: nvidia-ctk runtime configure --runtime=docker"
    fi
  elif card_without_driver; then
    driver_hint
  fi
  say "✓ ready for: infrastructure/hivamis install …"
}

cmd_install() {
  local org_name="" org_slug="" admin_email="" admin_name="" domain="" port="8080" mode="single" model="" ai=1 image=0 speech=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --org-name) org_name="$2"; shift 2 ;;
      --org-slug) org_slug="$2"; shift 2 ;;
      --admin-email) admin_email="$2"; shift 2 ;;
      --admin-name) admin_name="$2"; shift 2 ;;
      --domain) domain="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --multi) mode="multi"; shift ;;
      --model) model="$2"; shift 2 ;;
      --no-ai) ai=0; shift ;;
      --image) image=1; shift ;;
      --speech) speech=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$org_name" ] && [ -n "$org_slug" ] && [ -n "$admin_email" ] && [ -n "$admin_name" ] \
    || die "install needs --org-name, --org-slug, --admin-email and --admin-name"
  # Audit SEC-8: that domain is the demo seed's; an administrator on it would stop the API's next start.
  case "$(printf '%s' "$admin_email" | tr '[:upper:]' '[:lower:]')" in
    *@hiva.local) die "--admin-email: @hiva.local is the demo accounts' domain — give the administrator's real address" ;;
  esac
  need_tools
  command -v openssl >/dev/null || die "openssl is needed to generate the secrets."
  # An existing settings file holds the database password and the token key: never overwritten.
  [ -f "$ENV_FILE" ] && die "$ENV_FILE already exists — this installation is set up; use: hivamis upgrade"

  local origin
  if [ -n "$domain" ]; then origin="https://$domain"; else origin="http://localhost:$port"; fi

  # The assistant's model, sized to the machine: the model runs here, so its speed is the hardware's.
  local profiles="" chat="off" gb
  if [ "$ai" = 1 ]; then
    gb="$(memory_gb)"
    [ -n "$model" ] || model="$(model_for "$gb" "$(gpu_flag)")"
    if has_gpu; then
      gpu_runtime || die "the NVIDIA card is here but Docker cannot reach it — run: sudo infrastructure/hivamis prereqs"
      profiles="ai-gpu"
    else
      profiles="ai"
      card_without_driver && driver_hint
    fi
    chat="ollama"
    say "→ the assistant: $model on the $( [ "$profiles" = ai-gpu ] && echo GPU || echo CPU ) (${gb} GB detected)"
  fi
  local image_mode="off" image_model="sd-1.5-ggml"
  if [ "$image" = 1 ]; then
    gb="${gb:-$(memory_gb)}"
    image_model="$(image_model_for "$gb")"
    if has_gpu; then profiles="${profiles:+$profiles,}image-gpu"; else profiles="${profiles:+$profiles,}image"; fi
    image_mode="local"
    say "→ pictures: $image_model$(has_gpu || printf ' — on the CPU, a picture takes minutes')"
  fi
  local transcription_url=""
  if [ "$speech" = 1 ]; then
    profiles="${profiles:+$profiles,}speech"
    transcription_url="http://speech:8000/v1/audio/transcriptions"
    say "→ speech to text: $SPEECH_MODEL, on this server"
  fi
  say "→ writing $ENV_FILE (secrets generated here, readable only by you)"
  umask 077
  sed -e "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(secret 32)|" \
      -e "s|^JWT_SECRET=.*|JWT_SECRET=$(secret 48)|" \
      -e "s|^WEB_PORT=.*|WEB_PORT=$port|" \
      -e "s|^CORS_ORIGIN=.*|CORS_ORIGIN=$origin|" \
      -e "s|^PUBLIC_APP_URL=.*|PUBLIC_APP_URL=$origin|" \
      -e "s|^TENANT_MODE=.*|TENANT_MODE=$mode|" \
      -e "s|^SEED_DEMO_DATA=.*|SEED_DEMO_DATA=false|" \
      -e "s|^ALLOW_DEMO_ACCOUNTS=.*|ALLOW_DEMO_ACCOUNTS=false|" \
      -e "s|^SMS_MODE=.*|SMS_MODE=off|" \
      -e "s|^COMPOSE_PROFILES=.*|COMPOSE_PROFILES=$profiles|" \
      -e "s|^CHAT_MODE=.*|CHAT_MODE=$chat|" \
      -e "s|^OLLAMA_MODEL=.*|OLLAMA_MODEL=${model:-qwen3:8b}|" \
      -e "s|^OLLAMA_NUM_CTX=.*|OLLAMA_NUM_CTX=$(ctx_for "${model:-qwen3:8b}" "${gb:-0}")|" \
      -e "s|^IMAGE_MODE=.*|IMAGE_MODE=$image_mode|" \
      -e "s|^IMAGE_MODEL=.*|IMAGE_MODEL=$image_model|" \
      -e "s|^TRANSCRIPTION_URL=.*|TRANSCRIPTION_URL=$transcription_url|" \
      -e "s|^TRANSCRIPTION_MODEL=.*|TRANSCRIPTION_MODEL=$SPEECH_MODEL|" \
      "$ROOT/.env.docker.example" > "$ENV_FILE"
  printf '\n# Written by hivamis install, %s\n' "$(date -u +%Y-%m-%dT%H:%MZ)" >> "$ENV_FILE"

  say "→ building and starting the stack"
  compose up -d --build
  wait_healthy
  if [ "$ai" = 1 ]; then pull_model "$model"; fi
  if [ "$image" = 1 ]; then pull_image_model "$image_model"; fi
  if [ "$speech" = 1 ]; then pull_speech_model; fi

  say "→ creating the organisation and its first administrator"
  local hosts=()
  [ -n "$domain" ] && hosts=(--host "$domain")
  # ${a[@]+…}: bash 3.2 (macOS) calls an empty array unbound under set -u, so install without --domain failed.
  cli tenant:create --name "$org_name" --slug "$org_slug" --admin-email "$admin_email" --admin-name "$admin_name" ${hosts[@]+"${hosts[@]}"}
  say ""
  say "✓ Hivamis is running at $origin"
  say "  The administrator sets their password from the link above (valid seven days, once)."
  say "  Next: put TLS in front of port $port, and schedule: infrastructure/hivamis backup"
}

cmd_status() { compose ps; cli status; }

# A clean start (owner's report, 2026-10-23): every person and record of the organisation but one
# system administrator; the settings and the history stay (src/setup/reset.ts). It says what it will
# delete, asks for RESET, asks for the administrator's new password twice without showing it, backs
# everything up, and only then begins. The password reaches the API on standard input — never on a
# command line, where `ps` and the shell's history would keep it.
cmd_reset() {
  local admin="" slug="" yes=0 answer="" pw="" again=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --admin) admin="$2"; shift 2 ;;
      --slug) slug="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$admin" ] || die "reset needs --admin EMAIL: the system administrator who stays"
  [ -f "$ENV_FILE" ] || [ "$DRY" = 1 ] || die "$ENV_FILE not found — install first"
  say "→ what a clean start deletes (and keeps $admin, the settings and the history)"
  cli org:reset --keep-admin "$admin" ${slug:+--slug "$slug"}
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "confirm at a terminal, or add --yes"
    read -r -p "Everything listed above is deleted. Type RESET to go on: " answer
    [ "$answer" = RESET ] || die "nothing was changed"
  fi
  if [ -t 0 ]; then
    read -r -s -p "New password for $admin (at least 12 characters; Enter keeps the current one): " pw; printf '\n' >&2
    if [ -n "$pw" ]; then
      [ "${#pw}" -ge 12 ] || die "the password must be at least 12 characters — nothing was changed"
      read -r -s -p "The same password again: " again; printf '\n' >&2
      [ "$pw" = "$again" ] || die "the two passwords differ — nothing was changed"
    fi
  fi
  say "→ a backup first"
  cmd_backup
  say "→ the clean start"
  if [ -n "$pw" ]; then
    if [ "$DRY" = 1 ]; then printf '+ (the password, on standard input) | docker compose exec -T api node dist/cli.js org:reset --keep-admin %s --yes --password-stdin\n' "$admin"
    else printf '%s' "$pw" | docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" exec -T api node dist/cli.js org:reset --keep-admin "$admin" ${slug:+--slug "$slug"} --yes --password-stdin; fi
  else
    cli org:reset --keep-admin "$admin" ${slug:+--slug "$slug"} --yes
  fi
  say "✓ a clean start: sign in as $admin"
}

cmd_backup() {
  local stamp user db
  stamp="$(date +%Y%m%d-%H%M%S)"
  user="$(env_get POSTGRES_USER)"; user="${user:-hiva}"
  db="$(env_get POSTGRES_DB)"; db="${db:-hiva_os}"
  run mkdir -p "$BACKUP_DIR"
  say "→ dumping the database"
  compose_to "$BACKUP_DIR/hiva-db-$stamp.dump" exec -T db pg_dump --format=custom --no-owner --no-acl -U "$user" "$db"
  say "→ archiving uploaded files"
  compose_to "$BACKUP_DIR/hiva-storage-$stamp.tar.gz" exec -T api tar -czf - -C /app storage
  say "→ pruning backups older than $RETENTION_DAYS days"
  run find "$BACKUP_DIR" -name 'hiva-*' -type f -mtime "+$RETENTION_DAYS" -delete
  say "✓ backup: $BACKUP_DIR/hiva-db-$stamp.dump and hiva-storage-$stamp.tar.gz"
}

cmd_restore() {
  local dump="" storage="" yes=0 user db
  while [ $# -gt 0 ]; do
    case "$1" in
      --db) dump="$2"; shift 2 ;;
      --storage) storage="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$dump" ] || die "restore needs --db FILE.dump"
  [ "$DRY" = 1 ] || [ -f "$dump" ] || die "no such file: $dump"
  [ -z "$storage" ] || [ "$DRY" = 1 ] || [ -f "$storage" ] || die "no such file: $storage"
  [ "$yes" = 1 ] || die "restore replaces the database$([ -n "$storage" ] && echo ' and the uploaded files') — add --yes to go ahead"
  user="$(env_get POSTGRES_USER)"; user="${user:-hiva}"
  db="$(env_get POSTGRES_DB)"; db="${db:-hiva_os}"
  say "→ stopping the application (the database stays up)"
  compose stop web api
  say "→ restoring the database"
  compose_from "$dump" exec -T db pg_restore --clean --if-exists --no-owner --no-acl -U "$user" -d "$db"
  if [ -n "$storage" ]; then
    say "→ restoring uploaded files"
    compose_from "$storage" run --rm --no-deps -T api sh -c 'rm -rf /app/storage/* && tar -xzf - -C /app'
  fi
  say "→ starting the application"
  compose up -d
  wait_healthy
  say "✓ restored from $dump"
}

# Settings a newer version reads that this installation's file predates — added with the example's
# values, each off or at its default, so the settings file names every setting there is to turn on
# (owner's server report, 2026-10-28: features stayed hidden because their settings were nowhere to see).
add_new_settings() {
  local line key added=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in [A-Z]*=*) ;; *) continue ;; esac
    key="${line%%=*}"
    grep -qE "^$key=" "$ENV_FILE" 2>/dev/null && continue
    # A secret is generated at install, never copied from the example's placeholder.
    case "$line" in *=CHANGE_ME) continue ;; esac
    if [ -z "$added" ]; then
      if [ "$DRY" = 1 ]; then printf '+ echo "# Added by hivamis upgrade" >> %s\n' "$ENV_FILE"
      else printf '\n# Added by hivamis upgrade, %s — off or at their defaults until set\n' "$(date -u +%Y-%m-%dT%H:%MZ)" >> "$ENV_FILE"; fi
    fi
    if [ "$DRY" = 1 ]; then printf '+ echo %s >> %s\n' "$line" "$ENV_FILE"; else printf '%s\n' "$line" >> "$ENV_FILE"; fi
    added="$added $key"
  done < "$ROOT/.env.docker.example"
  [ -z "$added" ] || say "→ new settings in $ENV_FILE:$added"
}

cmd_upgrade() {
  local pull=0 backup=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --pull) pull=1; shift ;;
      --no-backup) backup=0; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -f "$ENV_FILE" ] || [ "$DRY" = 1 ] || die "$ENV_FILE not found — install first"
  need_tools
  # Before anything changes: a way back.
  [ "$backup" = 1 ] && cmd_backup
  if [ "$pull" = 1 ]; then
    say "→ fetching the new version"
    run git -C "$ROOT" pull --ff-only
  fi
  add_new_settings
  local version
  version="$(git -C "$ROOT" describe --tags --always 2>/dev/null || true)"
  say "→ rebuilding${version:+ ($version)}"
  # A failed build changes nothing that runs: the version before keeps serving, and that is said, not
  # left to be guessed from the build's own output (owner's server report, 2026-10-28).
  APP_VERSION="$version" compose build \
    || die "the new version did not build, so nothing was restarted: the version before is still running. The error is above; a network error (Debian, npm or Docker Hub unreachable) is worth one more try, or a mirror — see docs/operations.md"
  [ "$DRY" = 1 ] || say "✓ built"

  say "→ restarting — the API migrates the database and brings the reference data up to the code"
  APP_VERSION="$version" compose up -d
  wait_healthy
  if model_wanted && ! model_present "$(env_get OLLAMA_MODEL)"; then pull_model "$(env_get OLLAMA_MODEL)"; fi
  cli status
}

# A move from Mizito (docs/operations.md). The files hold people's details: they enter the API's
# container for the run and leave it after, whatever the outcome.
cmd_import_mizito() {
  local mizito="" sheet="" extra="" as="" commit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --mizito) mizito="$2"; shift 2 ;;
      --sheet) sheet="$2"; shift 2 ;;
      --extra) extra="$2"; shift 2 ;;
      --as) as="$2"; shift 2 ;;
      --commit) commit=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$mizito" ] && [ -n "$as" ] || die "import-mizito needs --mizito FILE and --as EMAIL (this organisation's system administrator)"
  [ "$DRY" = 1 ] || [ -f "$mizito" ] || die "no such file: $mizito"
  [ -z "$sheet" ] || [ "$DRY" = 1 ] || [ -f "$sheet" ] || die "no such file: $sheet"
  [ -z "$extra" ] || [ "$DRY" = 1 ] || [ -f "$extra" ] || die "no such file: $extra"
  [ -f "$ENV_FILE" ] || [ "$DRY" = 1 ] || die "$ENV_FILE not found — install first"
  local args=(import:mizito --mizito /tmp/hivamis-mizito.json --as "$as")
  compose cp "$mizito" api:/tmp/hivamis-mizito.json
  if [ -n "$sheet" ]; then compose cp "$sheet" api:/tmp/hivamis-sheet.json; args+=(--sheet /tmp/hivamis-sheet.json); fi
  if [ -n "$extra" ]; then compose cp "$extra" api:/tmp/hivamis-mizito-extra.json; args+=(--extra /tmp/hivamis-mizito-extra.json); fi
  if [ "$commit" = 1 ]; then say "→ a backup first"; cmd_backup; args+=(--commit); fi
  local status=0
  cli "${args[@]}" || status=$?
  compose exec -T -u root api rm -f /tmp/hivamis-mizito.json /tmp/hivamis-sheet.json /tmp/hivamis-mizito-extra.json || true
  [ "$status" = 0 ] || die "the move stopped — see the error above; what was made stays, and running it again goes on from there"
  if [ "$commit" = 1 ]; then
    say "✓ moved in. Each person signs in after you issue their link (Admin → Users); first set the real email of anyone whose address ends in @import.invalid"
  else
    say "→ nothing was written: read the report above, then run the same command with --commit"
  fi
}

cmd_passwords() {
  local as="" out="hivamis-passwords.csv" commit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) as="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;
      --commit) commit=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$as" ] || die "passwords needs --as EMAIL (this organisation's system administrator)"
  [ -f "$ENV_FILE" ] || [ "$DRY" = 1 ] || die "$ENV_FILE not found — install first"
  if [ "$commit" != 1 ]; then
    cli users:passwords --as "$as"
    say "→ nothing was set: run the same command with --commit to set them and write $out"
    return
  fi
  [ ! -e "$out" ] || die "$out already exists — move it away first; it is never overwritten"
  local status=0
  cli users:passwords --as "$as" --commit --out /tmp/hivamis-passwords.csv || status=$?
  # Whatever was set is in the file, even when the run stopped part way: it comes out, then leaves the container.
  (umask 077; compose cp api:/tmp/hivamis-passwords.csv "$out") || true
  run chmod 600 "$out" || true
  compose exec -T -u root api rm -f /tmp/hivamis-passwords.csv || true
  [ "$status" = 0 ] || die "it stopped part way — the passwords set so far are in $out; running it again sets the rest"
  say "✓ the passwords are in $out (readable by you only). Hand each on in person, then delete the file: each is changed at the first sign-in"
}

cmd_tenant() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|create|update) cli "tenant:$sub" "$@" ;;
    *) die "tenant list | create … | update …" ;;
  esac
}

case "${1:-help}" in
  prereqs) shift; cmd_prereqs ;;
  install) shift; cmd_install "$@" ;;
  status) shift; cmd_status ;;
  model) shift; cmd_model "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  backup) shift; cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  tenant) shift; cmd_tenant "$@" ;;
  import-mizito) shift; cmd_import_mizito "$@" ;;
  passwords) shift; cmd_passwords "$@" ;;
  *) sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
esac
