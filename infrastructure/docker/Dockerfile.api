# Both stages run Debian, not Alpine, and that is deliberate on two counts:
#
#  1. The PDF engine drives Chromium through playwright-core. Playwright supports Debian and
#     Ubuntu; Alpine is not a supported platform. A headline feature should not run on one.
#  2. @node-rs/argon2 and Prisma's query engine ship platform-specific binaries. Building on
#     musl and running on glibc (or the reverse) yields a container that fails at startup, so
#     the two stages must share a libc regardless of which one is chosen.

# ── build ─────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
# Where packages come from (owner's server report, 2026-10-28): the public registry unless NPM_REGISTRY
# names a mirror, and a dropped connection retried rather than ending the build.
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV COREPACK_NPM_REGISTRY=$NPM_REGISTRY \
    npm_config_registry=$NPM_REGISTRY \
    npm_config_fetch_retries=6 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000
# Debian's packages: from DEBIAN_MIRROR when it names one (a mirror inside the country, where
# deb.debian.org is slow or refused), each download retried before the build gives up.
ARG DEBIAN_MIRROR=
RUN printf 'Acquire::Retries "8";\nAcquire::http::Timeout "60";\n' > /etc/apt/apt.conf.d/80-retries \
    && if [ -n "$DEBIAN_MIRROR" ]; then sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR%/}|g" /etc/apt/sources.list.d/debian.sources; fi
# OpenSSL here as in the runtime: Prisma chooses its query engine by the OpenSSL it finds when it
# generates the client. The slim image has none, so it chose 1.1's, and the runtime, which has 3,
# could not load it — the API never became ready (owner's server report, 2026-10-28).
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile

COPY packages/contracts packages/contracts
COPY apps/api apps/api
RUN pnpm --filter @hiva/contracts build && pnpm --filter @hiva/api db:generate && pnpm --filter @hiva/api build

# Drop dev dependencies from the layer that ships.
# `--legacy`: pnpm 10 deploys a workspace package only with injected dependencies otherwise. The
# Prisma client is generated where it ships, from the schema beside it, by the CLI the image keeps
# for `migrate deploy`.
RUN pnpm --filter @hiva/api --prod deploy --legacy /out && \
    cp -r apps/api/dist /out/dist && \
    cp -r apps/api/prisma /out/prisma && \
    cd /out && ./node_modules/.bin/prisma generate && \
    { find /out/node_modules -name 'libquery_engine-*openssl-3.0.x*' | grep -q . \
      || { echo 'Prisma generated no engine for OpenSSL 3, which the runtime has' >&2; exit 1; }; }

# ── runtime ───────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime

ARG DEBIAN_MIRROR=
RUN printf 'Acquire::Retries "8";\nAcquire::http::Timeout "60";\n' > /etc/apt/apt.conf.d/80-retries \
    && if [ -n "$DEBIAN_MIRROR" ]; then sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR%/}|g" /etc/apt/sources.list.d/debian.sources; fi

# chromium: the PDF engine. openssl: required by Prisma's query engine.
# No Persian font package is needed — apps/api/src/pdf/renderer.ts embeds Vazirmatn as
# base64 in every document, so output is identical on a host with no fonts installed.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      ca-certificates \
      openssl \
      tini \
      curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system hiva \
    && useradd --system --gid hiva --create-home --home-dir /home/hiva hiva

WORKDIR /app

COPY --from=build --chown=hiva:hiva /out ./
RUN mkdir -p /app/storage && chown -R hiva:hiva /app/storage

# Pinned explicitly so browser resolution never depends on probing the filesystem.
ENV NODE_ENV=production \
    PORT=4000 \
    HOST=0.0.0.0 \
    STORAGE_DIR=/app/storage \
    PDF_BROWSER_PATH=/usr/bin/chromium

EXPOSE 4000
USER hiva

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:4000/health/ready || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
# Migrations are applied on start so a deploy is a single, ordered step.
# The image's own Prisma, never one npx would fetch at start-up.
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/server.js"]
